<UserControl x:Class="QP11.Wpf.Controls.ClientSearchBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <TextBox x:Name="txtInput"
                 VerticalContentAlignment="Center"
                 Padding="2,0"
                 TextChanged="TxtInput_TextChanged"
                 PreviewKeyDown="TxtInput_PreviewKeyDown"/>
        <Popup x:Name="popup"
               PlacementTarget="{Binding ElementName=txtInput}"
               Placement="Bottom"
               StaysOpen="False"
               PopupAnimation="Slide"
               MaxHeight="300">
            <Border x:Name="popupBorder"
                    Background="White"
                    BorderBrush="#FFABADB3"
                    BorderThickness="1">
                <ListBox x:Name="lstResults"
                         DisplayMemberPath="Name"
                         BorderThickness="0"
                         MaxHeight="280"
                         Focusable="False"
                         PreviewMouseDown="LstResults_PreviewMouseDown"/>
            </Border>
        </Popup>
    </Grid>
</UserControl>
