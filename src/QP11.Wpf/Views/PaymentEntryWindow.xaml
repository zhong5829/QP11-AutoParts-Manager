<Window x:Class="QP11.Wpf.Views.PaymentEntryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="收款录入" Height="350" Width="500"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,5">
            <TextBlock Text="收款类型:" Width="80" VerticalAlignment="Center"/>
            <ComboBox x:Name="cboType" Width="250" SelectedIndex="0">
                <ComboBoxItem Content="销售收款"/>
                <ComboBoxItem Content="其他收入"/>
            </ComboBox>
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,5">
            <TextBlock Text="收款账户:" Width="80" VerticalAlignment="Center"/>
            <ComboBox x:Name="cboAccount" Width="250" DisplayMemberPath="Name"/>
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,5">
            <TextBlock Text="关联单号:" Width="80" VerticalAlignment="Center"/>
            <TextBox x:Name="txtSn" Width="250"/>
        </StackPanel>
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,5">
            <TextBlock Text="收款金额:" Width="80" VerticalAlignment="Center"/>
            <TextBox x:Name="txtAmount" Width="250" Text="0"/>
        </StackPanel>
        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,5">
            <TextBlock Text="备注:" Width="80" VerticalAlignment="Center"/>
            <TextBox x:Name="txtMemo" Width="250"/>
        </StackPanel>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
            <Button Content="确认收款" Width="80" Height="28" Click="BtnSave_Click" IsDefault="True"/>
            <Button Content="取消" Width="80" Height="28" Margin="10,0" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
