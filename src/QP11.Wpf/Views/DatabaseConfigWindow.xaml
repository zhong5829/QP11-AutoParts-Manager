<Window x:Class="QP11.Wpf.Views.DatabaseConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="数据库连接配置" Height="420" Width="480"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True">
    <StackPanel Margin="20">
        <TextBlock Text="数据库连接不上，请检查并修改连接信息：" TextWrapping="Wrap" Margin="0,0,0,12"/>

        <StackPanel Orientation="Horizontal" Margin="0,4">
            <TextBlock Text="连接方式:" Width="90" VerticalAlignment="Center"/>
            <ComboBox x:Name="cboProvider" Width="180" SelectionChanged="CboProvider_SelectionChanged">
                <ComboBoxItem Content="OleDb"/>
                <ComboBoxItem Content="ODBC"/>
                <ComboBoxItem Content="SqlClient"/>
            </ComboBox>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Margin="0,4">
            <TextBlock Text="服务器(IP):" Width="90" VerticalAlignment="Center"/>
            <TextBox x:Name="txtServer" Width="180"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Margin="0,4">
            <TextBlock Text="端口:" Width="90" VerticalAlignment="Center"/>
            <TextBox x:Name="txtPort" Width="180" Text="1433"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Margin="0,4">
            <TextBlock Text="数据库:" Width="90" VerticalAlignment="Center"/>
            <TextBox x:Name="txtDatabase" Width="180"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Margin="0,4">
            <TextBlock Text="用户名:" Width="90" VerticalAlignment="Center"/>
            <TextBox x:Name="txtUser" Width="180"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Margin="0,4">
            <TextBlock Text="密码:" Width="90" VerticalAlignment="Center"/>
            <PasswordBox x:Name="txtPassword" Width="180"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <Button x:Name="BtnTest" Content="测试连接" Width="90" Height="30" Margin="0,0,10,0" Click="BtnTest_Click"/>
            <Button x:Name="BtnSave" Content="保 存" Width="90" Height="30" Margin="0,0,10,0" Click="BtnSave_Click"/>
            <Button Content="取 消" Width="90" Height="30" Click="BtnCancel_Click"/>
        </StackPanel>

        <TextBlock x:Name="txtStatus" Text="" Foreground="Gray" TextWrapping="Wrap" Margin="0,12,0,0"/>
    </StackPanel>
</Window>