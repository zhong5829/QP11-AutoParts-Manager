<Window x:Class="QP11.Wpf.Views.SettlementResultDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="结算成功" SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False" Background="#FFF5F5F5">
    <StackPanel Margin="20,16">
        <!-- 图标 + 提示 -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="28" Foreground="#FF4CAF50"
                       VerticalAlignment="Center" Margin="0,0,12,0"/>
            <TextBlock Text="结算成功!" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- 结果信息 -->
        <Grid Margin="8,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="单号:" Margin="0,2"/>
            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="txtBillNo" FontWeight="Bold" Margin="8,2"/>

            <TextBlock Grid.Row="1" Text="合计:" Margin="0,2"/>
            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="txtTotal" Foreground="#FFD32F2F" FontWeight="Bold" Margin="8,2"/>

            <TextBlock Grid.Row="2" Text="已收:" Margin="0,2"/>
            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="txtPaid" Foreground="#FF388E3C" Margin="8,2"/>

            <TextBlock Grid.Row="3" Text="欠款:" Margin="0,2"/>
            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="txtArrear" Foreground="#FFF57C00" Margin="8,2"/>
        </Grid>

        <!-- 分隔线 -->
        <Separator Margin="0,4,0,8"/>

        <!-- 立即打印勾选框 + 确定按钮 -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <CheckBox x:Name="chkPrintNow" Content="立即打印" VerticalAlignment="Center"
                      FontSize="13" Margin="0,0,20,0" IsChecked="True"/>
            <Button x:Name="btnOk" Content="确定" Width="80" Height="30" IsDefault="True"
                    Click="BtnOk_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
