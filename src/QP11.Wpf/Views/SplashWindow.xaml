<Window x:Class="QP11.Wpf.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QP11" Width="380" Height="150"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        WindowStyle="None" ShowInTaskbar="False" Topmost="True">
    <Border Background="White" BorderBrush="#2F6FB7" BorderThickness="2">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="QP11 汽配管理系统" FontSize="18" FontWeight="Bold" Foreground="#2F6FB7" HorizontalAlignment="Center"/>
            <TextBlock x:Name="txtStatus" Text="正在连接数据库，请稍候..." Margin="0,12,0,0" Foreground="Gray" HorizontalAlignment="Center"/>
        </StackPanel>
    </Border>
</Window>