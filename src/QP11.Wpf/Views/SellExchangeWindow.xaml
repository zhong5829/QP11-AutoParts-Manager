<Window x:Class="QP11.Wpf.Views.SellExchangeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="销售换货" Height="650" Width="1000"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <GroupBox Grid.Row="0" Header="换货信息" Margin="0,0,0,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="原单号:" VerticalAlignment="Center" Margin="5"/>
                <TextBox Grid.Column="1" x:Name="txtOrigSn" Margin="2"/>
                <Button Grid.Column="2" Content="查询" Width="50" Margin="5,0" Click="BtnLoadOrig_Click"/>
                <TextBlock Grid.Column="3" Text="换货单号:" VerticalAlignment="Center" Margin="10,5,5,5"/>
                <TextBox Grid.Column="4" x:Name="txtExchangeSn" IsReadOnly="True" Background="LightGray" Width="150" Margin="2"/>
                <TextBlock Grid.Column="5" Text="日期:" VerticalAlignment="Center" Margin="10,5,5,5"/>
                <DatePicker Grid.Column="6" x:Name="dtExchangeDate" Margin="2"/>
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="1" Header="退回配件">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Width="150" Margin="10,0,0,0">
                    <TextBlock Text="退回合计:" FontWeight="Bold"/>
                    <TextBox x:Name="txtReturnTotal" IsReadOnly="True" FontSize="14" Foreground="Red"
                             HorizontalContentAlignment="Right" Margin="0,5"/>
                </StackPanel>
                <DataGrid x:Name="dgReturnItems" AutoGenerateColumns="False" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Header="退" Width="30" Binding="{Binding IsReturn}"/>
                        <DataGridTextColumn Header="配件ID" Width="80" Binding="{Binding Partid}" IsReadOnly="True"/>
                        <DataGridTextColumn Header="名称" Width="150" Binding="{Binding PartName}" IsReadOnly="True"/>
                        <DataGridTextColumn Header="原数量" Width="70" Binding="{Binding OrigAmount}" IsReadOnly="True"/>
                        <DataGridTextColumn Header="退回数量" Width="70" Binding="{Binding ReturnAmount}"/>
                        <DataGridTextColumn Header="单价" Width="80" Binding="{Binding Price, StringFormat=c2}" IsReadOnly="True"/>
                        <DataGridTextColumn Header="退回金额" Width="100" Binding="{Binding ReturnTotal, StringFormat=c2}" IsReadOnly="True"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </GroupBox>

        <GroupBox Grid.Row="2" Header="换入配件" Margin="0,5,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,5">
                    <Button Content="添加配件" Width="80" Height="26" Click="BtnAddPart_Click"/>
                    <Button Content="移除选中" Width="80" Height="26" Margin="5,0" Click="BtnRemovePart_Click"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Width="150" Margin="10,0,0,0">
                    <TextBlock Text="换入合计:" FontWeight="Bold"/>
                    <TextBox x:Name="txtNewTotal" IsReadOnly="True" FontSize="14" Foreground="Blue"
                             HorizontalContentAlignment="Right" Margin="0,5"/>
                    <TextBlock Text="补差价:" FontWeight="Bold" Margin="0,10,0,0"/>
                    <TextBox x:Name="txtDiffAmount" IsReadOnly="True" FontSize="16" FontWeight="Bold"
                             HorizontalContentAlignment="Right" Margin="0,5"/>
                </StackPanel>
                <DataGrid x:Name="dgNewItems" AutoGenerateColumns="False" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="配件ID" Width="80" Binding="{Binding Partid}" IsReadOnly="True"/>
                        <DataGridTextColumn Header="名称" Width="150" Binding="{Binding PartName}" IsReadOnly="True"/>
                        <DataGridTextColumn Header="数量" Width="70" Binding="{Binding Amount}"/>
                        <DataGridTextColumn Header="单价" Width="80" Binding="{Binding Price, StringFormat=c2}" IsReadOnly="True"/>
                        <DataGridTextColumn Header="金额" Width="100" Binding="{Binding LineTotal, StringFormat=c2}" IsReadOnly="True"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </GroupBox>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="5">
            <Button Content="确认换货" Width="100" Height="32" Margin="5" Click="BtnConfirmExchange_Click"/>
            <Button Content="退 出" Width="100" Height="32" Margin="5" Click="BtnClose_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
