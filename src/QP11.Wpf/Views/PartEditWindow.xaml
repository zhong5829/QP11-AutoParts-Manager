<Window x:Class="QP11.Wpf.Views.PartEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="配件编辑" Height="580" Width="500"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <ScrollViewer>
        <Grid Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="件号:" VerticalAlignment="Center"/>
            <TextBox Grid.Column="1" x:Name="txtPartno" Margin="2" TabIndex="1"/>
            <TextBlock Grid.Row="1" Text="名称:" VerticalAlignment="Center" Margin="0,5,0,0"/>
            <TextBox Grid.Row="1" Grid.Column="1" x:Name="txtName" Margin="2,5" TabIndex="2"/>
            <TextBlock Grid.Row="2" Text="适用车名:" VerticalAlignment="Center" Margin="0,5,0,0"/>
            <ComboBox Grid.Row="2" Grid.Column="1" x:Name="cboCarname" IsEditable="True" Margin="2,5" TabIndex="3"/>
            <TextBlock Grid.Row="3" Text="适用车型:" VerticalAlignment="Center" Margin="0,5,0,0"/>
            <ComboBox Grid.Row="3" Grid.Column="1" x:Name="cboCartype" IsEditable="True" Margin="2,5" TabIndex="4"/>
            <TextBlock Grid.Row="4" Text="单位:" VerticalAlignment="Center" Margin="0,5,0,0"/>
            <ComboBox Grid.Row="4" Grid.Column="1" x:Name="cboUnit" IsEditable="True" Margin="2,5" TabIndex="5"/>
            <TextBlock Grid.Row="5" Text="分类:" VerticalAlignment="Center" Margin="0,5,0,0"/>
            <ComboBox Grid.Row="5" Grid.Column="1" x:Name="cboClass" IsEditable="True" Margin="2,5" TabIndex="6"/>
            <TextBlock Grid.Row="6" Text="仓位:" VerticalAlignment="Center" Margin="0,5,0,0"/>
            <ComboBox Grid.Row="6" Grid.Column="1" x:Name="cboPlace" IsEditable="True" Margin="2,5" TabIndex="7"/>
            <TextBlock Grid.Row="7" Text="区域:" VerticalAlignment="Center" Margin="0,5,0,0"/>
            <ComboBox Grid.Row="7" Grid.Column="1" x:Name="cboArea" IsEditable="True" Margin="2,5" TabIndex="8"/>
            <TextBlock Grid.Row="8" Text="进货价:" VerticalAlignment="Center" Margin="0,5,0,0"/>
            <TextBox Grid.Row="8" Grid.Column="1" x:Name="txtInprice" Text="0" Margin="2,5" TabIndex="9"/>
            <TextBlock Grid.Row="9" Text="零售价:" VerticalAlignment="Center" Margin="0,5,0,0"/>
            <TextBox Grid.Row="9" Grid.Column="1" x:Name="txtLsprice" Text="0" Margin="2,5" TabIndex="10"/>
            <TextBlock Grid.Row="10" Text="批发价:" VerticalAlignment="Center" Margin="0,5,0,0"/>
            <TextBox Grid.Row="10" Grid.Column="1" x:Name="txtPfprice" Text="0" Margin="2,5" TabIndex="11"/>
            <TextBlock Grid.Row="11" Text="拼音码:" VerticalAlignment="Center" Margin="0,5,0,0"/>
            <TextBox Grid.Row="11" Grid.Column="1" x:Name="txtNamePy" Margin="2,5" TabIndex="12"/>
            <TextBlock Grid.Row="12" Text="备注:" VerticalAlignment="Top" Margin="0,5,0,0"/>
            <TextBox Grid.Row="12" Grid.Column="1" x:Name="txtMemo" AcceptsReturn="True" Height="50" Margin="2,5" TabIndex="13"/>

            <StackPanel Grid.Row="13" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
                <Button Content="保 存" Width="80" Height="28" Margin="10,0" Click="BtnSave_Click" IsDefault="True"/>
                <Button Content="取 消" Width="80" Height="28" Margin="10,0" IsCancel="True"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>
