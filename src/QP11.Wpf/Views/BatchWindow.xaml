<Window x:Class="QP11.Wpf.Views.BatchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="批次管理" Height="550" Width="900"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,5">
            <TextBlock Text="配件ID:" VerticalAlignment="Center" Margin="5"/>
            <TextBox x:Name="txtPartId" Width="100" Margin="2"/>
            <Button Content="查询" Width="60" Height="26" Margin="5,0" Click="BtnQuery_Click"/>
            <Separator Width="20"/>
            <Button Content="新增批次" Width="80" Height="26" Margin="5,0" Click="BtnAdd_Click"/>
            <Button Content="编辑数量" Width="80" Height="26" Margin="5,0" Click="BtnEdit_Click"/>
            <Button Content="删除批次" Width="80" Height="26" Margin="5,0" Click="BtnDelete_Click"/>
            <Separator Width="20"/>
            <Button Content="临期批次" Width="80" Height="26" Margin="5,0" Click="BtnExpiring_Click"/>
        </StackPanel>

        <DataGrid Grid.Row="1" x:Name="dgList" AutoGenerateColumns="False" CanUserAddRows="False"
                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Width="50" Binding="{Binding Id}" IsReadOnly="True"/>
                <DataGridTextColumn Header="配件ID" Width="70" Binding="{Binding Partid}" IsReadOnly="True"/>
                <DataGridTextColumn Header="批次号" Width="120" Binding="{Binding BatchNo}"/>
                <DataGridTextColumn Header="供应商" Width="100" Binding="{Binding Supplier}"/>
                <DataGridTextColumn Header="入库数量" Width="70" Binding="{Binding Amount}"/>
                <DataGridTextColumn Header="剩余" Width="70" Binding="{Binding Remain}"/>
                <DataGridTextColumn Header="进价" Width="80" Binding="{Binding Inprice, StringFormat=c2}"/>
                <DataGridTextColumn Header="生产日期" Width="90" Binding="{Binding ProduceDate, StringFormat=yyyy-MM-dd}"/>
                <DataGridTextColumn Header="过期日期" Width="90" Binding="{Binding ExpireDate, StringFormat=yyyy-MM-dd}"/>
                <DataGridTextColumn Header="备注" Width="*" Binding="{Binding Memo}"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="2" x:Name="txtCount" VerticalAlignment="Center" Margin="5"/>
    </Grid>
</Window>
