<Window x:Class="QP11.Wpf.Views.VinCandidateSelectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择本地配件" Width="520" Height="380"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F5F5F5">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" FontSize="13" Foreground="#666" Margin="0,0,0,8">
            <Run Text="编码"/><Run Text=" [" /><Run x:Name="txtModel" /><Run Text="]"/><Run Text=" 匹配到多个本地配件，请选择："/>
        </TextBlock>

        <DataGrid Grid.Row="1" x:Name="dgCandidates" AutoGenerateColumns="False"
                  IsReadOnly="True" SelectionMode="Single"
                  CanUserAddRows="False" CanUserDeleteRows="False"
                  GridLinesVisibility="Horizontal" AlternatingRowBackground="#FAFAFA"
                  HeadersVisibility="Column" FontSize="12">
            <DataGrid.Columns>
                <DataGridTextColumn Header="编号" Binding="{Binding PartNo}" Width="140"/>
                <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="车型" Binding="{Binding CarType}" Width="120"/>
                <DataGridTextColumn Header="库存" Binding="{Binding StockAmount}" Width="50"/>
                <DataGridTextColumn Header="零售价" Binding="{Binding LsPrice, StringFormat='{}{0:F0}'}" Width="60"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="确定" Width="80" Height="30" IsDefault="True"
                    Click="BtnOk_Click" Background="#2196F3" Foreground="White" BorderThickness="0"/>
            <Button Content="取消" Width="80" Height="30" Margin="8,0,0,0" IsCancel="True"
                    Background="#EEEEEE" Foreground="#333" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>
