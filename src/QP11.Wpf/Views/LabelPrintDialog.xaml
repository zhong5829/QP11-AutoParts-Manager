<Window x:Class="QP11.Wpf.Views.LabelPrintDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:QP11.Wpf.Views"
        Title="标签打印" Height="560" Width="920"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="290"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="0,0,8,0">
            <GroupBox Header="配件信息" Padding="6">
                <StackPanel>
                    <TextBlock Text="零件编码:" Margin="0,0,0,2"/>
                    <TextBox x:Name="txtPartNo" IsReadOnly="True" Margin="0,0,0,6" Padding="4,2" Background="{x:Null}" BorderThickness="0" FontWeight="Bold"/>
                    <TextBlock Text="配件名称:" Margin="0,0,0,2"/>
                    <TextBox x:Name="txtName" IsReadOnly="True" Margin="0,0,0,6" Padding="4,2" Background="{x:Null}" BorderThickness="0"/>
                    <TextBlock Text="车型（可编辑，仅本次打印）:" Margin="0,0,0,2"/>
                    <TextBox x:Name="txtCarType" Margin="0,0,0,2" Padding="4,2" TextChanged="CarType_Changed"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="打印设置" Padding="6" Margin="0,6,0,0">
                <StackPanel>
                    <TextBlock Text="标签模板:" Margin="0,0,0,2"/>
                    <ComboBox x:Name="cboTemplate" Margin="0,0,0,6" DisplayMemberPath="Name" SelectionChanged="Template_Changed"/>
                    <TextBlock Text="打印数量（连打张数）:" Margin="0,0,0,2"/>
                    <TextBox x:Name="txtCopies" Text="1" Margin="0,0,0,6" Padding="4,2" TextChanged="Copies_Changed"/>
                    <TextBlock Text="打印机:" Margin="0,0,0,2"/>
                    <ComboBox x:Name="cboPrinter" Margin="0,0,0,2"/>
                </StackPanel>
            </GroupBox>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Content="打印" Width="70" Height="28" Margin="0,0,6,0" Click="BtnPrint_Click"/>
                <Button Content="取消" Width="70" Height="28" Click="BtnCancel_Click"/>
            </StackPanel>
        </StackPanel>

        <views:LabelPreviewEditor Grid.Column="1" x:Name="editor"/>
    </Grid>
</Window>