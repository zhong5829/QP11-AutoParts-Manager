<UserControl x:Class="QP11.Wpf.Views.DesktopControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="UserControl_Loaded"
             Unloaded="UserControl_Unloaded">
    <UserControl.Resources>
        <!-- KPI 卡片按钮模板 -->
        <ControlTemplate x:Key="KpiCardTemplate" TargetType="Button">
            <Border x:Name="cardBorder" Background="White" CornerRadius="6"
                    BorderBrush="#E0E0E0" BorderThickness="1">
                <ContentPresenter Margin="0"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="cardBorder" Property="BorderBrush" Value="#1a73e8"/>
                    <Setter TargetName="cardBorder" Property="Background" Value="#F8FBFF"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="cardBorder" Property="Opacity" Value="0.5"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
    </UserControl.Resources>
    <DockPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="35*"/>
                <ColumnDefinition Width="65*"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="4">
                <StackPanel>
                    <GroupBox Header="进销存管理" Margin="2,2,2,4">
                        <UniformGrid Columns="2">
                            <Button Content="采购进货" Tag="11" Click="DesktopButton_Click" Margin="2" Padding="4"/>
                            <Button Content="采购明细" Tag="31" Click="DesktopButton_Click" Margin="2" Padding="4"/>
                            <Button Content="计划订货" Tag="12" Click="DesktopButton_Click" Margin="2" Padding="4"/>
                            <Button Content="采购退货" Tag="118" Click="DesktopButton_Click" Margin="2" Padding="4"/>
                        </UniformGrid>
                    </GroupBox>

                    <GroupBox Header="销售管理" Margin="2,2,2,4">
                        <UniformGrid Columns="2">
                            <Button Content="销售开单" Tag="13" Click="DesktopButton_Click" Margin="2" Padding="4"/>
                            <Button Content="销售查询" Tag="133" Click="DesktopButton_Click" Margin="2" Padding="4"/>
                            <Button Content="销售退货" Tag="138" Click="DesktopButton_Click" Margin="2" Padding="4"/>
                        </UniformGrid>
                    </GroupBox>

                    <GroupBox Header="仓库管理" Margin="2,2,2,4">
                        <UniformGrid Columns="2">
                            <Button Content="查看库存" Tag="15" Click="DesktopButton_Click" Margin="2" Padding="4"/>
                            <Button Content="仓库盘点" Tag="151" Click="DesktopButton_Click" Margin="2" Padding="4"/>
                            <Button Content="库存预警" Tag="156" Click="DesktopButton_Click" Margin="2" Padding="4"/>
                        </UniformGrid>
                    </GroupBox>

                    <GroupBox Header="业务查询" Margin="2,2,2,4">
                        <UniformGrid Columns="2">
                            <Button Content="销售明细" Tag="33" Click="DesktopButton_Click" Margin="2" Padding="4"/>
                            <Button Content="报表中心" Tag="39" Click="DesktopButton_Click" Margin="2" Padding="4"/>
                        </UniformGrid>
                    </GroupBox>

                    <GroupBox Header="财务管理" Margin="2,2,2,4">
                        <UniformGrid Columns="2">
                            <Button Content="应付款" Tag="21" Click="DesktopButton_Click" Margin="2" Padding="4"/>
                            <Button Content="应收款" Tag="22" Click="DesktopButton_Click" Margin="2" Padding="4"/>
                            <Button Content="现金账" Tag="24" Click="DesktopButton_Click" Margin="2" Padding="4"/>
                            <Button Content="银行账" Tag="25" Click="DesktopButton_Click" Margin="2" Padding="4"/>
                        </UniformGrid>
                    </GroupBox>

                    <GroupBox Header="Web 服务管理" Margin="2,2,2,4">
                        <Grid Margin="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- 第一行：启动 / 停止 -->
                            <Button Grid.Row="0" Grid.Column="0" Content="▶ 启动服务" x:Name="btnWebStart"
                                    Click="BtnWebStart_Click" Margin="2" Padding="6,4"/>
                            <Button Grid.Row="0" Grid.Column="1" Content="■ 停止服务" x:Name="btnWebStop"
                                    Click="BtnWebStop_Click" Margin="2" Padding="6,4"/>

                            <!-- 第二行：状态 / 刷新 -->
                            <Button Grid.Row="1" Grid.Column="0" Content="🔄 刷新状态" x:Name="btnWebStatus"
                                    Click="BtnWebStatus_Click" Margin="2" Padding="6,4"/>
                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="在线: " FontSize="12" Foreground="#666"/>
                                <TextBlock x:Name="txtWebConnections" Text="0" FontWeight="Bold"
                                           FontSize="13" Foreground="#1a73e8"/>
                            </StackPanel>

                            <!-- 第三行：状态信息 -->
                            <Border Grid.Row="2" Grid.ColumnSpan="2" Background="#f5f5f5"
                                    CornerRadius="4" Padding="8,4" Margin="2,4,2,0">
                                <TextBlock x:Name="txtWebStatus" TextWrapping="Wrap" FontSize="12" Foreground="#555"
                                           Text="状态未知，点击「刷新状态」查看"/>
                            </Border>
                        </Grid>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>

            <!-- ========== 右侧：工作台仪表板 ========== -->
            <Grid Grid.Column="1" Margin="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 标题栏 -->
                <DockPanel Grid.Row="0" Margin="0,0,0,6">
                    <TextBlock Text="工作台 · 今日数据快照" FontSize="14" FontWeight="Bold"
                               VerticalAlignment="Center" Foreground="#333"/>
                    <TextBlock x:Name="txtLastRefresh" Text="" FontSize="11" Foreground="#999"
                               VerticalAlignment="Center" Margin="12,0,0,0"/>
                    <Button Content="🔄 刷新" DockPanel.Dock="Right" Click="BtnRefreshDashboard_Click"
                            Padding="8,3" Margin="4,0,0,0"/>
                </DockPanel>

                <!-- KPI 卡片行 -->
                <UniformGrid Grid.Row="1" Columns="2" Margin="0,0,0,6">
                    <!-- 今日销售 -->
                    <Button Template="{StaticResource KpiCardTemplate}" Tag="133"
                            Click="KpiCard_Click" Margin="3" HorizontalContentAlignment="Stretch">
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Width="4" Background="#1a73e8" CornerRadius="2"/>
                            <StackPanel Margin="10,8,8,8" VerticalAlignment="Center">
                                <TextBlock Text="今日销售" FontSize="11" Foreground="#888"/>
                                <TextBlock x:Name="txtTodaySell" Text="加载中..." FontSize="14" Foreground="#1a73e8"/>
                                <TextBlock x:Name="txtTodaySellCount" Text="" FontSize="11" Foreground="#AAA"/>
                            </StackPanel>
                        </DockPanel>
                    </Button>
                    <!-- 今日采购 -->
                    <Button Template="{StaticResource KpiCardTemplate}" Tag="31"
                            Click="KpiCard_Click" Margin="3" HorizontalContentAlignment="Stretch">
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Width="4" Background="#34A853" CornerRadius="2"/>
                            <StackPanel Margin="10,8,8,8" VerticalAlignment="Center">
                                <TextBlock Text="今日采购" FontSize="11" Foreground="#888"/>
                                <TextBlock x:Name="txtTodayBuy" Text="加载中..." FontSize="14" Foreground="#34A853"/>
                                <TextBlock x:Name="txtTodayBuyCount" Text="" FontSize="11" Foreground="#AAA"/>
                            </StackPanel>
                        </DockPanel>
                    </Button>
                </UniformGrid>

                <!-- 双栏列表：今日销售 + 配件销售排行 -->
                <Grid Grid.Row="2" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="5*"/>
                        <ColumnDefinition Width="5*"/>
                    </Grid.ColumnDefinitions>
                    <GroupBox Grid.Column="0" Header="今日销售单据（最近 10 笔）" Margin="3">
                        <DataGrid x:Name="dgRecentSells" AutoGenerateColumns="False"
                                  IsReadOnly="True" SelectionMode="Single"
                                  HeadersVisibility="Column"
                                  AlternatingRowBackground="#F8F8F8"
                                  GridLinesVisibility="Horizontal"
                                  MouseDoubleClick="DgRecentSells_MouseDoubleClick">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="单号" Binding="{Binding Sn}" Width="110"/>
                                <DataGridTextColumn Header="客户名称" Binding="{Binding ClientName}" Width="*"/>
                                <DataGridTextColumn Header="金额" Binding="{Binding Total, StringFormat=¥{0:N2}}" Width="*"/>
                                <DataGridTextColumn Header="时间" Binding="{Binding Datetime, StringFormat=HH:mm}" Width="50"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>
                    <GroupBox Grid.Column="1" Header="今日配件销售排行（全部）" Margin="3">
                        <DataGrid x:Name="dgPartsRanking" AutoGenerateColumns="False"
                                  IsReadOnly="True" SelectionMode="Single"
                                  HeadersVisibility="Column"
                                  AlternatingRowBackground="#F8F8F8"
                                  GridLinesVisibility="Horizontal">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="排名" Binding="{Binding Rank}" Width="35"/>
                                <DataGridTextColumn Header="编号" Binding="{Binding PartNo}" Width="85"/>
                                <DataGridTextColumn Header="名称" Binding="{Binding PartName}" Width="*"/>
                                <DataGridTextColumn Header="车型" Binding="{Binding Cartype}" Width="75"/>
                                <DataGridTextColumn Header="销量" Binding="{Binding SaleAmount}" Width="50"/>
                                <DataGridTextColumn Header="金额" Binding="{Binding SaleTotal, StringFormat=¥{0:N2}}" Width="80"/>
                                <DataGridTextColumn Header="库存" Binding="{Binding StockAmount}" Width="50"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>
                </Grid>

            </Grid>
        </Grid>
    </DockPanel>
</UserControl>
