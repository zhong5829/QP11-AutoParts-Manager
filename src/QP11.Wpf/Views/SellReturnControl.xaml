<UserControl x:Class="QP11.Wpf.Views.SellReturnControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:QP11.Wpf.Helpers"
             xmlns:controls="clr-namespace:QP11.Wpf.Controls"
             helpers:EnterToTabHelper.IsEnabled="True">
    <UserControl.Resources>
        <helpers:SingleLineConverter x:Key="SingleLineConverter"/>
        <Style x:Key="SingleLineCell" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
        </Style>
    </UserControl.Resources>
    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="3*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Row0: 顶部导航按钮栏 -->
        <Grid Grid.Row="0" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <WrapPanel Orientation="Horizontal">
                <Button Content="采购管理" Tag="11" Click="NavButton_Click" Margin="2" Padding="8,4"/>
                <Button Content="计划管理" Tag="12" Click="NavButton_Click" Margin="2" Padding="8,4"/>
                <Button Content="采购退货" Tag="118" Click="NavButton_Click" Margin="2" Padding="8,4"/>
                <Button Content="销售开单" Tag="13" Click="NavButton_Click" Margin="2" Padding="8,4"/>
                <Button Content="销售退货" Tag="138" Click="NavButton_Click" Margin="2" Padding="8,4"/>
                <Button Content="销售查询" Tag="133" Click="NavButton_Click" Margin="2" Padding="8,4"/>
                <Button Content="计划订货" Tag="12" Click="NavButton_Click" Margin="2" Padding="8,4"/>
                <Button Content="仓位查询" Tag="15" Click="NavButton_Click" Margin="2" Padding="8,4"/>
                <Button Content="仓库盘点" Tag="151" Click="NavButton_Click" Margin="2" Padding="8,4"/>
                <Button Content="库存预警" Tag="156" Click="NavButton_Click" Margin="2" Padding="8,4"/>
                <Button Content="报损管理" Tag="17" Click="NavButton_Click" Margin="2" Padding="8,4"/>
                <Button Content="借还管理" Tag="18" Click="NavButton_Click" Margin="2" Padding="8,4"/>
                <Button Content="计算器" Click="NavCalc_Click" Margin="2" Padding="8,4"/>
                <Button Content="记事本" Click="NavNotepad_Click" Margin="2" Padding="8,4"/>
            </WrapPanel>
            <TextBlock Grid.Column="1" Text="销售退货" Foreground="Red" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" Margin="8,0,0,0"/>
        </Grid>

        <!-- Row1: 单头信息 -->
        <GroupBox Grid.Row="1" Header="退货信息" Margin="0,0,0,4" Padding="4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="退货单号:" VerticalAlignment="Center" Margin="2"/>
                <TextBox Grid.Column="1" x:Name="txtBillNo" IsReadOnly="True" Background="LightGray" Margin="2"/>
                <TextBlock Grid.Column="2" Text="日期:" VerticalAlignment="Center" Margin="8,2,2,2"/>
                <DatePicker Grid.Column="3" x:Name="dtBillDate" Margin="2"/>
                <TextBlock Grid.Column="4" Text="客户:" VerticalAlignment="Center" Margin="8,2,2,2"/>
                <controls:ClientSearchBox Grid.Column="5" x:Name="cboClient" Margin="2"/>
                <TextBlock Grid.Column="6" Text="业务员:" VerticalAlignment="Center" Margin="8,2,2,2"/>
                <ComboBox Grid.Column="7" x:Name="cboWorker" IsEditable="True" Margin="2"
                          DisplayMemberPath="Name" SelectedValuePath="Username"/>
                <TextBlock Grid.Column="8" Text="备注:" VerticalAlignment="Center" Margin="8,2,2,2"/>
                <TextBox Grid.Column="9" x:Name="txtMemo" Margin="2"/>
                <Button Grid.Column="10" Content="选择客户" Width="80" HorizontalAlignment="Left" Margin="8,2,2,2" Click="BtnSelectClient_Click"/>
            </Grid>
        </GroupBox>

        <!-- Row2: 查询条件 + 客户拿货明细 -->
        <Grid Grid.Row="2" Margin="0,0,0,4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <GroupBox Grid.Row="0" Header="查询条件" Margin="0,0,0,2" Padding="4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="编码:" VerticalAlignment="Center" Margin="2"/>
                    <TextBox Grid.Column="1" x:Name="txtPartNo" Margin="2" TextChanged="TxtQuery_TextChanged"
                             GotFocus="QueryInput_GotFocus" PreviewKeyDown="QueryInput_PreviewKeyDown"/>
                    <TextBlock Grid.Column="2" Text="名称:" VerticalAlignment="Center" Margin="8,2,2,2"/>
                    <TextBox Grid.Column="3" x:Name="txtPartName" Margin="2" TextChanged="TxtQuery_TextChanged"
                             GotFocus="QueryInput_GotFocus" PreviewKeyDown="QueryInput_PreviewKeyDown"/>
                    <TextBlock Grid.Column="4" Text="车型:" VerticalAlignment="Center" Margin="8,2,2,2"/>
                    <TextBox Grid.Column="5" x:Name="txtCartype" Margin="2" TextChanged="TxtQuery_TextChanged"
                             GotFocus="QueryInput_GotFocus" PreviewKeyDown="QueryInput_PreviewKeyDown"/>
                    <StackPanel Grid.Column="6" Orientation="Horizontal" Margin="8,2,2,2">
                        <Button Content="查询" Width="60" Click="BtnSearch_Click"/>
                        <Button Content="重置" Width="60" Margin="4,0,0,0" Click="BtnReset_Click"/>
                    </StackPanel>
                </Grid>
            </GroupBox>

            <DataGrid Grid.Row="1" x:Name="dgSourceDetails" AutoGenerateColumns="False" IsReadOnly="True"
                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                      MouseDoubleClick="DgSourceDetails_MouseDoubleClick" SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="单号" Width="110" Binding="{Binding sn, Converter={StaticResource SingleLineConverter}}" ElementStyle="{StaticResource SingleLineCell}"/>
                    <DataGridTextColumn Header="编码" Width="90" Binding="{Binding partno, Converter={StaticResource SingleLineConverter}}" ElementStyle="{StaticResource SingleLineCell}"/>
                    <DataGridTextColumn Header="名称" Width="140" Binding="{Binding name, Converter={StaticResource SingleLineConverter}}" ElementStyle="{StaticResource SingleLineCell}"/>
                    <DataGridTextColumn Header="车型" Width="70" Binding="{Binding cartype, Converter={StaticResource SingleLineConverter}}" ElementStyle="{StaticResource SingleLineCell}"/>
                    <DataGridTextColumn Header="数量" Width="55" Binding="{Binding amount}" ElementStyle="{StaticResource SingleLineCell}"/>
                    <DataGridTextColumn Header="已退" Width="50" Binding="{Binding returned_amount}" ElementStyle="{StaticResource SingleLineCell}"/>
                    <DataGridTextColumn Header="可退" Width="50" Binding="{Binding remain_amount}" ElementStyle="{StaticResource SingleLineCell}"/>
                    <DataGridTextColumn Header="单价" Width="70" Binding="{Binding price, StringFormat=N2}" ElementStyle="{StaticResource SingleLineCell}"/>
                    <DataGridTextColumn Header="小计" Width="80" Binding="{Binding stotal, StringFormat=N2}" ElementStyle="{StaticResource SingleLineCell}"/>
                    <DataGridTextColumn Header="仓位" Width="60" Binding="{Binding place, Converter={StaticResource SingleLineConverter}}" ElementStyle="{StaticResource SingleLineCell}"/>
                    <DataGridTextColumn Header="日期" Width="90" Binding="{Binding datetime, StringFormat=yyyy-MM-dd}" ElementStyle="{StaticResource SingleLineCell}"/>
                    <DataGridTextColumn Header="备注" Width="*" Binding="{Binding memo, Converter={StaticResource SingleLineConverter}}" ElementStyle="{StaticResource SingleLineCell}"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- Row3: 分隔 -->
        <GridSplitter Grid.Row="3" Height="4" HorizontalAlignment="Stretch" Background="LightGray" Margin="0,2"/>

        <!-- Row4: 退货明细 -->
        <DataGrid Grid.Row="4" x:Name="dgReturnDetails" AutoGenerateColumns="False" CanUserAddRows="False"
                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                  Margin="0,0,0,4" PreviewKeyDown="DgReturnDetails_PreviewKeyDown"
                  MouseDoubleClick="DgReturnDetails_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="原单号" Width="110" Binding="{Binding SourceSn, Converter={StaticResource SingleLineConverter}}" IsReadOnly="True" ElementStyle="{StaticResource SingleLineCell}"/>
                <DataGridTextColumn Header="编码" Width="90" Binding="{Binding PartNo, Converter={StaticResource SingleLineConverter}}" IsReadOnly="True" ElementStyle="{StaticResource SingleLineCell}"/>
                <DataGridTextColumn Header="名称" Width="140" Binding="{Binding PartName, Converter={StaticResource SingleLineConverter}}" IsReadOnly="True" ElementStyle="{StaticResource SingleLineCell}"/>
                <DataGridTextColumn Header="车型" Width="70" Binding="{Binding Cartype, Converter={StaticResource SingleLineConverter}}" IsReadOnly="True" ElementStyle="{StaticResource SingleLineCell}"/>
                <DataGridTextColumn Header="退货数量" Width="70" Binding="{Binding Amount}" ElementStyle="{StaticResource SingleLineCell}"/>
                <DataGridTextColumn Header="退货单价" Width="70" Binding="{Binding Price, StringFormat=N2}" ElementStyle="{StaticResource SingleLineCell}"/>
                <DataGridTextColumn Header="退货小计" Width="80" Binding="{Binding SubTotal, StringFormat=N2}" IsReadOnly="True" ElementStyle="{StaticResource SingleLineCell}"/>
                <DataGridCheckBoxColumn Header="废品仓" Width="55" Binding="{Binding ToWaste}" IsReadOnly="True"/>
                <DataGridTextColumn Header="关联进货单" Width="100" Binding="{Binding SourceBuySn, Converter={StaticResource SingleLineConverter}}" IsReadOnly="True" ElementStyle="{StaticResource SingleLineCell}"/>
                <DataGridTextColumn Header="供应商" Width="90" Binding="{Binding SourceBuySupplier, Converter={StaticResource SingleLineConverter}}" IsReadOnly="True" ElementStyle="{StaticResource SingleLineCell}"/>
                <DataGridTextColumn Header="备注" Width="*" Binding="{Binding Memo, Converter={StaticResource SingleLineConverter}}" ElementStyle="{StaticResource SingleLineCell}"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Row5: 合计栏 -->
        <Grid Grid.Row="5" Margin="0,2,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="退货合计:" VerticalAlignment="Center" FontWeight="Bold"/>
                <TextBlock x:Name="txtSumTotal" Text="0.00" VerticalAlignment="Center" Margin="4,0" FontWeight="Bold" Foreground="Red"/>
                <TextBlock Text="退货数量:" VerticalAlignment="Center" Margin="16,0,0,0" FontWeight="Bold"/>
                <TextBlock x:Name="txtSumAmount" Text="0" VerticalAlignment="Center" Margin="4,0" FontWeight="Bold"/>
                <Button Content="结算(F5)" Width="80" Margin="24,2,4,2" Click="BtnSettle_Click"/>
                <Button Content="清空(F9)" Width="80" Margin="4,2" Click="BtnClear_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
