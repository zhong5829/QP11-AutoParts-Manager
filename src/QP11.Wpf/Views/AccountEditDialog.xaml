<Window x:Class="QP11.Wpf.Views.AccountEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑账目" Height="280" Width="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="70"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Text="名称:" VerticalAlignment="Center"/>
        <TextBox Grid.Column="1" x:Name="txtName" Margin="2"/>

        <TextBlock Grid.Row="1" Text="金额:" VerticalAlignment="Center" Margin="0,6,0,0"/>
        <TextBox Grid.Row="1" Grid.Column="1" x:Name="txtAmount" Margin="2,6"/>

        <TextBlock Grid.Row="2" Text="类型:" VerticalAlignment="Center" Margin="0,6,0,0"/>
        <ComboBox Grid.Row="2" Grid.Column="1" x:Name="cboFlag" Margin="2,6" SelectedIndex="0">
            <ComboBoxItem Content="支出" Tag="0"/>
            <ComboBoxItem Content="收入" Tag="1"/>
        </ComboBox>

        <TextBlock Grid.Row="3" Text="账户:" VerticalAlignment="Center" Margin="0,6,0,0"/>
        <ComboBox Grid.Row="3" Grid.Column="1" x:Name="cboType" IsEditable="True" Margin="2,6" SelectedIndex="0">
            <ComboBoxItem Content="现金"/>
            <ComboBoxItem Content="银行"/>
            <ComboBoxItem Content="支付宝"/>
            <ComboBoxItem Content="微信"/>
        </ComboBox>

        <TextBlock Grid.Row="4" Text="备注:" VerticalAlignment="Center" Margin="0,6,0,0"/>
        <TextBox Grid.Row="4" Grid.Column="1" x:Name="txtMemo" Margin="2,6"/>

        <StackPanel Grid.Row="5" Grid.ColumnSpan="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="确定" Width="70" IsDefault="True" Click="BtnOk_Click"/>
            <Button Content="取消" Width="70" Margin="8,0,0,0" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
