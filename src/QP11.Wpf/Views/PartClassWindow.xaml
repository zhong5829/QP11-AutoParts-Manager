<Window x:Class="QP11.Wpf.Views.PartClassWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="配件分类管理" Height="500" Width="700"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <DockPanel>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,5">
                <Button Content="新增" Width="50" Height="24" Click="BtnAdd_Click"/>
                <Button Content="删除" Width="50" Height="24" Margin="5,0" Click="BtnDelete_Click"/>
            </StackPanel>
            <TreeView x:Name="tvClass" SelectedItemChanged="TvClass_SelectedItemChanged"/>
        </DockPanel>

        <DockPanel Grid.Column="1" Margin="5,0,0,0">
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,5">
                <TextBlock Text="分类名称:" Margin="0,5"/>
                <TextBox x:Name="txtClassName" Margin="0,2"/>
                <TextBlock Text="上级分类ID:" Margin="0,5"/>
                <TextBox x:Name="txtParentId" IsReadOnly="True" Background="LightGray" Margin="0,2"/>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="保存" Width="60" Height="26" Click="BtnSave_Click"/>
                    <Button Content="新增子分类" Width="80" Height="26" Margin="10,0" Click="BtnAddChild_Click"/>
                </StackPanel>
            </StackPanel>
            <DataGrid x:Name="dgChildren" AutoGenerateColumns="False" CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Width="80" Binding="{Binding ClassId}" IsReadOnly="True"/>
                    <DataGridTextColumn Header="名称" Width="150" Binding="{Binding ClassName}"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </Grid>
</Window>
