<UserControl x:Class="QP11.Wpf.Views.AccountControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:QP11.Wpf.Helpers"
             helpers:EnterToTabHelper.IsEnabled="True"
             Loaded="UserControl_Loaded">
    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="6*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="4*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
            <TextBlock Text="类型:" VerticalAlignment="Center"/>
            <ComboBox x:Name="cboFlag" Width="80" Margin="4,0" SelectedIndex="0">
                <ComboBoxItem Content="全部" Tag=""/>
                <ComboBoxItem Content="收入" Tag="1"/>
                <ComboBoxItem Content="支出" Tag="0"/>
            </ComboBox>
            <TextBlock Text="日期从:" VerticalAlignment="Center" Margin="8,0,0,0"/>
            <DatePicker x:Name="dtStart" Width="130" Margin="4,0"/>
            <TextBlock Text="到:" VerticalAlignment="Center"/>
            <DatePicker x:Name="dtEnd" Width="130" Margin="4,0"/>
            <Button Content="查询" Width="60" Margin="8,0,0,0" Click="BtnQuery_Click"/>
            <Button Content="新增" Width="60" Margin="4,0" Click="BtnAdd_Click"/>
            <Button Content="编辑" Width="60" Margin="4,0" Click="BtnEdit_Click"/>
            <Button Content="删除" Width="60" Margin="4,0" Click="BtnDelete_Click"/>
        </StackPanel>

        <DataGrid Grid.Row="1" x:Name="dgAccounts" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single" SelectionChanged="DgAccounts_SelectionChanged"
                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                  AlternatingRowBackground="#F8F8F8" GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Width="50" Binding="{Binding id}"/>
                <DataGridTextColumn Header="名称" Width="80" Binding="{Binding name}"/>
                <DataGridTextColumn Header="单号" Width="110" Binding="{Binding sn}"/>
                <DataGridTextColumn Header="金额" Width="90" Binding="{Binding charge, StringFormat=N2}"/>
                <DataGridTextColumn Header="类型" Width="60" Binding="{Binding flag_type}"/>
                <DataGridTextColumn Header="操作员" Width="60" Binding="{Binding operator}"/>
                <DataGridTextColumn Header="备注" Width="*" Binding="{Binding memo}"/>
                <DataGridTextColumn Header="日期" Width="100" Binding="{Binding datetime, StringFormat=yyyy-MM-dd}"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,4">
            <TextBlock x:Name="txtCount" Text="共 0 条记录" VerticalAlignment="Center"/>
            <TextBlock Text="|" Margin="8,0" VerticalAlignment="Center"/>
            <TextBlock Text="收入合计:" VerticalAlignment="Center"/>
            <TextBlock x:Name="txtSumIncome" Text="0.00" Margin="3,0" FontWeight="Bold" Foreground="Green" VerticalAlignment="Center"/>
            <TextBlock Text="支出合计:" Margin="10,0,0,0" VerticalAlignment="Center"/>
            <TextBlock x:Name="txtSumExpense" Text="0.00" Margin="3,0" FontWeight="Bold" Foreground="Red" VerticalAlignment="Center"/>
            <TextBlock Text="余额:" Margin="10,0,0,0" VerticalAlignment="Center"/>
            <TextBlock x:Name="txtBalance" Text="0.00" Margin="3,0" FontWeight="Bold" Foreground="Blue" VerticalAlignment="Center"/>
        </StackPanel>

        <GroupBox Grid.Row="3" Header="关联明细" Margin="0,2,0,0">
            <DataGrid x:Name="dgDetail" AutoGenerateColumns="False" IsReadOnly="True"
                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                      AlternatingRowBackground="#F8F8F8" GridLinesVisibility="Horizontal">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="配件编码" Width="90" Binding="{Binding partno}"/>
                    <DataGridTextColumn Header="名称" Width="120" Binding="{Binding name}"/>
                    <DataGridTextColumn Header="数量" Width="60" Binding="{Binding amount}"/>
                    <DataGridTextColumn Header="单位" Width="50" Binding="{Binding unit}"/>
                    <DataGridTextColumn Header="车型" Width="100" Binding="{Binding cartype}"/>
                    <DataGridTextColumn Header="单价" Width="80" Binding="{Binding price, StringFormat=N2}"/>
                    <DataGridTextColumn Header="小计" Width="90" Binding="{Binding stotal, StringFormat=N2}"/>
                    <DataGridTextColumn Header="备注" Width="*" Binding="{Binding memo}"/>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>
    </Grid>
</UserControl>
