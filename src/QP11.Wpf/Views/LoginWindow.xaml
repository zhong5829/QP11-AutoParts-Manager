<Window x:Class="QP11.Wpf.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="汽配通汽车配件管理系统--登陆版"
        Height="400" Width="700"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow">
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Height="60" Background="#2E5C8A">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="汽配通汽车配件管理系统--登陆版"
                           Foreground="White" FontSize="18" FontWeight="Bold"
                           HorizontalAlignment="Center"/>
                </StackPanel>
        </DockPanel>

        <DockPanel DockPanel.Dock="Bottom" Height="24" Background="#F0F0F0">
            <TextBlock Text="初始操作员:qp110 密码:qp110"
                       Foreground="Gray" FontSize="10"
                       VerticalAlignment="Center" Margin="8,0,0,0"/>
            <TextBlock x:Name="txtStatus" Text="Ver 13.1"
                       Foreground="Gray" FontSize="10"
                       VerticalAlignment="Center" HorizontalAlignment="Right"
                       Margin="0,0,8,0"/>
        </DockPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Margin="4" BorderBrush="#CCCCCC" BorderThickness="1" Background="#2E5C8A">
                <Grid>
                    <Image x:Name="imgCar0" Stretch="UniformToFill" Visibility="Visible"/>
                    <Image x:Name="imgCar1" Stretch="UniformToFill" Visibility="Collapsed"/>
                    <Image x:Name="imgCar2" Stretch="UniformToFill" Visibility="Collapsed"/>
                    <!-- 轮播指示点 -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                VerticalAlignment="Bottom" Margin="0,0,0,8">
                        <Ellipse x:Name="dot0" Width="8" Height="8" Fill="White" Margin="3,0"/>
                        <Ellipse x:Name="dot1" Width="8" Height="8" Fill="#80FFFFFF" Margin="3,0"/>
                        <Ellipse x:Name="dot2" Width="8" Height="8" Fill="#80FFFFFF" Margin="3,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,20,12,20">
                <StackPanel Orientation="Horizontal" Margin="0,6">
                    <TextBlock Text="操作员:" Width="60" VerticalAlignment="Center" FontSize="13"/>
                    <ComboBox x:Name="cmbUsername" Width="180" TabIndex="1" IsEditable="True"
                              DisplayMemberPath="Name" SelectedValuePath="Username" FontSize="13"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,12,6,0">
                    <TextBlock Text="密  码:" Width="60" VerticalAlignment="Center" FontSize="13"/>
                    <PasswordBox x:Name="txtPassword" Width="180" PasswordChar="*" TabIndex="2" FontSize="13"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="80,20,0,0">
                    <Button Content="确认[&amp;S]" Width="72" Height="28" IsDefault="True"
                            Click="BtnLogin_Click" TabIndex="3" Margin="0,0,12,0"/>
                    <Button Content="取消[&amp;C]" Width="72" Height="28" IsCancel="True" TabIndex="4"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
