<UserControl x:Class="QP11.Wpf.Views.SellControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:QP11.Wpf.Helpers"
             xmlns:controls="clr-namespace:QP11.Wpf.Controls"
             helpers:EnterToTabHelper.IsEnabled="True">
    <UserControl.Resources>
        <helpers:SingleLineConverter x:Key="SingleLineConverter"/>
        <Style x:Key="SingleLineCell" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
        </Style>
    </UserControl.Resources>
    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Row0: 顶部导航按钮栏 -->
        <Grid Grid.Row="0" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <WrapPanel Orientation="Horizontal">
                <Button Content="采购管理" Tag="11" Click="NavButton_Click" Margin="2" Padding="8,4"/>
                <Button Content="采购明细" Tag="31" Click="NavButton_Click" Margin="2" Padding="8,4"/>
                <Button Content="销售明细" Tag="33" Click="NavButton_Click" Margin="2" Padding="8,4"/>
                <Button Content="VIN查询" Tag="vin1" Click="NavButton_Click" Margin="2" Padding="8,4"/>
                <Button Content="销售开单" Tag="13" Click="NavButton_Click" Margin="2" Padding="8,4"/>
                <Button Content="销售退货" Tag="138" Click="NavButton_Click" Margin="2" Padding="8,4"/>
                <Button Content="销售查询" Tag="133" Click="NavButton_Click" Margin="2" Padding="8,4"/>
                <Button Content="计划订货" Tag="12" Click="NavButton_Click" Margin="2" Padding="8,4"/>
                <Button Content="仓位查询" Tag="15" Click="NavButton_Click" Margin="2" Padding="8,4"/>
                <Button Content="仓库盘点" Tag="151" Click="NavButton_Click" Margin="2" Padding="8,4"/>
                <Button Content="库存预警" Tag="156" Click="NavButton_Click" Margin="2" Padding="8,4"/>
                <Button Content="报损管理" Tag="17" Click="NavButton_Click" Margin="2" Padding="8,4"/>
                <Button Content="借还管理" Tag="18" Click="NavButton_Click" Margin="2" Padding="8,4"/>
                <Button Content="计算器" Click="NavCalc_Click" Margin="2" Padding="8,4"/>
                <Button Content="记事本" Click="NavNotepad_Click" Margin="2" Padding="8,4"/>
            </WrapPanel>
            <TextBlock Grid.Column="1" x:Name="txtModeIndicator" Text="退货模式" Foreground="Red" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" Visibility="Collapsed" Margin="8,0,0,0"/>
        </Grid>

        <!-- ========== Mode A: 销售开单模式 ========== -->
        <Grid x:Name="panelOrderMode" Grid.Row="1" Grid.RowSpan="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="3*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Row0: 查询条件区 -->
            <Grid Grid.Row="0" Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="配件编号:" VerticalAlignment="Center" Margin="2"/>
                <TextBox Grid.Column="1" x:Name="txtPartNo" Margin="2" TextChanged="TxtPartQuery_TextChanged" PreviewKeyDown="QueryTextBox_PreviewKeyDown" GotFocus="QueryTextBox_GotFocus"/>
                <TextBlock Grid.Column="2" Text="名称:" VerticalAlignment="Center" Margin="8,2,2,2"/>
                <TextBox Grid.Column="3" x:Name="txtPartName" Margin="2" TextChanged="TxtPartQuery_TextChanged" PreviewKeyDown="QueryTextBox_PreviewKeyDown" GotFocus="QueryTextBox_GotFocus"/>
                <TextBlock Grid.Column="4" Text="车型:" VerticalAlignment="Center" Margin="8,2,2,2"/>
                <TextBox Grid.Column="5" x:Name="txtCartype" Margin="2" TextChanged="TxtPartQuery_TextChanged" PreviewKeyDown="QueryTextBox_PreviewKeyDown" GotFocus="QueryTextBox_GotFocus"/>
                <TextBlock Grid.Column="6" Text="分类:" VerticalAlignment="Center" Margin="8,2,2,2"/>
                <TextBox Grid.Column="7" x:Name="txtClass" Margin="2" TextChanged="TxtPartQuery_TextChanged" PreviewKeyDown="QueryTextBox_PreviewKeyDown" GotFocus="QueryTextBox_GotFocus"/>
                <TextBlock Grid.Column="8" Text="匹配:" VerticalAlignment="Center" Margin="8,2,2,2"/>
                <ComboBox Grid.Column="9" x:Name="cmbQueryMode" Margin="2" Width="65" SelectedIndex="3">
                    <ComboBoxItem Content="精确"/>
                    <ComboBoxItem Content="左匹配"/>
                    <ComboBoxItem Content="右匹配"/>
                    <ComboBoxItem Content="包含"/>
                </ComboBox>
                <Button Grid.Column="10" Content="多条件查询" Padding="6,2" Margin="4,2,0,2" Click="BtnMultiCodeQuery_Click"/>
                <Button Grid.Column="11" Content="切换查询模式(F3)" Padding="6,2" HorizontalAlignment="Right" Margin="4,2,0,2" Click="BtnSwitchMode_Click"/>
            </Grid>

            <!-- Row1: 配件库存列表 + 配件图片 -->
            <Grid Grid.Row="1" Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="160"/>
                </Grid.ColumnDefinitions>
                <DataGrid x:Name="dgParts" AutoGenerateColumns="False" IsReadOnly="True"
                          VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                          MouseDoubleClick="DgParts_MouseDoubleClick" PreviewKeyDown="DgParts_PreviewKeyDown"
                          SelectionChanged="DgParts_SelectionChanged"
                          SelectionMode="Single">
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="隐藏废品仓" IsCheckable="True" IsChecked="True" Click="MiHideScrap_Click"/>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="编号" Width="90" Binding="{Binding PartNo, Converter={StaticResource SingleLineConverter}}" ElementStyle="{StaticResource SingleLineCell}"/>
                        <DataGridTextColumn Header="名称" Width="160" Binding="{Binding Name, Converter={StaticResource SingleLineConverter}}" ElementStyle="{StaticResource SingleLineCell}"/>
                        <DataGridTextColumn Header="车型" Width="80" Binding="{Binding CarType, Converter={StaticResource SingleLineConverter}}" ElementStyle="{StaticResource SingleLineCell}"/>
                        <DataGridTextColumn Header="库存" Width="55" Binding="{Binding Amount}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource SingleLineCell}">
                                    <Setter Property="Foreground" Value="Red"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="零售价" Width="70" Binding="{Binding LsPrice, StringFormat=N2}" ElementStyle="{StaticResource SingleLineCell}"/>
                        <DataGridTextColumn Header="批发价" Width="70" Binding="{Binding PfPrice, StringFormat=N2}" ElementStyle="{StaticResource SingleLineCell}"/>
                        <DataGridTextColumn Header="分类" Width="60" Binding="{Binding Class, Converter={StaticResource SingleLineConverter}}" ElementStyle="{StaticResource SingleLineCell}"/>
                        <DataGridTextColumn Header="仓位" Width="60" Binding="{Binding Place, Converter={StaticResource SingleLineConverter}}" ElementStyle="{StaticResource SingleLineCell}"/>
                        <DataGridTextColumn Header="备注" Width="*" Binding="{Binding Memo, Converter={StaticResource SingleLineConverter}}" ElementStyle="{StaticResource SingleLineCell}"/>
                    </DataGrid.Columns>
                </DataGrid>
                <Border Grid.Column="1" BorderBrush="LightGray" BorderThickness="1" Margin="4,0,0,0" Background="#FFF5F5F5">
                    <Image x:Name="imgPart" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"
                           Cursor="Hand" MouseLeftButtonUp="ImgPart_Click">
                        <Image.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="查看大图" Click="ImgPart_Preview_Click"/>
                                <MenuItem Header="复制图片" Click="ImgPart_Copy_Click"/>
                            </ContextMenu>
                        </Image.ContextMenu>
                    </Image>
                </Border>
            </Grid>

            <!-- Row2: 单头信息 -->
            <GroupBox Grid.Row="2" Header="单头信息" Margin="0,0,0,4" Padding="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="单号:" VerticalAlignment="Center" Margin="2"/>
                    <TextBox Grid.Column="1" x:Name="txtBillNo" IsReadOnly="True" Background="LightGray" Margin="2"/>
                    <TextBlock Grid.Column="2" Text="日期:" VerticalAlignment="Center" Margin="8,2,2,2"/>
                    <DatePicker Grid.Column="3" x:Name="dtBillDate" Margin="2" helpers:DatePickerHelper.EnableSmartEdit="True"/>
                    <TextBlock Grid.Column="4" Text="客户:" VerticalAlignment="Center" Margin="8,2,2,2"/>
                    <controls:ClientSearchBox Grid.Column="5" x:Name="cboClient" Margin="2"/>
                    <TextBlock Grid.Column="6" Text="业务员:" VerticalAlignment="Center" Margin="8,2,2,2"/>
                    <ComboBox Grid.Column="7" x:Name="cboWorker" IsEditable="True" Margin="2"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="支票号:" VerticalAlignment="Center" Margin="2"/>
                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="txtCheckno" Margin="2"/>
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="折扣率:" VerticalAlignment="Center" Margin="8,2,2,2"/>
                    <TextBox Grid.Row="1" Grid.Column="3" x:Name="txtDiscountRate" Text="0" Margin="2" TextChanged="TxtDiscountRate_TextChanged"/>
                    <TextBlock Grid.Row="1" Grid.Column="4" Text="总额:" VerticalAlignment="Center" Margin="8,2,2,2"/>
                    <TextBox Grid.Row="1" Grid.Column="5" x:Name="txtTotal" IsReadOnly="True" Background="LightGray" Margin="2"/>
                    <TextBlock Grid.Row="1" Grid.Column="6" Text="开票总额:" VerticalAlignment="Center" Margin="8,2,2,2"/>
                    <TextBox Grid.Row="1" Grid.Column="7" x:Name="txtBillTotal" IsReadOnly="True" Background="LightGray" Margin="2"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="现金:" VerticalAlignment="Center" Margin="2"/>
                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="txtCash" Text="0" Margin="2" TextChanged="Payment_TextChanged"/>
                    <TextBlock Grid.Row="2" Grid.Column="2" Text="支票:" VerticalAlignment="Center" Margin="8,2,2,2"/>
                    <TextBox Grid.Row="2" Grid.Column="3" x:Name="txtChecks" Text="0" Margin="2" TextChanged="Payment_TextChanged"/>
                    <TextBlock Grid.Row="2" Grid.Column="4" Text="欠款:" VerticalAlignment="Center" Margin="8,2,2,2"/>
                    <TextBox Grid.Row="2" Grid.Column="5" x:Name="txtArrear" IsReadOnly="True" Background="LightGray" Margin="2"/>
                    <TextBlock Grid.Row="2" Grid.Column="6" Text="支付宝:" VerticalAlignment="Center" Margin="8,2,2,2"/>
                    <TextBox Grid.Row="2" Grid.Column="7" x:Name="txtZhifubao" Text="0" Margin="2" TextChanged="Payment_TextChanged"/>
                    <TextBlock Grid.Row="2" Grid.Column="8" Text="微信:" VerticalAlignment="Center" Margin="8,2,2,2"/>
                    <TextBox Grid.Row="2" Grid.Column="8" x:Name="txtWeixin" Text="0" Margin="40,2,2,2" Width="100" HorizontalAlignment="Left" TextChanged="Payment_TextChanged"/>

                    <TextBlock Grid.Row="2" Grid.Column="8" Text="备注:" VerticalAlignment="Center" Margin="150,2,2,2"/>
                    <TextBox Grid.Row="2" Grid.Column="8" x:Name="txtMemo" Margin="190,2,2,2"/>
                </Grid>
            </GroupBox>

            <!-- Row3: 销售明细 DataGrid -->
            <DataGrid Grid.Row="3" x:Name="dgDetails" AutoGenerateColumns="False" CanUserAddRows="False"
                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                      Margin="0,0,0,4"
                      PreparingCellForEdit="DgDetails_PreparingCellForEdit">
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="删除此条" Click="DgDetails_Delete_Click"/>
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="编号" Width="90" Binding="{Binding PartNo, Converter={StaticResource SingleLineConverter}}" ElementStyle="{StaticResource SingleLineCell}"/>
                    <DataGridTextColumn Header="名称" Width="130" Binding="{Binding PartName, Converter={StaticResource SingleLineConverter}}" ElementStyle="{StaticResource SingleLineCell}" IsReadOnly="True"/>
                    <DataGridTextColumn Header="数量" Width="55" Binding="{Binding Amount}" ElementStyle="{StaticResource SingleLineCell}"/>
                    <DataGridTemplateColumn Header="单价" Width="70">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Price, StringFormat=N2}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding Price, UpdateSourceTrigger=LostFocus}" LostFocus="DgDetails_Price_LostFocus"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="开票单价" Width="70" Binding="{Binding BillPrice, StringFormat=N2}" ElementStyle="{StaticResource SingleLineCell}"/>
                    <DataGridTextColumn Header="小计" Width="75" Binding="{Binding SubTotal, StringFormat=N2}" IsReadOnly="True" ElementStyle="{StaticResource SingleLineCell}"/>
                    <DataGridTextColumn Header="车型" Width="65" Binding="{Binding Cartype, Converter={StaticResource SingleLineConverter}}" ElementStyle="{StaticResource SingleLineCell}"/>
                    <DataGridTextColumn Header="车牌" Width="70" Binding="{Binding CarMark, Converter={StaticResource SingleLineConverter}}" ElementStyle="{StaticResource SingleLineCell}"/>
                    <DataGridTextColumn Header="备注" Width="120" Binding="{Binding Memo, Converter={StaticResource SingleLineConverter}}" ElementStyle="{StaticResource SingleLineCell}"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Row4: 合计栏 -->
            <Grid Grid.Row="4" Margin="0,2,0,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="合计:" VerticalAlignment="Center" FontWeight="Bold"/>
                    <TextBlock x:Name="txtSumTotal" Text="0.00" VerticalAlignment="Center" Margin="4,0" FontWeight="Bold" Foreground="Red"/>
                    <TextBlock Text="开票合计:" VerticalAlignment="Center" Margin="16,0,0,0" FontWeight="Bold"/>
                    <TextBlock x:Name="txtSumBillTotal" Text="0.00" VerticalAlignment="Center" Margin="4,0" FontWeight="Bold" Foreground="Blue"/>
                    <TextBlock Text="数量合计:" VerticalAlignment="Center" Margin="16,0,0,0" FontWeight="Bold"/>
                    <TextBlock x:Name="txtSumAmount" Text="0" VerticalAlignment="Center" Margin="4,0" FontWeight="Bold"/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- ========== Mode B: 销售查询模式 ========== -->
        <Grid x:Name="panelQueryMode" Grid.Row="1" Grid.RowSpan="5" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="3*"/>
                <RowDefinition Height="2*"/>
            </Grid.RowDefinitions>

            <!-- Row0: 查询条件 -->
            <Grid Grid.Row="0" Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="日期从:" VerticalAlignment="Center" Margin="2"/>
                <DatePicker Grid.Column="1" x:Name="dtQStart" Margin="2" helpers:DatePickerHelper.EnableSmartEdit="True"/>
                <TextBlock Grid.Column="2" Text="到:" VerticalAlignment="Center" Margin="8,2,2,2"/>
                <DatePicker Grid.Column="3" x:Name="dtQEnd" Margin="2" helpers:DatePickerHelper.EnableSmartEdit="True"/>
                <TextBlock Grid.Column="4" Text="客户:" VerticalAlignment="Center" Margin="8,2,2,2"/>
                <controls:ClientSearchBox Grid.Column="5" x:Name="txtQClient" Margin="2"/>
                <TextBlock Grid.Column="6" Text="业务员:" VerticalAlignment="Center" Margin="8,2,2,2"/>
                <ComboBox Grid.Column="7" x:Name="txtQWorker" IsEditable="True" Margin="2" DisplayMemberPath="Name" SelectedValuePath="Workid"/>
                <Button Grid.Column="8" Content="查询" Width="60" Margin="4,2" Click="BtnSearchBills_Click"/>
                <Button Grid.Column="9" Content="打印" Width="60" HorizontalAlignment="Left" Margin="4,2" Click="BtnPrintBill_Click"/>
                <Button Grid.Column="9" Content="切换开单模式(F3)" HorizontalAlignment="Right" Padding="8,2" Margin="70,2,4,2" Click="BtnSwitchMode_Click"/>
            </Grid>

            <!-- Row1: 单据列表 -->
            <DataGrid Grid.Row="1" x:Name="dgBills" AutoGenerateColumns="False" CanUserAddRows="False"
                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                      SelectionMode="Single" SelectionChanged="DgBills_SelectionChanged" Margin="0,0,0,4"
                      LoadingRow="DgBills_LoadingRow" CellEditEnding="DgBills_CellEditEnding">
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                        <Setter Property="Foreground" Value="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=Foreground}"/>
                    </Style>
                </DataGrid.CellStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="单号" Width="120" Binding="{Binding Sn, Converter={StaticResource SingleLineConverter}}" IsReadOnly="True" ElementStyle="{StaticResource SingleLineCell}"/>
                    <DataGridTextColumn Header="日期" Width="100" Binding="{Binding Datetime, StringFormat=yyyy-MM-dd}" IsReadOnly="True" ElementStyle="{StaticResource SingleLineCell}"/>
                    <DataGridTextColumn Header="客户" Width="100" Binding="{Binding Client, Converter={StaticResource SingleLineConverter}}" IsReadOnly="True" ElementStyle="{StaticResource SingleLineCell}"/>
                    <DataGridTextColumn Header="业务员" Width="80" Binding="{Binding Worker, Converter={StaticResource SingleLineConverter}}" IsReadOnly="True" ElementStyle="{StaticResource SingleLineCell}"/>
                    <DataGridTextColumn Header="总额" Width="90" Binding="{Binding Total, StringFormat=N2}" IsReadOnly="True" ElementStyle="{StaticResource SingleLineCell}"/>
                    <DataGridTextColumn Header="开票总额" Width="90" Binding="{Binding BillTotal, StringFormat=N2}" IsReadOnly="True" ElementStyle="{StaticResource SingleLineCell}"/>
                    <DataGridTextColumn Header="状态" Width="70" Binding="{Binding FlagText, Converter={StaticResource SingleLineConverter}}" IsReadOnly="True" ElementStyle="{StaticResource SingleLineCell}"/>
                    <DataGridTextColumn Header="备注" Width="*" Binding="{Binding Memo, Converter={StaticResource SingleLineConverter}}" ElementStyle="{StaticResource SingleLineCell}"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Row2: 单头信息 + 明细 -->
            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,4" Background="#FFF0F0F0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="60"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="单号:" VerticalAlignment="Center" Margin="4,2"/>
                    <TextBox Grid.Column="1" x:Name="txtQBillNo" IsReadOnly="True" Background="LightGray" Margin="2"/>
                    <TextBlock Grid.Column="2" Text="日期:" VerticalAlignment="Center" Margin="8,2,2,2"/>
                    <TextBox Grid.Column="3" x:Name="txtQDate" IsReadOnly="True" Background="LightGray" Margin="2"/>
                    <TextBlock Grid.Column="4" Text="客户:" VerticalAlignment="Center" Margin="8,2,2,2"/>
                    <TextBox Grid.Column="5" x:Name="txtQClientName" IsReadOnly="True" Background="LightGray" Margin="2"/>
                    <TextBlock Grid.Column="6" Text="业务员:" VerticalAlignment="Center" Margin="8,2,2,2"/>
                    <TextBox Grid.Column="7" x:Name="txtQWorkerName" IsReadOnly="True" Background="LightGray" Margin="2"/>
                    <TextBlock Grid.Column="8" Text="状态:" VerticalAlignment="Center" Margin="8,2,2,2"/>
                    <TextBox Grid.Column="9" x:Name="txtQStatus" IsReadOnly="True" Background="LightGray" Margin="2"/>
                </Grid>

                <DataGrid Grid.Row="1" x:Name="dgQueryDetails" AutoGenerateColumns="False" IsReadOnly="True"
                          VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="编号" Width="90" Binding="{Binding Partno, Converter={StaticResource SingleLineConverter}}" ElementStyle="{StaticResource SingleLineCell}"/>
                        <DataGridTextColumn Header="名称" Width="140" Binding="{Binding Name, Converter={StaticResource SingleLineConverter}}" ElementStyle="{StaticResource SingleLineCell}"/>
                        <DataGridTextColumn Header="数量" Width="55" Binding="{Binding Amount}" ElementStyle="{StaticResource SingleLineCell}"/>
                        <DataGridTextColumn Header="单价" Width="70" Binding="{Binding Price, StringFormat=N2}" ElementStyle="{StaticResource SingleLineCell}"/>
                        <DataGridTextColumn Header="开票单价" Width="70" Binding="{Binding BillPrice, StringFormat=N2}" ElementStyle="{StaticResource SingleLineCell}"/>
                        <DataGridTextColumn Header="小计" Width="80" Binding="{Binding Stotal, StringFormat=N2}" ElementStyle="{StaticResource SingleLineCell}"/>
                        <DataGridTextColumn Header="车型" Width="70" Binding="{Binding Cartype, Converter={StaticResource SingleLineConverter}}" ElementStyle="{StaticResource SingleLineCell}"/>
                        <DataGridTextColumn Header="车牌" Width="70" Binding="{Binding CarMark, Converter={StaticResource SingleLineConverter}}" ElementStyle="{StaticResource SingleLineCell}"/>
                        <DataGridTextColumn Header="备注" Width="*" Binding="{Binding Memo, Converter={StaticResource SingleLineConverter}}" ElementStyle="{StaticResource SingleLineCell}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
