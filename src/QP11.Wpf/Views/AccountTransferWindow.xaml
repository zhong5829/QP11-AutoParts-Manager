<Window x:Class="QP11.Wpf.Views.AccountTransferWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="账户转账" Height="300" Width="450"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,5">
            <TextBlock Text="转出账户:" Width="80" VerticalAlignment="Center"/>
            <ComboBox x:Name="cboFrom" Width="250" DisplayMemberPath="Name"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,5">
            <TextBlock Text="转入账户:" Width="80" VerticalAlignment="Center"/>
            <ComboBox x:Name="cboTo" Width="250" DisplayMemberPath="Name"/>
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,5">
            <TextBlock Text="转账金额:" Width="80" VerticalAlignment="Center"/>
            <TextBox x:Name="txtAmount" Width="250" Text="0"/>
        </StackPanel>
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,5">
            <TextBlock Text="备注:" Width="80" VerticalAlignment="Center"/>
            <TextBox x:Name="txtMemo" Width="250"/>
        </StackPanel>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
            <Button Content="确认转账" Width="80" Height="28" Click="BtnTransfer_Click" IsDefault="True"/>
            <Button Content="取消" Width="80" Height="28" Margin="10,0" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
