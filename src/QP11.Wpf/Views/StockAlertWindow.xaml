<Window x:Class="QP11.Wpf.Views.StockAlertWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="库存预警" Height="500" Width="900"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style x:Key="LowStockTextStyle" TargetType="TextBlock">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsLowStock}" Value="True">
                    <Setter Property="Foreground" Value="Red"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,5">
            <TextBlock Text="编码:" VerticalAlignment="Center"/>
            <TextBox x:Name="txtPartNo" Width="100" Margin="5,0,10,0"/>
            <TextBlock Text="名称:" VerticalAlignment="Center"/>
            <TextBox x:Name="txtName" Width="120" Margin="5,0,10,0"/>
            <TextBlock Text="车型:" VerticalAlignment="Center"/>
            <TextBox x:Name="txtCartype" Width="100" Margin="5,0,10,0"/>
            <Button Content="查询" Width="60" Click="BtnSearch_Click"/>
        </StackPanel>

        <DataGrid Grid.Row="1" x:Name="dgAlert" AutoGenerateColumns="False" IsReadOnly="False" CanUserAddRows="False" CellEditEnding="DgAlert_CellEditEnding" PreviewKeyDown="DgAlert_PreviewKeyDown" ContextMenuOpening="DgAlert_ContextMenuOpening">
            <DataGrid.Columns>
                <DataGridTextColumn Header="件号" Width="100" Binding="{Binding Partno}" IsReadOnly="True" ElementStyle="{StaticResource LowStockTextStyle}"/>
                <DataGridTextColumn Header="名称" Width="180" Binding="{Binding Name}" IsReadOnly="True" ElementStyle="{StaticResource LowStockTextStyle}"/>
                <DataGridTextColumn Header="适用车型" Width="120" Binding="{Binding Cartype}" IsReadOnly="True" ElementStyle="{StaticResource LowStockTextStyle}"/>
                <DataGridTextColumn Header="仓位" Width="80" Binding="{Binding Place}" IsReadOnly="True" ElementStyle="{StaticResource LowStockTextStyle}"/>
                <DataGridTextColumn Header="单位" Width="60" Binding="{Binding Unit}" IsReadOnly="True" ElementStyle="{StaticResource LowStockTextStyle}"/>
                <DataGridTextColumn Header="库存数量" Width="80" Binding="{Binding Amount}" IsReadOnly="True" ElementStyle="{StaticResource LowStockTextStyle}"/>
                <DataGridTextColumn Header="预警值" Width="80" Binding="{Binding Warning}" ElementStyle="{StaticResource LowStockTextStyle}"/>
                <DataGridTextColumn Header="零售价" Width="100" Binding="{Binding Lsprice, StringFormat=c2}" IsReadOnly="True" ElementStyle="{StaticResource LowStockTextStyle}"/>
                <DataGridTextColumn Header="分类" Width="*" Binding="{Binding ClassName}" IsReadOnly="True" ElementStyle="{StaticResource LowStockTextStyle}"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="2" x:Name="txtCount" Text="共 0 条预警记录" Foreground="Red" Margin="0,5,0,0"/>
    </Grid>
</Window>
