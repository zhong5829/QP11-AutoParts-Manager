<Window x:Class="QP11.Wpf.Views.SellEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:QP11.Wpf.Controls"
        Title="销售编辑" Height="550" Width="900"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <GroupBox Grid.Row="0" Header="查询销售单" Margin="0,0,0,5">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="单号:" VerticalAlignment="Center"/>
                <TextBox x:Name="txtSn" Width="200" Margin="5,0"/>
                <Button Content="加载" Width="60" Click="BtnLoad_Click"/>
                <TextBlock x:Name="txtStatus" Text="" Margin="10,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </GroupBox>

        <GroupBox Grid.Row="1" Header="基本信息" Margin="0,0,0,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="单号:" VerticalAlignment="Center" Margin="5"/>
                <TextBox Grid.Column="1" x:Name="txtBillNo" IsReadOnly="True" Background="LightGray" Margin="2"/>
                <TextBlock Grid.Column="2" Text="日期:" VerticalAlignment="Center" Margin="10,5,5,5"/>
                <DatePicker Grid.Column="3" x:Name="dtBillDate" Margin="2"/>

                <TextBlock Grid.Row="1" Text="客户:" VerticalAlignment="Center" Margin="5"/>
                <controls:ClientSearchBox Grid.Row="1" Grid.Column="1" x:Name="cboClient" Margin="2"/>
                <TextBlock Grid.Row="1" Grid.Column="2" Text="业务员:" VerticalAlignment="Center" Margin="10,5,5,5"/>
                <ComboBox Grid.Row="1" Grid.Column="3" x:Name="cboWorker" IsEditable="True" Margin="2"/>

                <TextBlock Grid.Row="2" Text="支票号:" VerticalAlignment="Center" Margin="5"/>
                <TextBox Grid.Row="2" Grid.Column="1" x:Name="txtCheckno" Margin="2"/>
                <TextBlock Grid.Row="2" Grid.Column="2" Text="折扣率:" VerticalAlignment="Center" Margin="10,5,5,5"/>
                <TextBox Grid.Row="2" Grid.Column="3" x:Name="txtDiscountRate" Text="1" Margin="2"/>

                <TextBlock Grid.Row="3" Text="总额:" VerticalAlignment="Center" Margin="5"/>
                <TextBox Grid.Row="3" Grid.Column="1" x:Name="txtTotal" IsReadOnly="True" Background="LightGray" Margin="2"/>
                <TextBlock Grid.Row="3" Grid.Column="2" Text="开票总额:" VerticalAlignment="Center" Margin="10,5,5,5"/>
                <TextBox Grid.Row="3" Grid.Column="3" x:Name="txtBillTotal" IsReadOnly="True" Background="LightGray" Margin="2"/>

                <TextBlock Grid.Row="4" Text="现金:" VerticalAlignment="Center" Margin="5"/>
                <TextBox Grid.Row="4" Grid.Column="1" x:Name="txtCash" Text="0" Margin="2"/>
                <TextBlock Grid.Row="4" Grid.Column="2" Text="支票:" VerticalAlignment="Center" Margin="10,5,5,5"/>
                <TextBox Grid.Row="4" Grid.Column="3" x:Name="txtChecks" Text="0" Margin="2"/>

                <TextBlock Grid.Row="5" Text="欠款:" VerticalAlignment="Center" Margin="5"/>
                <TextBox Grid.Row="5" Grid.Column="1" x:Name="txtArrear" Text="0" Margin="2"/>
                <TextBlock Grid.Row="5" Grid.Column="2" Text="支付宝:" VerticalAlignment="Center" Margin="10,5,5,5"/>
                <TextBox Grid.Row="5" Grid.Column="3" x:Name="txtZhifubao" Text="0" Margin="2"/>

                <TextBlock Grid.Row="6" Text="微信:" VerticalAlignment="Center" Margin="5"/>
                <TextBox Grid.Row="6" Grid.Column="1" x:Name="txtWeixin" Text="0" Margin="2"/>
                <TextBlock Grid.Row="6" Grid.Column="2" Text="备注:" VerticalAlignment="Center" Margin="10,5,5,5"/>
                <TextBox Grid.Row="6" Grid.Column="3" x:Name="txtMemo" Margin="2"/>
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="2" Header="销售明细">
            <DataGrid x:Name="dgDetails" AutoGenerateColumns="False" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="配件ID" Width="80" Binding="{Binding Partid}"/>
                    <DataGridTextColumn Header="配件编号" Width="100" Binding="{Binding Partno}"/>
                    <DataGridTextColumn Header="配件名称" Width="120" Binding="{Binding Name}"/>
                    <DataGridTextColumn Header="数量" Width="60" Binding="{Binding Amount}"/>
                    <DataGridTextColumn Header="单价" Width="80" Binding="{Binding Price, StringFormat=N2}"/>
                    <DataGridTextColumn Header="开票单价" Width="80" Binding="{Binding BillPrice, StringFormat=N2}"/>
                    <DataGridTextColumn Header="小计" Width="90" Binding="{Binding Stotal, StringFormat=N2}"/>
                    <DataGridTextColumn Header="备注" Width="*" Binding="{Binding Memo}"/>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="5">
            <Button Content="保存修改" Width="100" Height="32" Margin="5" Click="BtnSave_Click"/>
            <Button Content="审核确认" Width="100" Height="32" Margin="5" Click="BtnConfirm_Click"/>
            <Button Content="作废" Width="80" Height="32" Margin="5" Click="BtnVoid_Click"/>
            <Button Content="关闭" Width="80" Height="32" Margin="5" Click="BtnClose_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
