<UserControl x:Class="QP11.Wpf.Views.BorrowControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:QP11.Wpf.Helpers"
             xmlns:controls="clr-namespace:QP11.Wpf.Controls">
    <UserControl.Resources>
        <helpers:SingleLineConverter x:Key="SingleLineConverter"/>
        <Style x:Key="SingleLineCell" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
        </Style>
    </UserControl.Resources>
    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Row0: 顶部工具栏 -->
        <Grid Grid.Row="0" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <RadioButton x:Name="rbBorrow" Content="在借" GroupName="BorrowMode" IsChecked="True"
                         VerticalAlignment="Center" Margin="4,2" Checked="RadioButton_Checked"/>
            <RadioButton x:Name="rbReturn" Content="已还" GroupName="BorrowMode"
                         Grid.Column="1" VerticalAlignment="Center" Margin="4,2" Checked="RadioButton_Checked"/>
            <Button Grid.Column="2" Content="添加" Width="60" Margin="8,2" Click="BtnAdd_Click"/>
            <Button Grid.Column="3" Content="归还" Width="60" Margin="8,2" Click="BtnReturn_Click"/>
        </Grid>

        <!-- Row1: 左右布局 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧: 单头 + 明细 -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 单头信息 -->
                <GroupBox Grid.Row="0" Header="单头信息" Margin="0,0,0,4" Padding="4">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="130"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="供应商:" VerticalAlignment="Center" Margin="2"/>
                        <controls:SupplierSearchBox Grid.Column="1" x:Name="cboSupplier" Margin="2"/>
                        <TextBlock Grid.Column="2" Text="单号:" VerticalAlignment="Center" Margin="8,2,2,2"/>
                        <TextBox Grid.Column="3" x:Name="txtBillNo" IsReadOnly="True" Background="LightGray" Margin="2"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="日期:" VerticalAlignment="Center" Margin="2"/>
                        <DatePicker Grid.Row="1" Grid.Column="1" x:Name="dtBillDate" Margin="2"/>
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="采购员:" VerticalAlignment="Center" Margin="8,2,2,2"/>
                        <ComboBox Grid.Row="1" Grid.Column="3" x:Name="cboWorker" IsEditable="True" Margin="2"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="备注:" VerticalAlignment="Center" Margin="2"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" x:Name="txtMemo" Margin="2"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="总额:" VerticalAlignment="Center" Margin="2" FontWeight="Bold"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" x:Name="txtTotal" Text="0.00" VerticalAlignment="Center" Margin="2" FontWeight="Bold" Foreground="Red"/>
                    </Grid>
                </GroupBox>

                <!-- 明细 DataGrid -->
                <DataGrid Grid.Row="1" x:Name="dgDetails" AutoGenerateColumns="False" CanUserAddRows="False"
                          VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                          Margin="0,0,0,0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="编号" Width="80" Binding="{Binding PartNo, Converter={StaticResource SingleLineConverter}}" ElementStyle="{StaticResource SingleLineCell}"/>
                        <DataGridTextColumn Header="名称" Width="120" Binding="{Binding PartName, Converter={StaticResource SingleLineConverter}}" ElementStyle="{StaticResource SingleLineCell}" IsReadOnly="True"/>
                        <DataGridTextColumn Header="数量" Width="55" Binding="{Binding Amount}" ElementStyle="{StaticResource SingleLineCell}"/>
                        <DataGridTextColumn Header="进价" Width="70" Binding="{Binding Inprice, StringFormat=N2}" ElementStyle="{StaticResource SingleLineCell}"/>
                        <DataGridTextColumn Header="小计" Width="70" Binding="{Binding SubTotal, StringFormat=N2}" IsReadOnly="True" ElementStyle="{StaticResource SingleLineCell}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="LightGray"/>

            <!-- 右侧: 单据列表 -->
            <DataGrid Grid.Column="2" x:Name="dgBills" AutoGenerateColumns="False" IsReadOnly="True"
                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                      SelectionMode="Single" SelectionChanged="DgBills_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="单号" Width="120" Binding="{Binding Sn, Converter={StaticResource SingleLineConverter}}" ElementStyle="{StaticResource SingleLineCell}"/>
                    <DataGridTextColumn Header="日期" Width="90" Binding="{Binding Datetime, StringFormat=yyyy-MM-dd}" ElementStyle="{StaticResource SingleLineCell}"/>
                    <DataGridTextColumn Header="供应商" Width="80" Binding="{Binding Supplier, Converter={StaticResource SingleLineConverter}}" ElementStyle="{StaticResource SingleLineCell}"/>
                    <DataGridTextColumn Header="采购员" Width="70" Binding="{Binding Worker, Converter={StaticResource SingleLineConverter}}" ElementStyle="{StaticResource SingleLineCell}"/>
                    <DataGridTextColumn Header="总额" Width="70" Binding="{Binding Total, StringFormat=N2}" ElementStyle="{StaticResource SingleLineCell}"/>
                    <DataGridTextColumn Header="状态" Width="55" Binding="{Binding FlagText, Converter={StaticResource SingleLineConverter}}" ElementStyle="{StaticResource SingleLineCell}"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</UserControl>
