<Window x:Class="QP11.Wpf.Views.SupplierManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="供应商管理" Height="550" Width="850"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 搜索及操作栏 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,5">
            <TextBlock Text="名称:" VerticalAlignment="Center" Margin="0,0,3,0"/>
            <TextBox x:Name="txtName" Width="120" TextChanged="TxtSearch_TextChanged"/>
            <TextBlock Text="地址:" VerticalAlignment="Center" Margin="10,0,3,0"/>
            <TextBox x:Name="txtAddress" Width="150" TextChanged="TxtSearch_TextChanged"/>
            <TextBlock Text="电话:" VerticalAlignment="Center" Margin="10,0,3,0"/>
            <TextBox x:Name="txtTel" Width="120" TextChanged="TxtSearch_TextChanged"/>
            <Button Content="查询" Width="60" Margin="5,0" Click="BtnSearch_Click"/>
            <Separator Width="20"/>
            <Button Content="新增" Width="60" Click="BtnAdd_Click"/>
            <Button Content="编辑" Width="60" Click="BtnEdit_Click"/>
            <Button Content="删除" Width="60" Click="BtnDelete_Click"/>
        </StackPanel>

        <!-- 供应商列表 -->
        <DataGrid Grid.Row="1" x:Name="dgSuppliers" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single" MouseDoubleClick="DgSuppliers_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="编号" Width="80" Binding="{Binding Sid}"/>
                <DataGridTextColumn Header="名称" Width="180" Binding="{Binding Name}"/>
                <DataGridTextColumn Header="电话" Width="120" Binding="{Binding Tel}"/>
                <DataGridTextColumn Header="地址" Width="*" Binding="{Binding Address}"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 状态栏 -->
        <TextBlock Grid.Row="2" x:Name="txtCount" Text="共 0 条记录" Margin="0,5,0,0"/>
    </Grid>
</Window>
