<UserControl x:Class="QP11.Wpf.Views.BuyReturnWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:QP11.Wpf.Controls"
             Margin="8">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Row0: 供应商选择 + 退货单头信息 -->
        <GroupBox Grid.Row="0" Header="退货信息" Margin="0,0,0,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="供应商:" VerticalAlignment="Center" Margin="4,2"/>
                <controls:SupplierSearchBox Grid.Column="1" x:Name="cboSupplier" Margin="2"/>

                <TextBlock Grid.Column="2" Text="退货单号:" VerticalAlignment="Center" Margin="10,2,2,2"/>
                <TextBox Grid.Column="3" x:Name="txtReturnSn" IsReadOnly="True" Background="LightGray" Margin="2" VerticalAlignment="Center"/>

                <TextBlock Grid.Column="4" Text="日期:" VerticalAlignment="Center" Margin="10,2,2,2"/>
                <DatePicker Grid.Column="5" x:Name="dtReturnDate" Margin="2" VerticalAlignment="Center"/>

                <Button Grid.Column="6" Content="查询" Width="60" Margin="10,2,2,2" Click="BtnQuery_Click" VerticalAlignment="Center"/>
            </Grid>
        </GroupBox>

        <!-- Row1: 提示信息 -->
        <TextBlock Grid.Row="1" Text="提示：选择供应商后点击查询，双击进货单据展开明细进行退货操作"
                   Foreground="Gray" FontSize="11" Margin="4,0,0,2"/>

        <!-- Row2: 左右分栏 - 进货单列表 | 退货明细 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧：进货单据列表 -->
            <DataGrid Grid.Column="0" x:Name="dgBills" AutoGenerateColumns="False" IsReadOnly="True"
                      SelectionMode="Single" MouseDoubleClick="DgBills_MouseDoubleClick"
                      GridLinesVisibility="All" HorizontalGridLinesBrush="#E0E0E0" VerticalGridLinesBrush="#E0E0E0"
                      RowHeight="28">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="单号" Width="120" Binding="{Binding Sn}"/>
                    <DataGridTextColumn Header="日期" Width="90" Binding="{Binding Datetime, StringFormat=yyyy-MM-dd}"/>
                    <DataGridTextColumn Header="总额" Width="80" Binding="{Binding Total, StringFormat=N2}"/>
                    <DataGridTextColumn Header="状态" Width="60" Binding="{Binding FlagText}"/>
                </DataGrid.Columns>
            </DataGrid>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="LightGray"/>

            <!-- 右侧：退货明细 -->
            <DockPanel Grid.Column="2" Margin="4,0,0,0">
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBlock Text="退货合计:" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBox x:Name="txtTotalAmount" IsReadOnly="True" FontSize="14" Foreground="Red"
                             FontWeight="Bold" HorizontalContentAlignment="Right" Margin="6,0,0,0" Width="100"/>
                    <TextBlock Text="退货数量:" FontWeight="Bold" VerticalAlignment="Center" Margin="16,0,0,0"/>
                    <TextBox x:Name="txtTotalQty" IsReadOnly="True" FontSize="12" Foreground="Red"
                             FontWeight="Bold" HorizontalContentAlignment="Right" Margin="6,0,0,0" Width="60"/>
                </StackPanel>

                <GroupBox Header="退货明细（双击上方单据加载）" DockPanel.Dock="Top">
                    <DataGrid x:Name="dgDetails" AutoGenerateColumns="False" CanUserAddRows="False"
                              GridLinesVisibility="All" HorizontalGridLinesBrush="#E0E0E0" VerticalGridLinesBrush="#E0E0E0"
                              RowHeight="28" CellEditEnding="DgDetails_CellEditEnding">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="退" Width="35" Binding="{Binding IsReturn}"/>
                            <DataGridTextColumn Header="编码" Width="80" Binding="{Binding PartNo}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="名称" Width="120" Binding="{Binding PartName}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="车型" Width="90" Binding="{Binding Cartype}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="库存" Width="55" Binding="{Binding StockAmount}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="原数量" Width="60" Binding="{Binding OrigAmount}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="已退" Width="55" Binding="{Binding ReturnedAmount}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="可退" Width="55" Binding="{Binding RemainAmount}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="退货数量" Width="65" Binding="{Binding ReturnAmount}"/>
                            <DataGridTextColumn Header="进价" Width="65" Binding="{Binding InPrice, StringFormat=N2}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="退货金额" Width="85" Binding="{Binding ReturnTotal, StringFormat=N2}" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </GroupBox>
            </DockPanel>
        </Grid>

        <!-- Row3: 操作按钮 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="6">
            <Button Content="确认退货(F8)" Width="110" Height="32" Margin="5" Click="BtnConfirmReturn_Click"/>
            <Button Content="清空明细(F9)" Width="110" Height="32" Margin="5" Click="BtnClear_Click"/>
        </StackPanel>
    </Grid>
</UserControl>
