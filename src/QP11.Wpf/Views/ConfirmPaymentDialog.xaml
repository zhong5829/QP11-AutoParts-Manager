<Window x:Class="QP11.Wpf.Views.ConfirmPaymentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="确认到账" SizeToContent="Height" Width="360"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False">
    <StackPanel Margin="20">
        <TextBlock x:Name="txtInfo" Text="" FontSize="14" Margin="0,0,0,12"/>

        <TextBlock Text="付款方式:" VerticalAlignment="Center" Margin="0,4"/>
        <StackPanel Orientation="Horizontal" Margin="0,4,0,8">
            <RadioButton x:Name="rbCash" Content="现金" GroupName="PayMethod" IsChecked="True" Margin="0,0,16,0"/>
            <RadioButton x:Name="rbWeixin" Content="微信" GroupName="PayMethod" Margin="0,0,16,0"/>
            <RadioButton x:Name="rbZhifubao" Content="支付宝" GroupName="PayMethod"/>
        </StackPanel>

        <DockPanel Margin="0,4,0,8">
            <TextBlock Text="收款金额:" VerticalAlignment="Center" DockPanel.Dock="Left"/>
            <TextBox x:Name="txtAmount" FontSize="16" FontWeight="Bold"
                     HorizontalAlignment="Left" Width="180" TextAlignment="Right" Margin="8,0,0,0"/>
        </DockPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="确定" Width="70" IsDefault="True" Click="BtnOk_Click" Margin="0,0,8,0"/>
            <Button Content="取消" Width="70" IsCancel="True" Click="BtnCancel_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
