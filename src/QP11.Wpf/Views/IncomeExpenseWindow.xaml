<Window x:Class="QP11.Wpf.Views.IncomeExpenseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="收支明细" Height="500" Width="850"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 筛选条件栏 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,5">
            <TextBlock Text="账户:" VerticalAlignment="Center"/>
            <ComboBox x:Name="cboAccount" Width="150" Margin="5,0" SelectionChanged="CboAccount_SelectionChanged"/>
            <TextBlock Text="起始日期:" VerticalAlignment="Center" Margin="10,0,0,0"/>
            <DatePicker x:Name="dtStart" Width="130" Margin="5,0"/>
            <TextBlock Text="截止日期:" VerticalAlignment="Center" Margin="10,0,0,0"/>
            <DatePicker x:Name="dtEnd" Width="130" Margin="5,0"/>
            <Button Content="查询" Width="60" Click="BtnSearch_Click"/>
        </StackPanel>

        <!-- 收支明细列表 -->
        <DataGrid Grid.Row="1" x:Name="dgPays" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="日期" Width="120" Binding="{Binding Datetime, StringFormat=yyyy-MM-dd}"/>
                <DataGridTextColumn Header="类型" Width="60" Binding="{Binding Type}"/>
                <DataGridTextColumn Header="金额" Width="100" Binding="{Binding Je, StringFormat=c2}"/>
                <DataGridTextColumn Header="关联单号" Width="140" Binding="{Binding Sn}"/>
                <DataGridTextColumn Header="操作员" Width="80" Binding="{Binding Worker}"/>
                <DataGridTextColumn Header="备注" Width="*" Binding="{Binding Memo}"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 状态栏 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,5,0,0">
            <TextBlock x:Name="txtCount" Text="共 0 条记录"/>
            <TextBlock x:Name="txtTotal" Text="" Foreground="Blue" Margin="20,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>
