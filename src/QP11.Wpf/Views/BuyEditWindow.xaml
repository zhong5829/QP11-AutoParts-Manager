<Window x:Class="QP11.Wpf.Views.BuyEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:QP11.Wpf.Controls"
        Title="明细清单" Height="550" Width="900"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <GroupBox Grid.Row="0" Header="查询采购单" Margin="0,0,0,5">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="采购单号:" VerticalAlignment="Center" Margin="5"/>
                <TextBox x:Name="txtSn" Width="150" Margin="2"/>
                <Button Content="加载" Width="60" Height="26" Margin="5,0" Click="BtnLoad_Click"/>
                <TextBlock x:Name="txtStatus" VerticalAlignment="Center" Margin="10,0"/>
            </StackPanel>
        </GroupBox>

        <GroupBox Grid.Row="1" Header="基本信息" Margin="0,0,0,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="单号:" VerticalAlignment="Center" Margin="5"/>
                <TextBox Grid.Column="1" x:Name="txtBillNo" IsReadOnly="True" Background="LightGray" Margin="2"/>
                <TextBlock Grid.Column="2" Text="日期:" VerticalAlignment="Center" Margin="10,5,5,5"/>
                <TextBox Grid.Column="3" x:Name="txtBillDate" IsReadOnly="True" Background="LightGray" Margin="2"/>

                <TextBlock Grid.Row="1" Text="供应商:" VerticalAlignment="Center" Margin="5"/>
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="txtSupplierName" IsReadOnly="True" Background="LightGray" Margin="2"/>
                <TextBlock Grid.Row="1" Grid.Column="2" Text="采购员:" VerticalAlignment="Center" Margin="10,5,5,5"/>
                <TextBox Grid.Row="1" Grid.Column="3" x:Name="txtWorkerName" IsReadOnly="True" Background="LightGray" Margin="2"/>

                <TextBlock Grid.Row="2" Text="发票号:" VerticalAlignment="Center" Margin="5"/>
                <TextBox Grid.Row="2" Grid.Column="1" x:Name="txtInvoice" IsReadOnly="True" Background="LightGray" Margin="2"/>
                <TextBlock Grid.Row="2" Grid.Column="2" Text="总额:" VerticalAlignment="Center" Margin="10,5,5,5"/>
                <TextBox Grid.Row="2" Grid.Column="3" x:Name="txtTotal" IsReadOnly="True" Background="LightGray" Margin="2"/>

                <TextBlock Grid.Row="3" Text="支付宝:" VerticalAlignment="Center" Margin="5"/>
                <TextBox Grid.Row="3" Grid.Column="1" x:Name="txtZhifubao" IsReadOnly="True" Background="LightGray" Margin="2"/>
                <TextBlock Grid.Row="3" Grid.Column="2" Text="微信:" VerticalAlignment="Center" Margin="10,5,5,5"/>
                <TextBox Grid.Row="3" Grid.Column="3" x:Name="txtWeixin" IsReadOnly="True" Background="LightGray" Margin="2"/>

                <TextBlock Grid.Row="4" Text="运费:" VerticalAlignment="Center" Margin="5"/>
                <TextBox Grid.Row="4" Grid.Column="1" x:Name="txtYunfei" IsReadOnly="True" Background="LightGray" Margin="2"/>
                <TextBlock Grid.Row="4" Grid.Column="2" Text="欠款:" VerticalAlignment="Center" Margin="10,5,5,5"/>
                <TextBox Grid.Row="4" Grid.Column="3" x:Name="txtArrear" IsReadOnly="True" Background="LightGray" Margin="2"/>

                <TextBlock Grid.Row="5" Text="备注:" VerticalAlignment="Center" Margin="5"/>
                <TextBox Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="3" x:Name="txtMemo" IsReadOnly="True" Background="LightGray" Margin="2"/>
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="2" Header="采购明细">
            <DataGrid x:Name="dgDetails" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="配件编号" Width="100" Binding="{Binding Partno}"/>
                    <DataGridTextColumn Header="配件名称" Width="120" Binding="{Binding Name}"/>
                    <DataGridTextColumn Header="车型" Width="80" Binding="{Binding Cartype}"/>
                    <DataGridTextColumn Header="单位" Width="50" Binding="{Binding Unit}"/>
                    <DataGridTextColumn Header="数量" Width="60" Binding="{Binding Amount}"/>
                    <DataGridTextColumn Header="进价" Width="80" Binding="{Binding Inprice, StringFormat=N2}"/>
                    <DataGridTextColumn Header="小计" Width="90" Binding="{Binding Stotal, StringFormat=N2}"/>
                    <DataGridTextColumn Header="零售价" Width="80" Binding="{Binding Lsprice, StringFormat=N2}"/>
                    <DataGridTextColumn Header="批发价" Width="80" Binding="{Binding Pfprice, StringFormat=N2}"/>
                    <DataGridTextColumn Header="仓位" Width="70" Binding="{Binding Place}"/>
                    <DataGridTextColumn Header="备注" Width="*" Binding="{Binding Memo}"/>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="5">
            <Button Content="打印" Width="80" Height="30" Margin="5" Click="BtnPrint_Click"/>
            <Button Content="退出" Width="80" Height="30" Margin="5" Click="BtnClose_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
