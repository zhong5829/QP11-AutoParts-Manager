<Window x:Class="QP11.Wpf.Views.PriceManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="价格管理" Height="550" Width="950"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 搜索及批量调价工具栏 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,5">
            <TextBlock Text="搜索:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <TextBox x:Name="txtSearch" Width="250" TextChanged="TxtSearch_TextChanged"/>
            <Button Content="查询" Width="60" Margin="5,0" Click="BtnSearch_Click"/>
            <Separator Width="15"/>
            <TextBlock Text="批量调价:" VerticalAlignment="Center"/>
            <ComboBox x:Name="cboPriceType" Width="80" Margin="5,0">
                <ComboBoxItem Content="零售价" IsSelected="True"/>
                <ComboBoxItem Content="批发价"/>
                <ComboBoxItem Content="进货价"/>
            </ComboBox>
            <TextBlock Text="调整:" VerticalAlignment="Center" Margin="5,0"/>
            <ComboBox x:Name="cboAdjustType" Width="60" Margin="2,0">
                <ComboBoxItem Content="乘以" IsSelected="True"/>
                <ComboBoxItem Content="加上"/>
            </ComboBox>
            <TextBox x:Name="txtAdjustValue" Width="60" Text="1.0" Margin="2,0"/>
            <Button Content="执行调价" Width="80" Margin="5,0" Click="BtnBatchAdjust_Click"/>
        </StackPanel>

        <!-- 配件价格列表 -->
        <DataGrid Grid.Row="1" x:Name="dgParts" AutoGenerateColumns="False"
                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
            <DataGrid.Columns>
                <DataGridTextColumn Header="件号" Width="100" Binding="{Binding Partno}" IsReadOnly="True"/>
                <DataGridTextColumn Header="名称" Width="180" Binding="{Binding Name}" IsReadOnly="True"/>
                <DataGridTextColumn Header="适用车型" Width="120" Binding="{Binding Cartype}" IsReadOnly="True"/>
                <DataGridTextColumn Header="进货价" Width="100" Binding="{Binding Inprice, StringFormat=c2}"/>
                <DataGridTextColumn Header="零售价" Width="100" Binding="{Binding Lsprice, StringFormat=c2}"/>
                <DataGridTextColumn Header="批发价" Width="*" Binding="{Binding Pfprice, StringFormat=c2}"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 状态栏 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,5,0,0">
            <TextBlock x:Name="txtCount" Text="共 0 条记录"/>
            <Button Content="保存修改" Width="80" Margin="20,0,0,0" Click="BtnSave_Click"/>
        </StackPanel>
    </Grid>
</Window>
