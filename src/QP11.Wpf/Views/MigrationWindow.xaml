<Window x:Class="QP11.Wpf.Views.MigrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="数据迁移" Height="650" Width="750"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 源数据库连接 -->
        <GroupBox Grid.Row="0" Header="源数据库（第三方软件）" Margin="0,0,0,10">
            <Grid Margin="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="服务器:" VerticalAlignment="Center" Margin="0,3"/>
                    <TextBox Grid.Column="1" x:Name="txtSrcServer" Text="frp-bar.com,47017" Margin="2,1"/>

                    <TextBlock Grid.Row="1" Text="数据库:" VerticalAlignment="Center" Margin="0,3"/>
                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="txtSrcDb" Text="备用数据" Margin="2,1"/>

                    <TextBlock Grid.Row="2" Text="用户名:" VerticalAlignment="Center" Margin="0,3"/>
                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="txtSrcUser" Text="QP1150" Margin="2,1"/>

                    <TextBlock Grid.Row="3" Text="密码:" VerticalAlignment="Center" Margin="0,3"/>
                    <PasswordBox Grid.Row="3" Grid.Column="1" x:Name="txtSrcPwd" Password="Dengpeng0716" Margin="2,1"/>
                </Grid>
                <Button Grid.Column="1" Content="测试源库连接" Width="100" Height="28" Margin="10,0,0,0"
                        Click="BtnTestSource_Click" VerticalAlignment="Center"/>
            </Grid>
        </GroupBox>

        <!-- 目标数据库连接 -->
        <GroupBox Grid.Row="1" Header="目标数据库（新空库）" Margin="0,0,0,10">
            <Grid Margin="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="服务器:" VerticalAlignment="Center" Margin="0,3"/>
                    <TextBox Grid.Column="1" x:Name="txtTgtServer" Text="192.168.1.86,1433" Margin="2,1"/>

                    <TextBlock Grid.Row="1" Text="数据库:" VerticalAlignment="Center" Margin="0,3"/>
                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="txtTgtDb" Text="qipei" Margin="2,1"/>

                    <TextBlock Grid.Row="2" Text="用户名:" VerticalAlignment="Center" Margin="0,3"/>
                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="txtTgtUser" Text="sa" Margin="2,1"/>

                    <TextBlock Grid.Row="3" Text="密码:" VerticalAlignment="Center" Margin="0,3"/>
                    <PasswordBox Grid.Row="3" Grid.Column="1" x:Name="txtTgtPwd" Margin="2,1"/>
                </Grid>
                <Button Grid.Column="1" Content="测试目标库连接" Width="100" Height="28" Margin="10,0,0,0"
                        Click="BtnTestTarget_Click" VerticalAlignment="Center"/>
            </Grid>
        </GroupBox>

        <!-- 操作按钮 -->
        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="txtStatus" Text="就绪" Foreground="Gray" VerticalAlignment="Center" Margin="0,0,15,0"/>
            <ProgressBar Grid.Column="1" x:Name="prgBar" Width="200" Height="20" Minimum="0" Maximum="100"
                         Visibility="Collapsed" Margin="0,0,10,0"/>
            <TextBlock Grid.Column="2" x:Name="txtProgress" Text="" VerticalAlignment="Center"
                       Margin="0,0,10,0" Visibility="Collapsed"/>
            <Button Grid.Column="4" x:Name="btnMigrate" Content="开始迁移" Width="100" Height="35"
                    Click="BtnMigrate_Click" FontSize="14" FontWeight="Bold"/>
        </Grid>

        <!-- 日志输出 -->
        <GroupBox Grid.Row="3" Header="迁移日志" Margin="0,0,0,10">
            <RichTextBox x:Name="rtbLog" IsReadOnly="True" VerticalScrollBarVisibility="Auto"
                         FontFamily="Consolas" FontSize="12" Background="#1E1E1E" Foreground="#DCDCDC">
                <RichTextBox.Resources>
                    <Style TargetType="Paragraph">
                        <Setter Property="Margin" Value="0"/>
                    </Style>
                </RichTextBox.Resources>
            </RichTextBox>
        </GroupBox>

        <!-- 底部按钮 -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="清空日志" Width="80" Height="28" Click="BtnClearLog_Click" Margin="0,0,10,0"/>
            <Button Content="关闭" Width="80" Height="28" Click="BtnClose_Click"/>
        </StackPanel>
    </Grid>
</Window>