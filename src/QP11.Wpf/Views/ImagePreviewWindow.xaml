<Window x:Class="QP11.Wpf.Views.ImagePreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="导出预览" Height="650" Width="950"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ToolBar Grid.Row="0" Margin="0,0,0,4">
            <TextBlock Text="共" VerticalAlignment="Center"/>
            <TextBlock x:Name="txtCount" Text="0" VerticalAlignment="Center" FontWeight="Bold" Margin="2,0"/>
            <TextBlock Text="张图片" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <Separator/>
            <Button x:Name="btnCopyImg1" Content="复制图片1" Width="80" Height="26" Click="BtnCopyImg1_Click" ToolTip="复制第1张图片（销售单据）到剪贴板"/>
            <Button x:Name="btnCopyImg2" Content="复制图片2" Width="80" Height="26" Click="BtnCopyImg2_Click" ToolTip="复制第2张图片（销售明细）到剪贴板"/>
            <Separator/>
            <Button x:Name="btnCopyAll" Content="复制全部图片" Width="100" Height="26" Click="BtnCopyAll_Click" ToolTip="将所有图片复制到剪贴板"/>
            <Separator/>
            <Button Content="关闭" Width="55" Height="24" Click="BtnClose_Click"/>
        </ToolBar>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" MinWidth="150"/>
                <ColumnDefinition Width="3"/>
                <ColumnDefinition Width="*" MinWidth="300"/>
            </Grid.ColumnDefinitions>

            <ListBox x:Name="lstThumbs" Grid.Column="0" SelectionChanged="LstThumbs_SelectionChanged"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#FFC0C0C0" BorderThickness="1" Background="White" Margin="4">
                            <StackPanel>
                                <Image Source="{Binding Image}" Stretch="Uniform" MaxHeight="160" Margin="4"/>
                                <TextBlock Text="{Binding Label}" HorizontalAlignment="Center" FontSize="11" Margin="0,2,0,4"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="#FFE0E0E0"/>

            <ScrollViewer Grid.Column="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <Image x:Name="imgPreview" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </ScrollViewer>
        </Grid>

        <StatusBar Grid.Row="2">
            <StatusBarItem>
                <TextBlock x:Name="txtStatus" Text="就绪"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="txtPageSize" Text=""/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
