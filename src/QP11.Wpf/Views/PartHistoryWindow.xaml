<Window x:Class="QP11.Wpf.Views.PartHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:QP11.Wpf.Converters"
        Title="配件历史" Height="480" Width="720"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Window.Resources>
        <conv:IsNegativeConverter x:Key="IsNegativeConverter"/>
        <Style x:Key="NegativeRowStyle" TargetType="DataGridRow">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Amount, Converter={StaticResource IsNegativeConverter}}" Value="True">
                    <Setter Property="Foreground" Value="Red"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="txtTitle" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>

        <TabControl Grid.Row="1">
            <TabItem Header="进货历史">
                <DataGrid x:Name="dgBuy" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" RowStyle="{StaticResource NegativeRowStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="单号" Width="120" Binding="{Binding Sn}"/>
                        <DataGridTextColumn Header="日期" Width="140" Binding="{Binding Datetime, StringFormat=yyyy-MM-dd HH:mm}"/>
                        <DataGridTextColumn Header="供应商" Width="*" Binding="{Binding SupplierName}"/>
                        <DataGridTextColumn Header="数量" Width="70" Binding="{Binding Amount}"/>
                        <DataGridTextColumn Header="采购价" Width="90" Binding="{Binding Inprice, StringFormat=c2}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="销售历史">
                <DataGrid x:Name="dgSell" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" RowStyle="{StaticResource NegativeRowStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="单号" Width="120" Binding="{Binding Sn}"/>
                        <DataGridTextColumn Header="日期" Width="140" Binding="{Binding Datetime, StringFormat=yyyy-MM-dd HH:mm}"/>
                        <DataGridTextColumn Header="客户" Width="*" Binding="{Binding ClientName}"/>
                        <DataGridTextColumn Header="数量" Width="70" Binding="{Binding Amount}"/>
                        <DataGridTextColumn Header="单价" Width="80" Binding="{Binding Price, StringFormat=c2}"/>
                        <DataGridTextColumn Header="开单总额" Width="90" Binding="{Binding BillPrice, StringFormat=c2}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
