<Window x:Class="QP11.Wpf.Views.SellReturnWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="销售退货" Height="550" Width="900"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 退货基本信息 -->
        <GroupBox Grid.Row="0" Header="退货信息" Margin="0,0,0,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="原单号:" VerticalAlignment="Center" Margin="5"/>
                <TextBox Grid.Column="1" x:Name="txtOrigSn" Margin="2"/>
                <Button Grid.Column="2" Content="查询" Width="50" Margin="5,0" Click="BtnLoadOrig_Click"/>
                <TextBlock Grid.Column="3" Text="退货单号:" VerticalAlignment="Center" Margin="10,5,5,5"/>
                <TextBox Grid.Column="4" x:Name="txtReturnSn" IsReadOnly="True" Background="LightGray" Margin="2"/>
                <TextBlock Grid.Column="5" Text="日期:" VerticalAlignment="Center" Margin="10,5,5,5"/>
                <DatePicker Grid.Column="6" x:Name="dtReturnDate" Margin="2"/>
            </Grid>
        </GroupBox>

        <!-- 退货明细列表 -->
        <GroupBox Grid.Row="1" Header="退货明细">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Width="150" Margin="10,0,0,0">
                    <TextBlock Text="退货合计:" FontWeight="Bold"/>
                    <TextBox x:Name="txtTotalAmount" IsReadOnly="True" FontSize="14" Foreground="Red"
                             HorizontalContentAlignment="Right" Margin="0,5"/>
                </StackPanel>

                <DataGrid x:Name="dgDetails" AutoGenerateColumns="False" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Header="退" Width="30" Binding="{Binding IsReturn}"/>
                        <DataGridTextColumn Header="配件ID" Width="80" Binding="{Binding Partid}" IsReadOnly="True"/>
                        <DataGridTextColumn Header="名称" Width="150" Binding="{Binding PartName}" IsReadOnly="True"/>
                        <DataGridTextColumn Header="原数量" Width="70" Binding="{Binding OrigAmount}" IsReadOnly="True"/>
                        <DataGridTextColumn Header="退货数量" Width="70" Binding="{Binding ReturnAmount}"/>
                        <DataGridTextColumn Header="单价" Width="80" Binding="{Binding Price, StringFormat=c2}" IsReadOnly="True"/>
                        <DataGridTextColumn Header="退货金额" Width="100" Binding="{Binding ReturnTotal, StringFormat=c2}" IsReadOnly="True"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </GroupBox>

        <!-- 操作按钮 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="5">
            <Button Content="确认退货" Width="100" Height="32" Margin="5" Click="BtnConfirmReturn_Click"/>
            <Button Content="退 出" Width="100" Height="32" Margin="5" Click="BtnClose_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
