<Window x:Class="QP11.Wpf.Views.StockCheckWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="库存盘点" Height="550" Width="900"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style x:Key="DiffTextStyle" TargetType="TextBlock">
            <Style.Triggers>
                <DataTrigger Binding="{Binding DiffStock}" Value="0">
                    <Setter Property="Foreground" Value="Black"/>
                </DataTrigger>
            </Style.Triggers>
            <Setter Property="Foreground" Value="Red"/>
        </Style>
    </Window.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,5">
            <Button Content="加载库存数据" Width="100" Click="BtnLoadStock_Click"/>
            <Button Content="导出盘点表" Width="90" Margin="5,0" Click="BtnExport_Click"/>
            <Separator Width="15"/>
            <TextBlock Text="编码:" VerticalAlignment="Center"/>
            <TextBox x:Name="txtPartno" Width="100" Margin="5,0" TextChanged="SearchField_TextChanged"/>
            <TextBlock Text="名称:" VerticalAlignment="Center"/>
            <TextBox x:Name="txtName" Width="120" Margin="5,0" TextChanged="SearchField_TextChanged"/>
            <TextBlock Text="车型:" VerticalAlignment="Center"/>
            <TextBox x:Name="txtCartype" Width="100" Margin="5,0" TextChanged="SearchField_TextChanged"/>
        </StackPanel>

        <DataGrid Grid.Row="1" x:Name="dgStock" AutoGenerateColumns="False" CanUserAddRows="False"
                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
            <DataGrid.Columns>
                <DataGridTextColumn Header="件号" Width="100" Binding="{Binding Partno}" IsReadOnly="True" ElementStyle="{StaticResource DiffTextStyle}"/>
                <DataGridTextColumn Header="名称" Width="180" Binding="{Binding Name}" IsReadOnly="True" ElementStyle="{StaticResource DiffTextStyle}"/>
                <DataGridTextColumn Header="车型" Width="100" Binding="{Binding Cartype}" IsReadOnly="True" ElementStyle="{StaticResource DiffTextStyle}"/>
                <DataGridTextColumn Header="单位" Width="60" Binding="{Binding Unit}" IsReadOnly="True" ElementStyle="{StaticResource DiffTextStyle}"/>
                <DataGridTextColumn Header="系统库存" Width="80" Binding="{Binding SystemStock}" IsReadOnly="True" ElementStyle="{StaticResource DiffTextStyle}"/>
                <DataGridTextColumn Header="实盘数量" Width="80" Binding="{Binding ActualStock}" ElementStyle="{StaticResource DiffTextStyle}"/>
                <DataGridTextColumn Header="差异数量" Width="80" Binding="{Binding DiffStock}" IsReadOnly="True" ElementStyle="{StaticResource DiffTextStyle}"/>
                <DataGridTextColumn Header="单价" Width="80" Binding="{Binding Lsprice, StringFormat=c2}" IsReadOnly="True" ElementStyle="{StaticResource DiffTextStyle}"/>
                <DataGridTextColumn Header="差异金额" Width="100" Binding="{Binding DiffAmount, StringFormat=c2}" IsReadOnly="True" ElementStyle="{StaticResource DiffTextStyle}"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,5,0,0">
            <TextBlock x:Name="txtCount" Text="共 0 条记录"/>
            <TextBlock x:Name="txtDiffSummary" Text="" Foreground="Red" Margin="20,0,0,0" FontWeight="Bold"/>
            <Button Content="保存盘点结果" Width="100" Margin="20,0,0,0" Click="BtnSaveCheck_Click"/>
        </StackPanel>
    </Grid>
</Window>
