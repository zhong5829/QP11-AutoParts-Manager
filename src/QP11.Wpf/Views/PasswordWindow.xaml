<Window x:Class="QP11.Wpf.Views.PasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="修改密码" Height="250" Width="350"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="原密码:" Margin="0,5"/>
        <PasswordBox Grid.Row="0" x:Name="txtOldPwd" Margin="80,5,0,5" HorizontalAlignment="Left" Width="200"/>

        <TextBlock Grid.Row="1" Text="新密码:" Margin="0,5"/>
        <PasswordBox Grid.Row="1" x:Name="txtNewPwd" Margin="80,5,0,5" HorizontalAlignment="Left" Width="200"/>

        <TextBlock Grid.Row="2" Text="确认密码:" Margin="0,5"/>
        <PasswordBox Grid.Row="2" x:Name="txtConfirmPwd" Margin="80,5,0,5" HorizontalAlignment="Left" Width="200"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15">
            <Button Content="确认修改" Width="80" Height="28" Click="BtnChange_Click"/>
            <Button Content="取 消" Width="80" Height="28" Margin="10,0" Click="BtnCancel_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
