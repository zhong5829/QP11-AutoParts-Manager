<Window x:Class="QP11.Wpf.Views.ExcelImportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="采购进货 - 表格导入" Width="900" Height="680"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <GroupBox Grid.Row="0" Header="文件选择" Margin="0,0,0,6" Padding="4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="txtFilePath" IsReadOnly="True" Margin="2" VerticalContentAlignment="Center"/>
                <Button Grid.Column="1" Content="浏览..." Width="80" Margin="4,2" Click="BtnBrowse_Click"/>
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="1" Header="解析设置" Margin="0,0,0,6" Padding="4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="工作表:" VerticalAlignment="Center" Margin="2"/>
                <ComboBox Grid.Column="1" x:Name="cmbSheet" Margin="2" SelectionChanged="CmbSheet_SelectionChanged"/>
                <TextBlock Grid.Column="2" Text="起始行:" VerticalAlignment="Center" Margin="8,2,2,2"/>
                <TextBox Grid.Column="3" x:Name="txtStartRow" Text="2" Margin="2" VerticalContentAlignment="Center" TextChanged="TxtStartRow_TextChanged"/>
                <TextBlock Grid.Column="4" Text="(跳过表头)" VerticalAlignment="Center" Margin="4,2"/>
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="2" Header="列映射" Margin="0,0,0,6" Padding="4">
            <Grid x:Name="mappingGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="配件编号 *" VerticalAlignment="Center" Margin="2" Foreground="Red"/>
                <ComboBox Grid.Column="1" x:Name="mapPartNo" Margin="2" SelectionChanged="Mapping_SelectionChanged"/>

                <TextBlock Grid.Row="1" Text="配件名称" VerticalAlignment="Center" Margin="2"/>
                <ComboBox Grid.Row="1" Grid.Column="1" x:Name="mapPartName" Margin="2" SelectionChanged="Mapping_SelectionChanged"/>

                <TextBlock Grid.Row="2" Text="数量 *" VerticalAlignment="Center" Margin="2" Foreground="Red"/>
                <ComboBox Grid.Row="2" Grid.Column="1" x:Name="mapAmount" Margin="2" SelectionChanged="Mapping_SelectionChanged"/>

                <TextBlock Grid.Row="3" Text="进价 *" VerticalAlignment="Center" Margin="2" Foreground="Red"/>
                <ComboBox Grid.Row="3" Grid.Column="1" x:Name="mapInPrice" Margin="2" SelectionChanged="Mapping_SelectionChanged"/>

                <TextBlock Grid.Row="4" Text="车型" VerticalAlignment="Center" Margin="2"/>
                <ComboBox Grid.Row="4" Grid.Column="1" x:Name="mapCartype" Margin="2" SelectionChanged="Mapping_SelectionChanged"/>

                <TextBlock Grid.Row="5" Text="仓位" VerticalAlignment="Center" Margin="2"/>
                <ComboBox Grid.Row="5" Grid.Column="1" x:Name="mapPlace" Margin="2" SelectionChanged="Mapping_SelectionChanged"/>

                <TextBlock Grid.Row="6" Text="备注" VerticalAlignment="Center" Margin="2"/>
                <ComboBox Grid.Row="6" Grid.Column="1" x:Name="mapMemo" Margin="2" SelectionChanged="Mapping_SelectionChanged"/>
            </Grid>
        </GroupBox>

        <DataGrid Grid.Row="3" x:Name="dgPreview" AutoGenerateColumns="False" IsReadOnly="True"
                  VirtualizingPanel.IsVirtualizing="True" Margin="0,0,0,6"
                  LoadingRow="DgPreview_LoadingRow">
            <DataGrid.Columns>
                <DataGridTextColumn Header="行号" Width="40" Binding="{Binding RowIndex}"/>
                <DataGridTextColumn Header="配件编号" Width="90" Binding="{Binding PartNo}"/>
                <DataGridTextColumn Header="配件名称" Width="100" Binding="{Binding PartName}"/>
                <DataGridTextColumn Header="数量" Width="50" Binding="{Binding Amount}"/>
                <DataGridTextColumn Header="进价" Width="60" Binding="{Binding InPrice, StringFormat=N2}"/>
                <DataGridTextColumn Header="车型" Width="70" Binding="{Binding Cartype}"/>
                <DataGridTextColumn Header="仓位" Width="60" Binding="{Binding Place}"/>
                <DataGridTextColumn Header="备注" Width="80" Binding="{Binding Memo}"/>
                <DataGridTextColumn Header="状态" Width="*" Binding="{Binding StatusText}"/>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="4" Margin="0,0,0,6">
            <TextBlock x:Name="txtStats" Text="请选择文件开始导入" VerticalAlignment="Center"/>
        </Grid>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <CheckBox x:Name="chkMerge" Content="自动合并同编号配件" IsChecked="True" VerticalAlignment="Center" Margin="0,0,20,0"/>
            <CheckBox x:Name="chkUpdateName" Content="更新配件名称" IsChecked="True" VerticalAlignment="Center" Margin="0,0,20,0"
                      ToolTip="编号相同但名称不同时，勾选则用表格名称更新数据库，不勾选则保持数据库原有名称"/>
            <Button Content="确认导入" Width="90" Margin="4,0" Click="BtnImport_Click" IsEnabled="False" x:Name="btnImport"/>
            <Button Content="取消" Width="70" Margin="4,0" Click="BtnCancel_Click"/>
        </StackPanel>

        <Grid x:Name="loadingOverlay" Grid.RowSpan="6" Background="#80000000" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Ellipse Width="40" Height="40" Stroke="#4CAF50" StrokeThickness="4" Margin="0,0,0,12"
                         RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <RotateTransform x:Name="loadingRotation" Angle="0"/>
                    </Ellipse.RenderTransform>
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Style.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetProperty="(Ellipse.RenderTransform).(RotateTransform.Angle)"
                                                             From="0" To="360" Duration="0:0:1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <TextBlock x:Name="txtLoading" Text="正在解析文件..." Foreground="White" FontSize="16" FontWeight="Bold"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
