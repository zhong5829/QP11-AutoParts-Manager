<Window x:Class="QP11.Wpf.Views.SellReturnEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="退货编辑" Width="400" Height="380"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Text="编码:" VerticalAlignment="Center" Margin="2"/>
        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="txtPartNo" VerticalAlignment="Center" Margin="2" FontWeight="Bold"/>

        <TextBlock Grid.Row="1" Text="名称:" VerticalAlignment="Center" Margin="2"/>
        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="txtPartName" VerticalAlignment="Center" Margin="2" FontWeight="Bold"/>

        <TextBlock Grid.Row="2" Text="车型:" VerticalAlignment="Center" Margin="2"/>
        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="txtCartype" VerticalAlignment="Center" Margin="2"/>

        <TextBlock Grid.Row="3" Text="原售单价:" VerticalAlignment="Center" Margin="2"/>
        <TextBlock Grid.Row="3" Grid.Column="1" x:Name="txtOrigPrice" VerticalAlignment="Center" Margin="2" Foreground="DarkOrange"/>

        <TextBlock Grid.Row="4" Text="已购数量:" VerticalAlignment="Center" Margin="2"/>
        <TextBlock Grid.Row="4" Grid.Column="1" x:Name="txtOrigAmount" VerticalAlignment="Center" Margin="2" Foreground="Blue"/>

        <TextBlock Grid.Row="5" Text="退货数量:" VerticalAlignment="Center" Margin="2"/>
        <TextBox Grid.Row="5" Grid.Column="1" x:Name="txtAmount" Text="1" Margin="2"/>

        <TextBlock Grid.Row="6" Text="退货单价:" VerticalAlignment="Center" Margin="2"/>
        <TextBox Grid.Row="6" Grid.Column="1" x:Name="txtPrice" Margin="2"/>

        <CheckBox Grid.Row="7" Grid.ColumnSpan="2" x:Name="chkWaste" Content="退回废品仓" Margin="2,8,2,2" FontWeight="Bold" Foreground="Red"/>

        <StackPanel Grid.Row="9" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
            <Button Content="确定(_O)" Width="80" Height="28" Margin="4,0" IsDefault="True" Click="BtnOk_Click"/>
            <Button Content="取消(_C)" Width="80" Height="28" Margin="4,0" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
