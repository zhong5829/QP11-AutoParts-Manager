<Window x:Class="QP11.Wpf.Views.SellEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="销售编辑" Width="950" Height="600"
        WindowStartupLocation="CenterOwner"
        MinWidth="800" MinHeight="500"
        ShowInTaskbar="False">
    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <GroupBox Grid.Column="0" Header="销售信息" Margin="0,0,4,0">
            <StackPanel>
                <TextBlock Text="客户查询" Margin="0,0,0,2"/>
                <TextBox x:Name="txtClient" Margin="0,0,0,6" VerticalContentAlignment="Center"/>

                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="配件编号: " VerticalAlignment="Center"/>
                    <TextBlock x:Name="txtPartNo" Grid.Column="1" VerticalAlignment="Center" FontWeight="Bold"/>
                </Grid>
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="配件名称: " VerticalAlignment="Center"/>
                    <TextBlock x:Name="txtPartName" Grid.Column="1" VerticalAlignment="Center" FontWeight="Bold"/>
                </Grid>

                <TextBlock x:Name="txtPriceHint" Visibility="Collapsed" Margin="0,0,0,6"
                           Foreground="DarkOrange" FontWeight="Bold"/>

                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="车牌号: " VerticalAlignment="Center"/>
                    <TextBox x:Name="txtCarMark" Grid.Column="1" Margin="0,1"
                             GotFocus="InputField_GotFocus" PreviewKeyDown="InputField_PreviewKeyDown"/>
                </Grid>
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="车型:   " VerticalAlignment="Center"/>
                    <TextBox x:Name="txtCartype" Grid.Column="1" Margin="0,1"
                             GotFocus="InputField_GotFocus" PreviewKeyDown="InputField_PreviewKeyDown"/>
                </Grid>

                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="备注:   " VerticalAlignment="Center"/>
                    <TextBox x:Name="txtMemo" Grid.Column="1" Margin="0,1"
                             GotFocus="InputField_GotFocus" PreviewKeyDown="InputField_PreviewKeyDown"/>
                </Grid>

                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="销售数量: " VerticalAlignment="Center"/>
                    <TextBox x:Name="txtAmount" Grid.Column="1" Text="1" Margin="0,1"
                             GotFocus="InputField_GotFocus" PreviewKeyDown="InputField_PreviewKeyDown"/>
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <RadioButton x:Name="rbRetail" Content="零售" IsChecked="True"
                                 Margin="0,0,16,0" Checked="RbRetail_Checked"/>
                    <RadioButton x:Name="rbWholesale" Content="批发"
                                 Checked="RbWholesale_Checked"/>
                </StackPanel>

                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="销售单价: " VerticalAlignment="Center"/>
                    <TextBox x:Name="txtPrice" Grid.Column="1" Margin="0,1"
                             GotFocus="InputField_GotFocus" PreviewKeyDown="InputField_PreviewKeyDown"
                             TextChanged="TxtPrice_TextChanged"/>
                </Grid>
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="开票单价: " VerticalAlignment="Center"/>
                    <TextBox x:Name="txtBillPrice" Grid.Column="1" Margin="0,1"
                             GotFocus="InputField_GotFocus" PreviewKeyDown="InputField_PreviewKeyDown"/>
                </Grid>

                <CheckBox x:Name="chkAutoMatch" Content="自动匹配客户历史价格" Margin="0,4,0,2"
                          IsChecked="True"
                          Checked="ChkAutoMatch_Changed" Unchecked="ChkAutoMatch_Changed"/>
                <TextBlock Text="提示:自动匹配客户最后一次价格提醒" Foreground="Gray" FontSize="11" Margin="0,0,0,4"/>
            </StackPanel>
        </GroupBox>

        <Grid Grid.Column="1" Margin="4,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <GroupBox Grid.Row="0" Header="销售历史">
                <DataGrid x:Name="dgSellHistory" AutoGenerateColumns="False" IsReadOnly="True"
                          SelectionMode="Single" MouseDoubleClick="DgSellHistory_MouseDoubleClick">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Flag}" Value="2">
                                    <Setter Property="Foreground" Value="Red"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="单号" Width="80" Binding="{Binding Sn}"/>
                        <DataGridTextColumn Header="日期" Width="80" Binding="{Binding Datetime, StringFormat=yyyy-MM-dd}"/>
                        <DataGridTextColumn Header="客户" Width="*" Binding="{Binding ClientName}"/>
                        <DataGridTextColumn Header="数量" Width="50" Binding="{Binding Amount}"/>
                        <DataGridTextColumn Header="单价" Width="60" Binding="{Binding Price, StringFormat=N2}"/>
                        <DataGridTextColumn Header="开票单价" Width="60" Binding="{Binding BillPrice, StringFormat=N2}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>

            <GroupBox Grid.Row="1" Header="采购历史 (参考)" Margin="0,4,0,0">
                <DataGrid x:Name="dgBuyHistory" AutoGenerateColumns="False" IsReadOnly="True"
                          MouseDoubleClick="DgBuyHistory_MouseDoubleClick">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Flag}" Value="2">
                                    <Setter Property="Foreground" Value="Red"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="日期" Width="90" Binding="{Binding Datetime, StringFormat=yyyy-MM-dd}"/>
                        <DataGridTextColumn Header="供应商" Width="*" Binding="{Binding SupplierName}"/>
                        <DataGridTextColumn Header="数量" Width="60" Binding="{Binding Amount}"/>
                        <DataGridTextColumn Header="进价" Width="70" Binding="{Binding Inprice, StringFormat=N2}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>
        </Grid>

        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal"
                    HorizontalAlignment="Center" Margin="0,8,0,0">
            <Button x:Name="btnOk" Content="确认(_O)" Width="90" Height="30" Margin="4,0"
                    IsDefault="True" Click="BtnOk_Click"/>
            <Button x:Name="btnCancel" Content="取消(_C)" Width="90" Height="30" Margin="4,0"
                    IsCancel="True"/>
            <Button x:Name="btnHistory" Content="历史售价" Width="90" Height="30" Margin="4,0"
                    Click="BtnHistory_Click"/>
        </StackPanel>
    </Grid>
</Window>
