<Window x:Class="QP11.Wpf.Views.PrintPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="打印预览" Height="750" Width="900"
        WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ToolBar Grid.Row="0" Margin="0,0,0,4">
            <RadioButton x:Name="rbStyle1" Content="标准格式" IsChecked="True" Margin="4,0" VerticalAlignment="Center" Click="Style_Changed"/>
            <RadioButton x:Name="rbStyle2" Content="票据格式" Margin="4,0" VerticalAlignment="Center" Click="Style_Changed"/>
            <RadioButton x:Name="rbStyle3" Content="无抬头格式" Margin="4,0" VerticalAlignment="Center" Click="Style_Changed"/>
            <Separator/>
            <TextBlock Text="高度:" VerticalAlignment="Center" Margin="4,0"/>
            <TextBox x:Name="txtHeight" Text="280" Width="50" VerticalAlignment="Center" VerticalContentAlignment="Center"/>
            <TextBlock Text="mm" VerticalAlignment="Center" Margin="2,0"/>
            <Button Content="应用" Width="45" Height="24" Click="BtnApplyHeight_Click"/>
            <Separator/>
            <TextBlock Text="打印机:" VerticalAlignment="Center" Margin="4,0"/>
            <ComboBox x:Name="cmbPrinter" Width="180" VerticalAlignment="Center" Margin="2,0"/>
            <TextBlock Text="份数:" VerticalAlignment="Center" Margin="4,0"/>
            <TextBox x:Name="txtCopies" Text="1" Width="35" VerticalAlignment="Center" VerticalContentAlignment="Center" TextAlignment="Center"/>
            <Separator/>
            <Button Content="打印" Width="55" Height="24" Click="BtnPrint_Click"/>
            <Button Content="导出Excel" Width="75" Height="24" Click="BtnExport_Click"/>
        </ToolBar>

        <FlowDocumentReader Grid.Row="1" x:Name="docReader" ViewingMode="Scroll"/>
    </Grid>
</Window>
