<Window x:Class="QP11.Wpf.Views.SupplierSelectorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择供应商" Height="450" Width="650"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,5">
            <TextBlock Text="搜索:" VerticalAlignment="Center"/>
            <TextBox x:Name="txtSearch" Width="250" Margin="5,0" TextChanged="TxtSearch_TextChanged"/>
            <Button Content="查询" Width="60" Click="BtnSearch_Click"/>
        </StackPanel>

        <DataGrid Grid.Row="1" x:Name="dgSuppliers" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single" MouseDoubleClick="DgSuppliers_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="编号" Width="80" Binding="{Binding Sid}"/>
                <DataGridTextColumn Header="名称" Width="200" Binding="{Binding Name}"/>
                <DataGridTextColumn Header="电话" Width="120" Binding="{Binding Tel}"/>
                <DataGridTextColumn Header="地址" Width="*" Binding="{Binding Address}"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,0,0">
            <Button Content="确定选择" Width="80" Height="28" Click="BtnConfirm_Click" IsDefault="True"/>
            <Button Content="取消" Width="80" Height="28" Margin="5,0" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
