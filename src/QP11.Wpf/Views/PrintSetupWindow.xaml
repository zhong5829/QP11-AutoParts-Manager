<Window x:Class="QP11.Wpf.Views.PrintSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="打印设置" Width="480" Height="460"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0">
            <TabItem Header="打印设置">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Text="打印机:" VerticalAlignment="Center" Margin="4"/>
                    <ComboBox Grid.Row="0" Grid.Column="1" x:Name="cmbPrinter" Margin="4"/>
                    <Button Grid.Row="0" Grid.Column="2" Content="属性" Width="55" Margin="4" Click="BtnPrinterProps_Click"/>

                    <TextBlock Grid.Row="1" Text="纸张大小:" VerticalAlignment="Center" Margin="4"/>
                    <ComboBox Grid.Row="1" Grid.Column="1" x:Name="cmbPaperSize" Margin="4">
                        <ComboBoxItem Content="241×93mm (针式)" Tag="241x93"/>
                        <ComboBoxItem Content="A4" Tag="A4"/>
                        <ComboBoxItem Content="A3" Tag="A3"/>
                        <ComboBoxItem Content="A5" Tag="A5"/>
                        <ComboBoxItem Content="B4" Tag="B4"/>
                        <ComboBoxItem Content="B5" Tag="B5"/>
                        <ComboBoxItem Content="Letter" Tag="Letter"/>
                        <ComboBoxItem Content="Legal" Tag="Legal"/>
                    </ComboBox>

                    <TextBlock Grid.Row="2" Text="打印方向:" VerticalAlignment="Center" Margin="4"/>
                    <ComboBox Grid.Row="2" Grid.Column="1" x:Name="cmbOrientation" Margin="4">
                        <ComboBoxItem Content="纵向" Tag="Portrait"/>
                        <ComboBoxItem Content="横向" Tag="Landscape"/>
                    </ComboBox>

                    <TextBlock Grid.Row="3" Text="打印份数:" VerticalAlignment="Center" Margin="4"/>
                    <TextBox Grid.Row="3" Grid.Column="1" x:Name="txtCopies" Text="1" Width="60" HorizontalAlignment="Left" Margin="4" VerticalContentAlignment="Center"/>

                    <CheckBox Grid.Row="4" Grid.ColumnSpan="2" x:Name="chkColor" Content="彩色打印" Margin="4,8"/>
                </Grid>
            </TabItem>

            <TabItem Header="高级设置">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.ColumnSpan="3" Text="页边距设置 (毫米)" FontWeight="Bold" Margin="4,4,4,8"/>

                    <TextBlock Grid.Row="1" Text="上边距:" VerticalAlignment="Center" Margin="4"/>
                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="txtMarginTop" Text="5" Margin="4" VerticalContentAlignment="Center"/>

                    <TextBlock Grid.Row="2" Text="下边距:" VerticalAlignment="Center" Margin="4"/>
                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="txtMarginBottom" Text="5" Margin="4" VerticalContentAlignment="Center"/>

                    <TextBlock Grid.Row="3" Text="左边距:" VerticalAlignment="Center" Margin="4"/>
                    <TextBox Grid.Row="3" Grid.Column="1" x:Name="txtMarginLeft" Text="8" Margin="4" VerticalContentAlignment="Center"/>

                    <TextBlock Grid.Row="4" Text="右边距:" VerticalAlignment="Center" Margin="4"/>
                    <TextBox Grid.Row="4" Grid.Column="1" x:Name="txtMarginRight" Text="8" Margin="4" VerticalContentAlignment="Center"/>

                    <TextBlock Grid.Row="5" Grid.ColumnSpan="3" Text="页眉页脚设置 (毫米)" FontWeight="Bold" Margin="4,12,4,8"/>
                </Grid>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="保存" Width="70" Margin="4,0" Click="BtnSave_Click"/>
            <Button Content="取消" Width="70" Margin="4,0" Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
