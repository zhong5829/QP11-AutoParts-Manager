<Window x:Class="QP11.Wpf.Views.PurchaseOrderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:QP11.Wpf.Controls"
        Title="计划订货" Height="650" Width="1050"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Row0: RadioButton filter + action buttons -->
        <Grid Grid.Row="0" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <RadioButton x:Name="rbDraft" Content="未执行" IsChecked="True"
                         VerticalAlignment="Center" Margin="4,2" GroupName="JhdhFlag"
                         Checked="RadioButton_Checked"/>
            <RadioButton x:Name="rbExecuted" Content="已执行" Grid.Column="1"
                         VerticalAlignment="Center" Margin="4,2" GroupName="JhdhFlag"
                         Checked="RadioButton_Checked"/>
            <RadioButton x:Name="rbVoided" Content="已作废" Grid.Column="2"
                         VerticalAlignment="Center" Margin="4,2" GroupName="JhdhFlag"
                         Checked="RadioButton_Checked"/>

            <Button Grid.Column="4" Content="添加配件(F1)" Width="90" Margin="4,2" Click="BtnAdd_Click"/>
            <Button Grid.Column="5" Content="转采购入库" Width="85" Margin="4,2" Click="BtnConvertToBuy_Click"/>
            <Button Grid.Column="6" Content="导 出" Width="60" Margin="4,2" Click="BtnExport_Click"/>
            <Button Grid.Column="7" Content="作 废" Width="60" Margin="4,2" Click="BtnVoid_Click"/>
        </Grid>

        <!-- Row1: Left-Right Master-Detail -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel: Header + Detail -->
            <Grid Grid.Column="0" Margin="0,0,4,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header GroupBox -->
                <GroupBox Grid.Row="0" Header="单头信息" Margin="0,0,0,2" Padding="2">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="2">
                            <TextBlock Text="供应商:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <controls:SupplierSearchBox x:Name="cboSupplier" Width="200" TabIndex="1"/>
                            <TextBlock Text="经手人:" VerticalAlignment="Center" Margin="10,0,4,0"/>
                            <ComboBox x:Name="cboWorker" IsEditable="True" Width="100" TabIndex="2"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="2">
                            <TextBlock Text="单  号:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBox x:Name="txtBillNo" IsReadOnly="True" Background="LightGray" Width="140"/>
                            <TextBlock Text="日  期:" VerticalAlignment="Center" Margin="10,0,4,0"/>
                            <DatePicker x:Name="dtBillDate" Width="130" TabIndex="3"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="2">
                            <TextBlock Text="金  额:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBox x:Name="txtTotal" IsReadOnly="True" Background="LightGray" Width="120"/>
                            <TextBlock Text="状  态:" VerticalAlignment="Center" Margin="10,0,4,0"/>
                            <TextBox x:Name="txtFlag" IsReadOnly="True" Background="LightGray" Width="80"/>
                        </StackPanel>

                        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="2">
                            <TextBlock Text="备  注:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBox x:Name="txtMemo" Width="300" TabIndex="4"/>
                        </StackPanel>
                    </Grid>
                </GroupBox>

                <!-- Detail DataGrid -->
                <GroupBox Grid.Row="1" Header="计划明细">
                    <DataGrid x:Name="dgDetails" AutoGenerateColumns="False" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="配件编码" Width="80" Binding="{Binding PartNo}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="名称" Width="120" Binding="{Binding Name}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="规格" Width="60" Binding="{Binding Cartype}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="单位" Width="40" Binding="{Binding Unit}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="采购价" Width="65" Binding="{Binding InPrice, StringFormat=N2}"/>
                            <DataGridTextColumn Header="数量" Width="50" Binding="{Binding Amount}"/>
                            <DataGridTextColumn Header="小计" Width="65" Binding="{Binding SubTotal, StringFormat=N2}" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </GroupBox>
            </Grid>

            <!-- Right Panel: Bill List -->
            <GroupBox Grid.Column="1" Header="单据列表">
                <DataGrid x:Name="dgBills" AutoGenerateColumns="False" CanUserAddRows="False"
                          SelectionChanged="DgBills_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="单号" Width="80" Binding="{Binding Sn}"/>
                        <DataGridTextColumn Header="日期" Width="100" Binding="{Binding Datetime, StringFormat=yyyy-MM-dd}"/>
                        <DataGridTextColumn Header="供应商" Width="100" Binding="{Binding SupplierName}"/>
                        <DataGridTextColumn Header="经手人" Width="60" Binding="{Binding WorkerName}"/>
                        <DataGridTextColumn Header="金额" Width="80" Binding="{Binding Total, StringFormat=N2}"/>
                        <DataGridTextColumn Header="状态" Width="60" Binding="{Binding FlagText}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>
        </Grid>

        <!-- Row2: Action buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="5">
            <Button Content="新 单" Width="80" Height="32" Margin="5" Click="BtnNew_Click"/>
            <Button Content="保 存" Width="80" Height="32" Margin="5" Click="BtnSave_Click"/>
            <Button Content="退 出" Width="80" Height="32" Margin="5" Click="BtnClose_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
