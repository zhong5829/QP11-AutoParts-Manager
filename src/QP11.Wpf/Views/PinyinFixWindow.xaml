<Window x:Class="QP11.Wpf.Views.PinyinFixWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="拼音修复" Height="500" Width="800"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <Button x:Name="btnScan" Content="扫描缺失" Width="90" Height="28" Click="BtnScan_Click"/>
            <Button x:Name="btnFixAll" Content="一键修复" Width="90" Height="28" Margin="10,0,0,0" Click="BtnFixAll_Click" IsEnabled="False"/>
            <TextBlock x:Name="txtStatus" VerticalAlignment="Center" Margin="16,0,0,0" Foreground="Blue"/>
        </StackPanel>

        <DataGrid Grid.Row="1" x:Name="dgResult" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
            <DataGrid.Columns>
                <DataGridTextColumn Header="编码" Width="120" Binding="{Binding Partno}"/>
                <DataGridTextColumn Header="名称" Width="180" Binding="{Binding Name}"/>
                <DataGridTextColumn Header="名称拼音(当前)" Width="110" Binding="{Binding NamePyOld}"/>
                <DataGridTextColumn Header="名称拼音(修复)" Width="110" Binding="{Binding NamePyNew}"/>
                <DataGridTextColumn Header="车型" Width="120" Binding="{Binding Cartype}"/>
                <DataGridTextColumn Header="车型拼音(当前)" Width="110" Binding="{Binding CartypePyOld}"/>
                <DataGridTextColumn Header="车型拼音(修复)" Width="*" Binding="{Binding CartypePyNew}"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="2" x:Name="txtInfo" Text="" Foreground="Gray" Margin="0,5,0,0"/>
    </Grid>
</Window>
