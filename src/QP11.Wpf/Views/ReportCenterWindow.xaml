<Window x:Class="QP11.Wpf.Views.ReportCenterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="报表中心" Height="500" Width="900"
        WindowStartupLocation="CenterOwner"
        Loaded="Window_Loaded">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <GroupBox Header="报表类型" Margin="0,0,5,0">
            <ListBox x:Name="lbReportType" SelectionChanged="LbReportType_SelectionChanged">
                <ListBoxItem Content="销售汇总" Tag="SellSummary"/>
                <ListBoxItem Content="销售明细" Tag="SellDetail"/>
                <ListBoxItem Content="销售排行" Tag="SellRank"/>
                <ListBoxItem Content="采购汇总" Tag="BuySummary"/>
                <ListBoxItem Content="采购明细" Tag="BuyDetail"/>
                <ListBoxItem Content="库存台账" Tag="Inventory"/>
                <ListBoxItem Content="库存预警" Tag="StockAlert"/>
                <ListBoxItem Content="应收应付" Tag="Arrearage"/>
            </ListBox>
        </GroupBox>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,5">
                <TextBlock Text="起始日期:" VerticalAlignment="Center"/>
                <DatePicker x:Name="dtStart" Width="130" Margin="5,0"/>
                <TextBlock Text="截止日期:" VerticalAlignment="Center" Margin="10,0,0,0"/>
                <DatePicker x:Name="dtEnd" Width="130" Margin="5,0"/>
                <Button Content="生成报表" Width="80" Click="BtnGenerate_Click"/>
            </StackPanel>

            <DataGrid Grid.Row="1" x:Name="dgReport" AutoGenerateColumns="True" IsReadOnly="True"
                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"/>

            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,5,0,0">
                <TextBlock x:Name="txtReportInfo" Text="请选择报表类型并设置日期范围"/>
                <Button Content="导出Excel" Width="80" Margin="20,0,0,0" Click="BtnExport_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
