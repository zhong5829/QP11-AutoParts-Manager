<Window x:Class="QP11.Wpf.Views.RankingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="排行榜" Height="600" Width="900"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,5">
            <TextBlock Text="起始日期:" VerticalAlignment="Center" Margin="5"/>
            <DatePicker x:Name="dtStart" Margin="2"/>
            <TextBlock Text="截止日期:" VerticalAlignment="Center" Margin="10,5,5,5"/>
            <DatePicker x:Name="dtEnd" Margin="2"/>
            <Button Content="查询" Width="60" Height="26" Margin="10,0" Click="BtnQuery_Click"/>
        </StackPanel>

        <TabControl Grid.Row="1">
            <TabItem Header="销售排行">
                <DataGrid x:Name="dgPartRank" AutoGenerateColumns="False" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="排名" Width="50" Binding="{Binding Rank}"/>
                        <DataGridTextColumn Header="配件编码" Width="120" Binding="{Binding PartNo}"/>
                        <DataGridTextColumn Header="配件名称" Width="200" Binding="{Binding PartName}"/>
                        <DataGridTextColumn Header="销售数量" Width="80" Binding="{Binding TotalAmount}"/>
                        <DataGridTextColumn Header="销售金额" Width="120" Binding="{Binding TotalMoney, StringFormat=c2}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="TOP客户">
                <DataGrid x:Name="dgClientRank" AutoGenerateColumns="False" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="排名" Width="50" Binding="{Binding Rank}"/>
                        <DataGridTextColumn Header="客户名称" Width="200" Binding="{Binding ClientName}"/>
                        <DataGridTextColumn Header="订单数" Width="80" Binding="{Binding OrderCount}"/>
                        <DataGridTextColumn Header="销售金额" Width="120" Binding="{Binding TotalMoney, StringFormat=c2}"/>
                        <DataGridTextColumn Header="欠款" Width="120" Binding="{Binding Arrearage, StringFormat=c2}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="业务员业绩">
                <DataGrid x:Name="dgWorkerRank" AutoGenerateColumns="False" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="排名" Width="50" Binding="{Binding Rank}"/>
                        <DataGridTextColumn Header="业务员" Width="120" Binding="{Binding WorkerName}"/>
                        <DataGridTextColumn Header="订单数" Width="80" Binding="{Binding OrderCount}"/>
                        <DataGridTextColumn Header="销售金额" Width="120" Binding="{Binding TotalMoney, StringFormat=c2}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
