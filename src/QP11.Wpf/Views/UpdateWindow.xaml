<Window x:Class="QP11.Wpf.Views.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="系统更新" Height="380" Width="480"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Loaded="Window_Loaded">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 版本信息 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="发现新版本：" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
            <TextBlock x:Name="txtVersion" FontSize="16" FontWeight="Bold" Foreground="#2196F3" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- 当前版本 -->
        <TextBlock Grid.Row="1" x:Name="txtCurrentVersion" Foreground="Gray" Margin="0,0,0,10"/>

        <!-- 更新日志 -->
        <GroupBox Grid.Row="2" Header="更新内容" Margin="0,0,0,10">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="txtChangelog" TextWrapping="Wrap" LineHeight="22"/>
            </ScrollViewer>
        </GroupBox>

        <!-- 下载进度 -->
        <Grid Grid.Row="3" Margin="0,0,0,5" x:Name="progressPanel" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <ProgressBar x:Name="progressBar" Height="20" Minimum="0" Maximum="100"/>
            <TextBlock Grid.Row="1" x:Name="txtProgress" HorizontalAlignment="Center" Margin="0,3,0,0"/>
        </Grid>

        <!-- 文件大小 -->
        <TextBlock Grid.Row="4" x:Name="txtFileSize" Foreground="Gray" Margin="0,0,0,10"/>

        <!-- 按钮 -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="btnRemindLater" Content="稍后提醒" Width="80" Height="30" Margin="0,0,10,0" Click="BtnRemindLater_Click"/>
            <Button x:Name="btnSkip" Content="跳过此版本" Width="90" Height="30" Margin="0,0,10,0" Click="BtnSkip_Click"/>
            <Button x:Name="btnUpdate" Content="立即更新" Width="80" Height="30" Click="BtnUpdate_Click"/>
        </StackPanel>
    </Grid>
</Window>
