<Window x:Class="QP11.Wpf.Views.JhdhConvertWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="计划单转采购入库" Height="550" Width="800"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Row0: Info -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="计划单号:" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <TextBox x:Name="txtJhdhSn" IsReadOnly="True" Background="LightGray" Width="120"/>
            <TextBlock Text="(到货数量/价格可能与计划不同，请核实后确认)" VerticalAlignment="Center"
                       Margin="16,0,0,0" Foreground="Gray"/>
        </StackPanel>

        <!-- Row1: Editable details -->
        <DataGrid Grid.Row="1" x:Name="dgConvertDetails" AutoGenerateColumns="False" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="配件编码" Width="90" Binding="{Binding PartNo}" IsReadOnly="True"/>
                <DataGridTextColumn Header="名称" Width="150" Binding="{Binding Name}" IsReadOnly="True"/>
                <DataGridTextColumn Header="规格" Width="80" Binding="{Binding Cartype}" IsReadOnly="True"/>
                <DataGridTextColumn Header="单位" Width="50" Binding="{Binding Unit}" IsReadOnly="True"/>
                <DataGridTextColumn Header="计划数" Width="60" Binding="{Binding PlanAmount}" IsReadOnly="True"/>
                <DataGridTextColumn Header="到货数" Width="60" Binding="{Binding Amount}"/>
                <DataGridTextColumn Header="采购价" Width="80" Binding="{Binding InPrice, StringFormat=N2}"/>
                <DataGridTextColumn Header="零售价" Width="80" Binding="{Binding LsPrice, StringFormat=N2}" IsReadOnly="True"/>
                <DataGridTextColumn Header="小计" Width="80" Binding="{Binding SubTotal, StringFormat=N2}" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Row2: Total + Payment -->
        <Grid Grid.Row="2" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <TextBlock Text="合计金额:" FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBox x:Name="txtTotal" IsReadOnly="True" FontSize="14" Foreground="Red"
                         Width="120" HorizontalContentAlignment="Right" Margin="8,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <TextBlock Text="现金:" VerticalAlignment="Center"/>
                <TextBox x:Name="txtCash" Text="0" Width="100" Margin="4,2" TextChanged="Payment_TextChanged"/>
                <TextBlock Text="挂账:" VerticalAlignment="Center" Margin="10,0,0,0"/>
                <TextBox x:Name="txtCredit" IsReadOnly="True" Background="LightGray" Width="100" Margin="4,2"/>
            </StackPanel>
        </Grid>

        <!-- Row3: Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
            <Button Content="确认入库" Width="100" Height="32" Margin="5" Click="BtnConfirm_Click"/>
            <Button Content="取 消" Width="100" Height="32" Margin="5" Click="BtnCancel_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
