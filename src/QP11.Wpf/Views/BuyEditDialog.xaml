<Window x:Class="QP11.Wpf.Views.BuyEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="采购编辑" Width="750" Height="650"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Loaded="Window_Loaded">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="140"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="210"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="68"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="搜索模式:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <RadioButton x:Name="rbExact" Content="精确" Margin="4,0" VerticalAlignment="Center"/>
                        <RadioButton x:Name="rbFuzzy" Content="模糊" IsChecked="True" Margin="4,0" VerticalAlignment="Center"/>
                        <RadioButton x:Name="rbExactMatch" Content="精确匹配" Margin="4,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Grid.Row="1" Text="配件编号:" VerticalAlignment="Center" Margin="0,2"/>
                    <ComboBox Grid.Row="1" Grid.Column="1" x:Name="cboPartNo" IsEditable="True" IsTextSearchEnabled="False" Margin="1,2"
                              SelectionChanged="CboPartNo_SelectionChanged"
                              TextBoxBase.TextChanged="Dddw_TextChanged"
                              KeyDown="CboPartNo_KeyDown">
                        <ComboBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel/>
                            </ItemsPanelTemplate>
                        </ComboBox.ItemsPanel>
                    </ComboBox>

                    <TextBlock Grid.Row="2" Text="名称:" VerticalAlignment="Center" Margin="0,2"/>
                    <ComboBox Grid.Row="2" Grid.Column="1" x:Name="cboName" IsEditable="True" IsTextSearchEnabled="False" Margin="1,2"
                              TextBoxBase.TextChanged="Dddw_TextChanged">
                        <ComboBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel/>
                            </ItemsPanelTemplate>
                        </ComboBox.ItemsPanel>
                    </ComboBox>

                    <TextBlock Grid.Row="3" Text="车系:" VerticalAlignment="Center" Margin="0,2"/>
                    <ComboBox Grid.Row="3" Grid.Column="1" x:Name="cboCarName" IsEditable="True" IsTextSearchEnabled="False" Margin="1,2"
                              TextBoxBase.TextChanged="Dddw_TextChanged">
                        <ComboBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel/>
                            </ItemsPanelTemplate>
                        </ComboBox.ItemsPanel>
                    </ComboBox>

                    <TextBlock Grid.Row="4" Text="车型:" VerticalAlignment="Center" Margin="0,2"/>
                    <ComboBox Grid.Row="4" Grid.Column="1" x:Name="cboCarType" IsEditable="True" IsTextSearchEnabled="False" Margin="1,2"
                              TextBoxBase.TextChanged="Dddw_TextChanged">
                        <ComboBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel/>
                            </ItemsPanelTemplate>
                        </ComboBox.ItemsPanel>
                    </ComboBox>

                    <TextBlock Grid.Row="5" Text="单位:" VerticalAlignment="Center" Margin="0,2"/>
                    <ComboBox Grid.Row="5" Grid.Column="1" x:Name="cboUnit" IsEditable="True" IsTextSearchEnabled="False" Margin="1,2"
                              TextBoxBase.TextChanged="Dddw_TextChanged">
                        <ComboBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel/>
                            </ItemsPanelTemplate>
                        </ComboBox.ItemsPanel>
                    </ComboBox>

                    <TextBlock Grid.Row="6" Text="区域:" VerticalAlignment="Center" Margin="0,2"/>
                    <ComboBox Grid.Row="6" Grid.Column="1" x:Name="cboArea" IsEditable="True" IsTextSearchEnabled="False" Margin="1,2"
                              TextBoxBase.TextChanged="Dddw_TextChanged">
                        <ComboBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel/>
                            </ItemsPanelTemplate>
                        </ComboBox.ItemsPanel>
                    </ComboBox>

                    <TextBlock Grid.Row="7" Text="分类:" VerticalAlignment="Center" Margin="0,2"/>
                    <ComboBox Grid.Row="7" Grid.Column="1" x:Name="cboClass" IsEditable="True" IsTextSearchEnabled="False" Margin="1,2"
                              TextBoxBase.TextChanged="Dddw_TextChanged">
                        <ComboBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel/>
                            </ItemsPanelTemplate>
                        </ComboBox.ItemsPanel>
                    </ComboBox>

                    <TextBlock Grid.Row="8" Text="仓位:" VerticalAlignment="Center" Margin="0,2"/>
                    <ComboBox Grid.Row="8" Grid.Column="1" x:Name="cboPlace" IsEditable="True" IsTextSearchEnabled="False" Margin="1,2"
                              TextBoxBase.TextChanged="Dddw_TextChanged">
                        <ComboBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel/>
                            </ItemsPanelTemplate>
                        </ComboBox.ItemsPanel>
                    </ComboBox>

                    <TextBlock Grid.Row="9" Text="图号:" VerticalAlignment="Center" Margin="0,2"/>
                    <TextBox Grid.Row="9" Grid.Column="1" x:Name="txtPartTh" Margin="1,2"/>

                    <TextBlock Grid.Row="10" Text="规格:" VerticalAlignment="Center" Margin="0,2"/>
                    <TextBox Grid.Row="10" Grid.Column="1" x:Name="txtPartGg" Margin="1,2"/>

                    <TextBlock Grid.Row="11" Text="出厂类别:" VerticalAlignment="Center" Margin="0,2"/>
                    <TextBox Grid.Row="11" Grid.Column="1" x:Name="txtPartCclb" Margin="1,2"/>

                    <Grid Grid.Row="12" Grid.ColumnSpan="2" Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="68"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="进价:" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" x:Name="txtInPrice" Margin="1,2"/>
                        <TextBlock Grid.Column="2" Text="数量:" VerticalAlignment="Center" Margin="4,0,0,0"/>
                        <TextBox Grid.Column="3" x:Name="txtAmount" Text="1" Margin="1,2"/>
                    </Grid>

                    <Grid Grid.Row="13" Grid.ColumnSpan="2" Margin="0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="68"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="零售价:" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" x:Name="txtLsPrice" Margin="1,2"/>
                        <TextBlock Grid.Column="2" Text="批发价:" VerticalAlignment="Center" Margin="4,0,0,0"/>
                        <TextBox Grid.Column="3" x:Name="txtPfPrice" Margin="1,2"/>
                    </Grid>

                    <TextBlock Grid.Row="14" Text="备注:" VerticalAlignment="Center" Margin="0,2"/>
                    <TextBox Grid.Row="14" Grid.Column="1" x:Name="txtMemo" Margin="1,2"/>

                    <CheckBox Grid.Row="15" Grid.ColumnSpan="2" x:Name="chkUpdateStock" Content="更新库存" IsChecked="True" Margin="0,4"/>

                    <StackPanel Grid.Row="16" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,6,0,0">
                        <Button Content="选择" Width="70" Height="26" Margin="0,0,6,0" Click="BtnSelect_Click"/>
                        <Button Content="确认(&amp;O)" Width="70" Height="26" Margin="0,0,6,0" Click="BtnConfirm_Click" IsDefault="True"/>
                        <Button Content="取消(&amp;C)" Width="70" Height="26" Click="BtnCancel_Click" IsCancel="True"/>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <StackPanel Grid.Column="1" HorizontalAlignment="Center" Margin="4,20,0,0">
                <Border BorderBrush="#CCCCCC" BorderThickness="1" Background="#F5F5F5" Width="200" Height="200">
                    <Image x:Name="imgPart" Stretch="Uniform" Width="196" Height="196"/>
                </Border>
                <Button x:Name="btnUploadImage" Content="上传图片" Width="80" Height="26" Margin="0,6,0,0" Click="BtnUploadImage_Click"/>
            </StackPanel>
        </Grid>

        <GroupBox Grid.Row="1" Header="采购历史" Margin="0,4,0,0">
            <DataGrid x:Name="dgBuyHistory" AutoGenerateColumns="False" IsReadOnly="True"
                      HeadersVisibility="Column" CanUserAddRows="False" CanUserDeleteRows="False"
                      VirtualizingPanel.IsVirtualizing="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="日期" Width="110" Binding="{Binding Datetime, StringFormat=yyyy-MM-dd}"/>
                    <DataGridTextColumn Header="数量" Width="70" Binding="{Binding Amount}"/>
                    <DataGridTextColumn Header="进价" Width="90" Binding="{Binding Inprice, StringFormat=N2}"/>
                    <DataGridTextColumn Header="供应商" Width="*" Binding="{Binding Supplier}"/>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>
    </Grid>
</Window>
