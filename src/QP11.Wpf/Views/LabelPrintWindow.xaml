<Window x:Class="QP11.Wpf.Views.LabelPrintWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:QP11.Wpf.Views"
        Title="标签打印" Height="680" Width="1180"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 查询区：三条件实时查询（防抖）+ 方向键切换输入框 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
            <TextBlock Text="编码:" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <TextBox x:Name="txtPartNo" Width="140" Margin="0,0,12,0" Padding="3,2"
                     TextChanged="Txt_TextChanged" GotKeyboardFocus="Txt_GotKeyboardFocus" PreviewKeyDown="Txt_KeyDown"/>
            <TextBlock Text="名称:" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <TextBox x:Name="txtName" Width="160" Margin="0,0,12,0" Padding="3,2"
                     TextChanged="Txt_TextChanged" GotKeyboardFocus="Txt_GotKeyboardFocus" PreviewKeyDown="Txt_KeyDown"/>
            <TextBlock Text="车型:" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <TextBox x:Name="txtCarType" Width="140" Margin="0,0,12,0" Padding="3,2"
                     TextChanged="Txt_TextChanged" GotKeyboardFocus="Txt_GotKeyboardFocus" PreviewKeyDown="Txt_KeyDown"/>
            <TextBlock Text="（自动查询 · 左右方向键切换输入框）" VerticalAlignment="Center" Foreground="Gray" FontSize="11"/>
        </StackPanel>

        <!-- 工具栏 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,6">
            <TextBlock Text="模板:" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <ComboBox x:Name="cboTemplate" Width="130" Margin="0,0,4,0" DisplayMemberPath="Name" SelectionChanged="Template_Changed"/>
            <Button Content="新建" Width="56" Margin="0,0,4,0" Height="24" ToolTip="新建模板：设置名称与纸张大小" Click="BtnNewTemplate_Click"/>
            <Button Content="保存" Width="56" Margin="0,0,4,0" Height="24" ToolTip="保存当前自定义模板（内置模板不可保存）" Click="BtnSaveTemplate_Click"/>
            <Button Content="删除模板" Width="74" Margin="0,0,12,0" Height="24" ToolTip="删除用户自定义模板（内置模板不可删）" Click="BtnDeleteTemplate_Click"/>
            <TextBlock Text="打印机:" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <ComboBox x:Name="cboPrinter" Width="170" Margin="0,0,12,0"/>
            <TextBlock Text="每件份数:" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <TextBox x:Name="txtCopies" Text="1" Width="42" Margin="0,0,12,0" Padding="3,2" TextChanged="Copies_Changed" VerticalContentAlignment="Center"/>
            <CheckBox x:Name="chkAll" Content="全选" VerticalAlignment="Center" Margin="0,0,12,0" Checked="ChkAll_Changed" Unchecked="ChkAll_Changed"/>
            <Button Content="打印标签" Width="86" Height="26" Margin="12,0,0,0" Click="BtnPrint_Click"/>
        </StackPanel>

        <!-- 主体：列表 + 预览 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <DataGrid Grid.Column="0" x:Name="dgItems" AutoGenerateColumns="False" CanUserAddRows="False"
                      VirtualizingPanel.IsVirtualizing="True" Margin="0,0,8,0">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="打印" Width="50">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected}" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" Click="ChkItem_Click"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="零件编码" Width="110" Binding="{Binding PartNo}" IsReadOnly="True"/>
                    <DataGridTextColumn Header="配件名称" Width="150" Binding="{Binding Name}" IsReadOnly="True"/>
                    <DataGridTemplateColumn Header="车型" Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding CarType}" Margin="4,0" TextTrimming="CharacterEllipsis"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding CarType, UpdateSourceTrigger=LostFocus}" Margin="4,0"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="仓位" Width="80" Binding="{Binding Place}" IsReadOnly="True"/>
                    <DataGridTextColumn Header="库存" Width="60" Binding="{Binding Amount}" IsReadOnly="True"/>
                </DataGrid.Columns>
            </DataGrid>

            <views:LabelPreviewEditor Grid.Column="1" x:Name="editor"/>
        </Grid>

        <TextBlock Grid.Row="3" x:Name="txtStatus" Margin="0,4,0,0" Text="共 0 条 · 标签按 仓位→零件编码 排序输出"/>
    </Grid>
</Window>