<Window x:Class="QP11.Wpf.Views.MemberCardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="会员管理" Height="550" Width="850"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,5">
            <TextBlock Text="搜索:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <TextBox x:Name="txtSearch" Width="200" TextChanged="TxtSearch_TextChanged"/>
            <Button Content="查询" Width="60" Margin="5,0" Click="BtnSearch_Click"/>
            <Separator Width="15"/>
            <Button Content="新增" Width="55" Click="BtnAdd_Click"/>
            <Button Content="编辑" Width="55" Margin="5,0" Click="BtnEdit_Click"/>
            <Button Content="充值" Width="55" Click="BtnRecharge_Click"/>
            <Button Content="删除" Width="55" Margin="5,0" Click="BtnDelete_Click"/>
        </StackPanel>

        <DataGrid Grid.Row="1" x:Name="dgMembers" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single" MouseDoubleClick="DgMembers_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="卡号" Width="100" Binding="{Binding Kh}"/>
                <DataGridTextColumn Header="客户名称" Width="100" Binding="{Binding Khmc}"/>
                <DataGridTextColumn Header="联系人" Width="80" Binding="{Binding Lxr}"/>
                <DataGridTextColumn Header="电话" Width="110" Binding="{Binding Tel}"/>
                <DataGridTextColumn Header="车牌" Width="80" Binding="{Binding Cp}"/>
                <DataGridTextColumn Header="余额" Width="80" Binding="{Binding Je, StringFormat=c2}"/>
                <DataGridTextColumn Header="折扣率" Width="60" Binding="{Binding Zkl, StringFormat=p0}"/>
                <DataGridTextColumn Header="状态" Width="60" Binding="{Binding Zt}"/>
                <DataGridTextColumn Header="卡类别" Width="60" Binding="{Binding Klb}"/>
                <DataGridTextColumn Header="消费次数" Width="70" Binding="{Binding Ykcs}"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="2" x:Name="txtCount" Text="共 0 条记录" Margin="0,5,0,0"/>
    </Grid>
</Window>
