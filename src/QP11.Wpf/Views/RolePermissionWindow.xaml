<Window x:Class="QP11.Wpf.Views.RolePermissionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="权限管理" Height="640" Width="920"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <GroupBox Header="用户列表">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,5">
                    <Button Content="刷新" Width="60" Height="26" Click="BtnRefresh_Click"/>
                </StackPanel>
                <ListBox x:Name="lbUsers" SelectionChanged="LbUsers_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Display}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding GroupName, StringFormat=〔{0}〕}" Margin="6,0,0,0"
                                           Foreground="Gray" FontSize="11" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </GroupBox>

        <GroupBox Grid.Column="1" Header="菜单权限（按新系统主窗口菜单勾选，保存到该用户）" Margin="5,0,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,5">
                    <TextBlock x:Name="txtSelUser" Text="未选择用户" VerticalAlignment="Center" Margin="2" FontWeight="Bold"/>
                    <Separator Margin="8,0" Width="1" Background="Gray"/>
                    <Button Content="全选" Width="60" Height="26" Click="BtnSelectAll_Click"/>
                    <Button Content="全不选" Width="60" Height="26" Margin="4,0" Click="BtnSelectNone_Click"/>
                    <Button Content="保存权限" Width="90" Height="26" Click="BtnSave_Click"/>
                    <Button x:Name="btnDemote" Content="降级为普通管理员" Width="125" Height="26" Margin="4,0"
                            IsEnabled="False" Click="BtnDemote_Click"
                            ToolTip="移除该用户 auth 的 all 超级权限（保留其它码），并把角色组改为“管理员”（groups=2）"/>
                </StackPanel>
                <TextBlock DockPanel.Dock="Bottom" Text="规则：勾选整组即包含全部子菜单；保存自动精简为最小父集（如勾了整组只存父码 1/2/3/4/7）；auth 含 all 为全部权限；树外旧权限码自动保留。" 
                           Foreground="Gray" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                    <TreeView x:Name="tvMenus"/>
                </ScrollViewer>
            </DockPanel>
        </GroupBox>
    </Grid>
</Window>