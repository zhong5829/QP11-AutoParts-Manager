<Window x:Class="QP11.Wpf.Views.RolePermissionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="角色权限管理" Height="550" Width="800"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <GroupBox Header="角色列表">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,5">
                    <Button Content="新增角色" Width="80" Height="26" Click="BtnAddRole_Click"/>
                    <Button Content="删除角色" Width="80" Height="26" Margin="5,0" Click="BtnDeleteRole_Click"/>
                </StackPanel>
                <ListBox x:Name="lbRoles" DisplayMemberPath="Name" SelectionChanged="LbRoles_SelectionChanged"/>
            </DockPanel>
        </GroupBox>

        <GroupBox Grid.Column="1" Header="权限设置" Margin="5,0,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,5">
                    <TextBlock Text="角色名称:" VerticalAlignment="Center" Margin="5"/>
                    <TextBox x:Name="txtRoleName" Width="150" Margin="2"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Center" Margin="5">
                    <Button Content="保存权限" Width="100" Height="32" Click="BtnSave_Click"/>
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="spPermissions" Margin="5"/>
                </ScrollViewer>
            </DockPanel>
        </GroupBox>
    </Grid>
</Window>
