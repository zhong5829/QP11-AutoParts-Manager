<Window x:Class="QP11.Wpf.Views.BarcodeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="条码管理" Height="600" Width="800"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,5">
            <TextBlock Text="配件编码:" VerticalAlignment="Center" Margin="5"/>
            <TextBox x:Name="txtPartNo" Width="150" Margin="2"/>
            <Button Content="查询" Width="60" Height="26" Margin="5,0" Click="BtnQuery_Click"/>
            <Button Content="生成条码" Width="80" Height="26" Margin="5,0" Click="BtnGenerate_Click"/>
            <Button Content="打印标签" Width="80" Height="26" Margin="5,0" Click="BtnPrint_Click"/>
        </StackPanel>

        <DataGrid Grid.Row="1" x:Name="dgList" AutoGenerateColumns="False" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="配件ID" Width="80" Binding="{Binding Partid}" IsReadOnly="True"/>
                <DataGridTextColumn Header="编码" Width="120" Binding="{Binding Partno}" IsReadOnly="True"/>
                <DataGridTextColumn Header="名称" Width="200" Binding="{Binding Name}" IsReadOnly="True"/>
                <DataGridTextColumn Header="零售价" Width="80" Binding="{Binding Lsprice, StringFormat=c2}" IsReadOnly="True"/>
                <DataGridCheckBoxColumn Header="选择" Width="50" Binding="{Binding IsSelected}"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="2" Text="已生成条码标签:" VerticalAlignment="Center" Margin="5,5,0,5" FontWeight="Bold"/>

        <DataGrid Grid.Row="3" x:Name="dgLabels" AutoGenerateColumns="False" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="配件编码" Width="150" Binding="{Binding Partno}" IsReadOnly="True"/>
                <DataGridTextColumn Header="配件名称" Width="200" Binding="{Binding Name}" IsReadOnly="True"/>
                <DataGridTextColumn Header="条码(Code128)" Width="*" Binding="{Binding BarcodeText}" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="4" x:Name="txtCount" VerticalAlignment="Center" Margin="5"/>
    </Grid>
</Window>
