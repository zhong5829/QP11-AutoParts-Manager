<Window x:Class="QP11.Wpf.Views.OrderDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="单据详情" Width="820" Height="580"
        WindowStartupLocation="CenterOwner"
        MinWidth="700" MinHeight="450"
        ShowInTaskbar="False">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 单据标题 -->
        <TextBlock x:Name="txtTitle" Grid.Row="0" FontSize="16" FontWeight="Bold"
                   HorizontalAlignment="Center" Margin="0,0,0,10"/>

        <!-- 单据头信息 -->
        <GroupBox Grid.Row="1" Header="单据信息">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="单号:" VerticalAlignment="Center" Margin="4"/>
                <TextBox Grid.Column="1" x:Name="txtSn" IsReadOnly="True" Background="#F5F5F5" Margin="2"/>

                <TextBlock Grid.Column="2" Text="日期:" VerticalAlignment="Center" Margin="10,4,4,4"/>
                <TextBox Grid.Column="3" x:Name="txtDate" IsReadOnly="True" Background="#F5F5F5" Margin="2"/>

                <TextBlock Grid.Row="1" Text="客户/供应商:" VerticalAlignment="Center" Margin="4"/>
                <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" x:Name="txtPartner"
                         IsReadOnly="True" Background="#F5F5F5" Margin="2"/>

                <TextBlock Grid.Row="2" Text="业务员:" VerticalAlignment="Center" Margin="4"/>
                <TextBox Grid.Row="2" Grid.Column="1" x:Name="txtWorker" IsReadOnly="True" Background="#F5F5F5" Margin="2"/>
                <TextBlock Grid.Row="2" Grid.Column="2" Text="操作员:" VerticalAlignment="Center" Margin="10,4,4,4"/>
                <TextBox Grid.Row="2" Grid.Column="3" x:Name="txtOperator" IsReadOnly="True" Background="#F5F5F5" Margin="2"/>

                <TextBlock Grid.Row="3" Text="折扣率:" VerticalAlignment="Center" Margin="4"/>
                <TextBox Grid.Row="3" Grid.Column="1" x:Name="txtDiscountRate" IsReadOnly="True" Background="#F5F5F5" Margin="2"/>
                <TextBlock Grid.Row="3" Grid.Column="2" Text="开票总额:" VerticalAlignment="Center" Margin="10,4,4,4"/>
                <TextBox Grid.Row="3" Grid.Column="3" x:Name="txtBillTotal" IsReadOnly="True" Background="#F5F5F5" Margin="2"/>

                <TextBlock Grid.Row="4" Text="收款情况:" VerticalAlignment="Center" Margin="4"/>
                <TextBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3" x:Name="txtPaymentInfo"
                         IsReadOnly="True" Background="#F5F5F5" Margin="2"/>

                <!-- 备注行（销售单有备注） -->
                <TextBlock x:Name="lblMemoLabel" Grid.Row="5" Text="备注:" VerticalAlignment="Center" Margin="4" Visibility="Collapsed"/>
                <TextBox x:Name="txtMemo" Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="3"
                         IsReadOnly="True" Background="#F5F5F5" Margin="2" Visibility="Collapsed"/>
            </Grid>
        </GroupBox>

        <!-- 明细列表 -->
        <GroupBox Grid.Row="2" Header="明细列表" Margin="0,6,0,0">
            <DataGrid x:Name="dgDetails" AutoGenerateColumns="False" IsReadOnly="True"
                      SelectionMode="Single" CanUserAddRows="False" CanUserDeleteRows="False"
                      GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                      RowHeaderWidth="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="配件编号" Width="100" Binding="{Binding Partno}"/>
                    <DataGridTextColumn Header="配件名称" Width="*" Binding="{Binding Name}"/>
                    <DataGridTextColumn Header="车型" Width="90" Binding="{Binding Cartype}"/>
                    <DataGridTextColumn Header="数量" Width="55" Binding="{Binding Amount}"/>
                    <DataGridTextColumn Header="单价" Width="70" Binding="{Binding Price, StringFormat=N2}"/>
                    <DataGridTextColumn Header="成本/进价" Width="75" Binding="{Binding CostPrice, StringFormat=N2}"/>
                    <DataGridTextColumn Header="小计" Width="80" Binding="{Binding Subtotal, StringFormat=N2}"/>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <!-- 底部按钮 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
            <Button Content="关闭" Width="80" Height="30" Click="BtnClose_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
