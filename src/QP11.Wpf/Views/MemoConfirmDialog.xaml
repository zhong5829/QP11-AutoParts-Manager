<Window x:Class="QP11.Wpf.Views.MemoConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="确认操作" Height="180" Width="320"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="请输入登录密码以确认修改：" Margin="0,0,0,8"/>
            <PasswordBox x:Name="txtPwd" Width="240" HorizontalAlignment="Left"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
            <Button Content="确定" Width="70" Height="26" IsDefault="True" Click="BtnOk_Click"/>
            <Button Content="取消" Width="70" Height="26" Margin="10,0,0,0" IsCancel="True" Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
