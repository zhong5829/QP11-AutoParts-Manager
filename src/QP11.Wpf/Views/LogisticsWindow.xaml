<Window x:Class="QP11.Wpf.Views.LogisticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="物流商管理" Height="500" Width="800"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,5">
            <Button Content="新增" Width="60" Height="26" Click="BtnAdd_Click"/>
            <Button Content="编辑" Width="60" Height="26" Margin="5,0" Click="BtnEdit_Click"/>
            <Button Content="删除" Width="60" Height="26" Margin="5,0" Click="BtnDelete_Click"/>
        </StackPanel>

        <DataGrid Grid.Row="1" x:Name="dgList" AutoGenerateColumns="False" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="编号" Width="60" Binding="{Binding Sid}" IsReadOnly="True"/>
                <DataGridTextColumn Header="名称" Width="120" Binding="{Binding Name}"/>
                <DataGridTextColumn Header="联系人" Width="80" Binding="{Binding Linkman}"/>
                <DataGridTextColumn Header="电话" Width="100" Binding="{Binding Tel}"/>
                <DataGridTextColumn Header="手机" Width="100" Binding="{Binding Mobile}"/>
                <DataGridTextColumn Header="地址" Width="180" Binding="{Binding Address}"/>
                <DataGridTextColumn Header="等级" Width="50" Binding="{Binding Level}"/>
                <DataGridTextColumn Header="信用额度" Width="80" Binding="{Binding Credit}"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
