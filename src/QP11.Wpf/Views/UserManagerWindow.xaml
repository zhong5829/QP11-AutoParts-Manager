<Window x:Class="QP11.Wpf.Views.UserManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="用户管理" Height="450" Width="700"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,5">
            <Button Content="新增用户" Width="80" Click="BtnAdd_Click"/>
            <Button Content="修改密码" Width="80" Margin="5,0" Click="BtnChangePwd_Click"/>
            <Button Content="禁用" Width="55" Margin="5,0" Click="BtnDisable_Click"/>
            <Button Content="启用" Width="55" Margin="5,0" Click="BtnEnable_Click"/>
        </StackPanel>

        <DataGrid Grid.Row="1" x:Name="dgUsers" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="用户名" Width="120" Binding="{Binding Username}"/>
                <DataGridTextColumn Header="姓名" Width="120" Binding="{Binding Name}"/>
                <DataGridTextColumn Header="用户组" Width="120" Binding="{Binding Groups}"/>
                <DataGridTextColumn Header="状态" Width="80" Binding="{Binding State}"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="2" x:Name="txtCount" Text="共 0 条记录" Margin="0,5,0,0"/>
    </Grid>
</Window>
