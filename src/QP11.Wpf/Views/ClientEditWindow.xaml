<Window x:Class="QP11.Wpf.Views.ClientEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="客户编辑" Height="500" Width="500"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="80"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Text="编号:" VerticalAlignment="Center"/>
        <TextBox Grid.Column="1" x:Name="txtCid" Margin="2" TabIndex="1"/>
        <TextBlock Grid.Row="1" Text="名称:" VerticalAlignment="Center" Margin="0,5,0,0"/>
        <TextBox Grid.Row="1" Grid.Column="1" x:Name="txtName" Margin="2,5" TabIndex="2"/>
        <TextBlock Grid.Row="2" Text="电话:" VerticalAlignment="Center" Margin="0,5,0,0"/>
        <TextBox Grid.Row="2" Grid.Column="1" x:Name="txtTel" Margin="2,5" TabIndex="3"/>
        <TextBlock Grid.Row="3" Text="手机:" VerticalAlignment="Center" Margin="0,5,0,0"/>
        <TextBox Grid.Row="3" Grid.Column="1" x:Name="txtMobile" Margin="2,5" TabIndex="4"/>
        <TextBlock Grid.Row="4" Text="地址:" VerticalAlignment="Center" Margin="0,5,0,0"/>
        <TextBox Grid.Row="4" Grid.Column="1" x:Name="txtAddress" Margin="2,5" TabIndex="5"/>
        <TextBlock Grid.Row="5" Text="等级:" VerticalAlignment="Center" Margin="0,5,0,0"/>
        <ComboBox Grid.Row="5" Grid.Column="1" x:Name="cboLevel" Margin="2,5" IsEditable="True" TabIndex="6">
            <ComboBoxItem Content="普通"/>
            <ComboBoxItem Content="VIP"/>
        </ComboBox>
        <TextBlock Grid.Row="6" Text="信用额度:" VerticalAlignment="Center" Margin="0,5,0,0"/>
        <TextBox Grid.Row="6" Grid.Column="1" x:Name="txtCredit" Text="0" Margin="2,5" TabIndex="7"/>
        <TextBlock Grid.Row="7" Text="联系人:" VerticalAlignment="Center" Margin="0,5,0,0"/>
        <TextBox Grid.Row="7" Grid.Column="1" x:Name="txtLinkman" Margin="2,5" TabIndex="8"/>
        <TextBlock Grid.Row="8" Text="备注:" VerticalAlignment="Top" Margin="0,5,0,0"/>
        <TextBox Grid.Row="8" Grid.Column="1" x:Name="txtNote" AcceptsReturn="True" Height="60" Margin="2,5" TabIndex="9"/>

        <StackPanel Grid.Row="9" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
            <Button Content="保 存" Width="80" Height="28" Margin="10,0" Click="BtnSave_Click" IsDefault="True"/>
            <Button Content="取 消" Width="80" Height="28" Margin="10,0" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
