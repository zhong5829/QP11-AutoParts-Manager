<UserControl x:Class="QP11.Wpf.Views.BuyControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:QP11.Wpf.Helpers"
             xmlns:controls="clr-namespace:QP11.Wpf.Controls"
             helpers:EnterToTabHelper.IsEnabled="True">
    <UserControl.Resources>
        <helpers:SingleLineConverter x:Key="SingleLineConverter"/>
        <Style x:Key="SingleLineCell" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
        </Style>
    </UserControl.Resources>
    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Row0: RadioButton filter + action buttons -->
        <Grid Grid.Row="0" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <RadioButton x:Name="rbUnsettled" Content="未结算" IsChecked="True"
                         VerticalAlignment="Center" Margin="4,2" GroupName="BuyFlag"
                         Checked="RadioButton_Checked"/>
            <RadioButton x:Name="rbSettled" Content="已结算" Grid.Column="1"
                         VerticalAlignment="Center" Margin="4,2" GroupName="BuyFlag"
                         Checked="RadioButton_Checked"/>
            <RadioButton x:Name="rbReturn" Content="退货" Grid.Column="2"
                         VerticalAlignment="Center" Margin="4,2" GroupName="BuyFlag"
                         Checked="RadioButton_Checked"/>

            <Button Grid.Column="4" Content="式样新增(F1)" Width="90" Margin="4,2" Click="BtnStyleAdd_Click"/>
            <Button Grid.Column="5" Content="表格导入" Width="75" Margin="4,2" Click="BtnExcelImport_Click"/>
            <Button Grid.Column="6" Content="采购转销售" Width="85" Margin="4,2" Click="BtnBuyToSell_Click"/>
            <Button Grid.Column="7" Content="打印预览" Width="75" Margin="4,2" Click="BtnPrintBill_Click"/>
        </Grid>

        <!-- Row1: Left-Right Master-Detail -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="480"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel: Header + Detail -->
            <Grid Grid.Column="0" Margin="0,0,4,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header GroupBox -->
                <GroupBox Grid.Row="0" Header="单头信息" Margin="0,0,0,2" Padding="2">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="供应商:" VerticalAlignment="Center" Margin="2"/>
                        <controls:SupplierSearchBox Grid.Column="1" x:Name="cboSupplier" Margin="2"/>

                        <TextBlock Grid.Row="1" Text="单号:" VerticalAlignment="Center" Margin="2"/>
                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="txtBillNo" IsReadOnly="True" Background="LightGray" Margin="2"/>

                        <TextBlock Grid.Row="2" Text="日期:" VerticalAlignment="Center" Margin="2"/>
                        <DatePicker Grid.Row="2" Grid.Column="1" x:Name="dtBillDate" Margin="2"/>

                        <TextBlock Grid.Row="3" Text="采购员:" VerticalAlignment="Center" Margin="2"/>
                        <ComboBox Grid.Row="3" Grid.Column="1" x:Name="cboWorker" IsEditable="True" Margin="2"/>

                        <TextBlock Grid.Row="4" Text="发票号:" VerticalAlignment="Center" Margin="2"/>
                        <TextBox Grid.Row="4" Grid.Column="1" x:Name="txtInvoice" Margin="2"/>

                        <TextBlock Grid.Row="5" Text="总额:" VerticalAlignment="Center" Margin="2"/>
                        <TextBox Grid.Row="5" Grid.Column="1" x:Name="txtTotal" IsReadOnly="True" Background="LightGray" Margin="2"/>

                        <Grid Grid.Row="6" Grid.ColumnSpan="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="支付宝:" VerticalAlignment="Center" Margin="2"/>
                            <TextBox Grid.Column="1" x:Name="txtZhifubao" Text="0" Margin="2" TextChanged="Payment_TextChanged"/>
                            <TextBlock Grid.Column="2" Text="微信:" VerticalAlignment="Center" Margin="8,2,2,2"/>
                            <TextBox Grid.Column="3" x:Name="txtWeixin" Text="0" Margin="2" TextChanged="Payment_TextChanged"/>

                            <TextBlock Grid.Row="1" Text="运费:" VerticalAlignment="Center" Margin="2"/>
                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="txtYunfei" Text="0" Margin="2"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="欠款:" VerticalAlignment="Center" Margin="8,2,2,2"/>
                            <TextBox Grid.Row="1" Grid.Column="3" x:Name="txtArrear" IsReadOnly="True" Background="LightGray" Margin="2"/>

                            <TextBlock Grid.Row="2" Text="备注:" VerticalAlignment="Center" Margin="2"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" x:Name="txtMemo" Margin="2"/>
                        </Grid>
                    </Grid>
                </GroupBox>

                <!-- Detail DataGrid -->
                <DataGrid Grid.Row="1" x:Name="dgDetails" AutoGenerateColumns="False" CanUserAddRows="False"
                          VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                          GridLinesVisibility="All" HorizontalGridLinesBrush="#E0E0E0" VerticalGridLinesBrush="#E0E0E0"
                          RowHeight="28" CellEditEnding="DgDetails_CellEditEnding">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="编号" Width="80" Binding="{Binding PartNo, Converter={StaticResource SingleLineConverter}}" IsReadOnly="True" ElementStyle="{StaticResource SingleLineCell}"/>
                        <DataGridTextColumn Header="名称" Width="100" Binding="{Binding PartName, Converter={StaticResource SingleLineConverter}}" IsReadOnly="True" ElementStyle="{StaticResource SingleLineCell}"/>
                        <DataGridTextColumn Header="车型" Width="90" Binding="{Binding Cartype, Converter={StaticResource SingleLineConverter}}" IsReadOnly="True" ElementStyle="{StaticResource SingleLineCell}"/>
                        <DataGridTextColumn Header="数量" Width="50" Binding="{Binding Amount}" ElementStyle="{StaticResource SingleLineCell}"/>
                        <DataGridTextColumn Header="进价" Width="60" Binding="{Binding InPrice, StringFormat=N2}" ElementStyle="{StaticResource SingleLineCell}"/>
                        <DataGridTextColumn Header="零售价" Width="60" Binding="{Binding LsPrice, StringFormat=N2}" IsReadOnly="True" ElementStyle="{StaticResource SingleLineCell}"/>
                        <DataGridTextColumn Header="批发价" Width="60" Binding="{Binding PfPrice, StringFormat=N2}" IsReadOnly="True" ElementStyle="{StaticResource SingleLineCell}"/>
                        <DataGridTextColumn Header="小计" Width="65" Binding="{Binding SubTotal, StringFormat=N2}" IsReadOnly="True" ElementStyle="{StaticResource SingleLineCell}"/>
                        <DataGridTextColumn Header="仓位" Width="45" Binding="{Binding Place, Converter={StaticResource SingleLineConverter}}" IsReadOnly="True" ElementStyle="{StaticResource SingleLineCell}"/>
                        <DataGridTextColumn Header="备注" Width="*" Binding="{Binding Memo, Converter={StaticResource SingleLineConverter}}" ElementStyle="{StaticResource SingleLineCell}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <!-- Right Panel: Bill List -->
            <DataGrid Grid.Column="1" x:Name="dgBills" AutoGenerateColumns="False" IsReadOnly="True"
                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                      SelectionMode="Single" SelectionChanged="DgBills_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="单号" Width="120" Binding="{Binding Sn, Converter={StaticResource SingleLineConverter}}" ElementStyle="{StaticResource SingleLineCell}"/>
                    <DataGridTextColumn Header="日期" Width="90" Binding="{Binding Datetime, StringFormat=yyyy-MM-dd}" ElementStyle="{StaticResource SingleLineCell}"/>
                    <DataGridTextColumn Header="供应商" Width="90" Binding="{Binding SupplierName, Converter={StaticResource SingleLineConverter}}" ElementStyle="{StaticResource SingleLineCell}"/>
                    <DataGridTextColumn Header="业务员" Width="70" Binding="{Binding WorkerName, Converter={StaticResource SingleLineConverter}}" ElementStyle="{StaticResource SingleLineCell}"/>
                    <DataGridTextColumn Header="总额" Width="80" Binding="{Binding Total, StringFormat=N2}" ElementStyle="{StaticResource SingleLineCell}"/>
                    <DataGridTextColumn Header="状态" Width="60" Binding="{Binding FlagText, Converter={StaticResource SingleLineConverter}}" ElementStyle="{StaticResource SingleLineCell}"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</UserControl>
