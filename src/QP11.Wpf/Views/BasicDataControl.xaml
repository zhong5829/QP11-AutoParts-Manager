<UserControl x:Class="QP11.Wpf.Views.BasicDataControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:QP11.Wpf.Helpers"
             helpers:EnterToTabHelper.IsEnabled="True">
    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
            <TextBlock Text="编码:" VerticalAlignment="Center" Margin="4,2,3,0"/>
            <TextBox x:Name="txtPartNo" Width="120" Margin="2" TextChanged="TxtSearch_TextChanged" GotFocus="TxtSearch_GotFocus" PreviewKeyDown="TxtSearch_PreviewKeyDown"/>
            <TextBlock Text="名称:" VerticalAlignment="Center" Margin="10,2,3,0"/>
            <TextBox x:Name="txtName" Width="150" Margin="2" TextChanged="TxtSearch_TextChanged" GotFocus="TxtSearch_GotFocus" PreviewKeyDown="TxtSearch_PreviewKeyDown"/>
            <TextBlock Text="车型:" VerticalAlignment="Center" Margin="10,2,3,0"/>
            <TextBox x:Name="txtCartype" Width="120" Margin="2" TextChanged="TxtSearch_TextChanged" GotFocus="TxtSearch_GotFocus" PreviewKeyDown="TxtSearch_PreviewKeyDown"/>
            <Button Content="添加配件" Width="75" Margin="12,2,0,2" Click="BtnAddPart_Click"/>
            <Button Content="关闭" Width="60" Margin="8,2,0,2" Click="BtnClose_Click"/>
        </StackPanel>

        <DataGrid Grid.Row="1" x:Name="dgData" AutoGenerateColumns="False"
                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                  CanUserAddRows="False" Margin="0,0,0,4" CellEditEnding="DgData_CellEditEnding"
                  MouseDoubleClick="DgData_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="编码" Width="120" Binding="{Binding PartNo}"/>
                <DataGridTextColumn Header="名称" Width="*" Binding="{Binding Name}"/>
                <DataGridTextColumn Header="车型" Width="150" Binding="{Binding Cartype}"/>
                <DataGridTextColumn Header="拼音码" Width="120" Binding="{Binding PyCode}"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,2,0,0">
            <TextBlock Text="F5刷新  F6保存" VerticalAlignment="Center" Foreground="Gray"/>
            <TextBlock x:Name="txtStatus" Text="" VerticalAlignment="Center" Margin="20,0,0,0" Foreground="Blue"/>
        </StackPanel>
    </Grid>
</UserControl>
