<Window x:Class="QP11.Wpf.Views.SupplierBalanceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="供应商对账" Height="600" Width="900"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <GroupBox Grid.Row="0" Header="查询条件" Margin="0,0,0,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="50"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="供应商:" VerticalAlignment="Center" Margin="5"/>
                <TextBox Grid.Column="1" x:Name="txtSupplier" IsReadOnly="True" Margin="2"/>
                <Button Grid.Column="2" Content="选择" Width="50" Margin="5,0" Click="BtnSelectSupplier_Click"/>
                <TextBlock Grid.Column="3" Text=" " Width="10"/>
                <TextBlock Grid.Column="4" Text="起始:" VerticalAlignment="Center" Margin="5"/>
                <DatePicker Grid.Column="5" x:Name="dtStart" Margin="2"/>
                <TextBlock Grid.Column="6" Text="截止:" VerticalAlignment="Center" Margin="5"/>
                <DatePicker Grid.Column="7" x:Name="dtEnd" Margin="2"/>
                <Button Grid.Column="8" Content="查询" Width="60" Height="26" Margin="10,0" Click="BtnQuery_Click"/>
            </Grid>
        </GroupBox>

        <DataGrid Grid.Row="1" x:Name="dgRecords" AutoGenerateColumns="False" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="日期" Width="100" Binding="{Binding Datetime, StringFormat=yyyy-MM-dd}"/>
                <DataGridTextColumn Header="单号" Width="150" Binding="{Binding Sn}"/>
                <DataGridTextColumn Header="类型" Width="60" Binding="{Binding TypeName}"/>
                <DataGridTextColumn Header="采购金额" Width="100" Binding="{Binding BuyAmount, StringFormat=c2}"/>
                <DataGridTextColumn Header="退货金额" Width="100" Binding="{Binding ReturnAmount, StringFormat=c2}"/>
                <DataGridTextColumn Header="付款金额" Width="100" Binding="{Binding PayAmount, StringFormat=c2}"/>
                <DataGridTextColumn Header="余额" Width="100" Binding="{Binding Balance, StringFormat=c2}"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="5">
            <TextBlock Text="应付余额: " VerticalAlignment="Center" FontSize="14"/>
            <TextBlock x:Name="txtTotalBalance" VerticalAlignment="Center" FontSize="16" FontWeight="Bold" Foreground="Red"/>
        </StackPanel>
    </Grid>
</Window>
