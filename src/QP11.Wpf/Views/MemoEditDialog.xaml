<Window x:Class="QP11.Wpf.Views.MemoEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="备忘编辑" Width="480" Height="430"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="76"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Text="内容:" VerticalAlignment="Top" Margin="0,6,0,0"/>
        <TextBox Grid.Row="0" Grid.Column="1" x:Name="txtContent" Height="96"
                 TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                 VerticalContentAlignment="Top" Margin="1,2"/>

        <TextBlock Grid.Row="1" Text="优先级:" VerticalAlignment="Center" Margin="0,4"/>
        <ComboBox Grid.Row="1" Grid.Column="1" x:Name="cboPriority" Margin="1,4" Width="140" HorizontalAlignment="Left">
            <ComboBoxItem Content="低"/>
            <ComboBoxItem Content="中"/>
            <ComboBoxItem Content="高"/>
        </ComboBox>

        <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,8,0,0">
            <RadioButton x:Name="rbNone" Content="不提醒" GroupName="Remind" IsChecked="True" Margin="0,0,18,0" VerticalAlignment="Center" Checked="Remind_Changed"/>
            <RadioButton x:Name="rbScheduled" Content="定时提醒" GroupName="Remind" Margin="0,0,18,0" VerticalAlignment="Center" Checked="Remind_Changed"/>
            <RadioButton x:Name="rbCountdown" Content="倒计时提醒" GroupName="Remind" VerticalAlignment="Center" Checked="Remind_Changed"/>
        </StackPanel>

        <Grid Grid.Row="3" Grid.Column="1" x:Name="panelScheduled" Visibility="Collapsed" Margin="1,6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <DatePicker x:Name="dtpRemindDate" Width="130" Margin="0,0,8,0"/>
            <TextBox Grid.Column="1" x:Name="txtRemindTime" Width="70" ToolTip="格式 HH:mm（如 09:30）"/>
        </Grid>
        <TextBlock Grid.Row="3" Grid.Column="0" x:Name="lblScheduled" Text="提醒时间:" Visibility="Collapsed" VerticalAlignment="Center" Margin="0,6,0,0"/>

        <Grid Grid.Row="4" Grid.Column="1" x:Name="panelCountdown" Visibility="Collapsed" Margin="1,6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="txtCountdown" Width="80" HorizontalAlignment="Left"/>
            <TextBlock Grid.Column="1" Text="分钟后提醒" VerticalAlignment="Center" Margin="8,0,0,0"/>
        </Grid>
        <TextBlock Grid.Row="4" Grid.Column="0" x:Name="lblCountdown" Text="倒计时:" Visibility="Collapsed" VerticalAlignment="Center" Margin="0,6,0,0"/>

        <TextBlock Grid.Row="5" Grid.ColumnSpan="2" Text="提醒仅在本店各台已登录电脑的程序运行期间弹出。" 
                   Foreground="Gray" FontSize="11" Margin="0,10,0,0"/>

        <StackPanel Grid.Row="7" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
            <Button Content="确定(&amp;O)" Width="80" Height="28" IsDefault="True" Click="BtnOk_Click"/>
            <Button Content="取消(&amp;C)" Width="80" Height="28" Margin="12,0,0,0" IsCancel="True" Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>