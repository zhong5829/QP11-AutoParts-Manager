<Window x:Class="QP11.Wpf.Views.VinImageViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="图片查看" Width="700" Height="700"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="#1E1E1E">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 大图 -->
        <Border Grid.Row="0" Background="#2D2D2D" Margin="8">
            <Image x:Name="imgMain" Stretch="Uniform"
                   RenderOptions.BitmapScalingMode="HighQuality"/>
        </Border>

        <!-- 底部缩略图列表 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Disabled"
                      HorizontalScrollBarVisibility="Auto" Height="80" Margin="8,0,8,8">
            <StackPanel x:Name="spThumbs" Orientation="Horizontal"/>
        </ScrollViewer>
    </Grid>
</Window>
