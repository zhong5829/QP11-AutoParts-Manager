<Window x:Class="QP11.Wpf.Views.SysLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="操作日志" Height="550" Width="900"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <GroupBox Grid.Row="0" Header="查询条件" Margin="0,0,0,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="起始:" VerticalAlignment="Center" Margin="5"/>
                <DatePicker Grid.Column="1" x:Name="dtStart" Margin="2"/>
                <TextBlock Grid.Column="2" Text="截止:" VerticalAlignment="Center" Margin="5"/>
                <DatePicker Grid.Column="3" x:Name="dtEnd" Margin="2"/>
                <TextBlock Grid.Column="4" Text="用户:" VerticalAlignment="Center" Margin="5"/>
                <ComboBox Grid.Column="5" x:Name="cboUser" Margin="2" IsEditable="True"
                          DisplayMemberPath="Name" SelectedValuePath="Username"/>
                <TextBlock Grid.Column="6" Text="操作:" VerticalAlignment="Center" Margin="5"/>
                <ComboBox Grid.Column="7" x:Name="cboAction" Margin="2" IsEditable="True"
                          DisplayMemberPath="Name"/>
                <Button Grid.Column="8" Content="查询" Width="60" Height="26" Margin="10,0" Click="BtnQuery_Click"/>
            </Grid>
        </GroupBox>

        <DataGrid Grid.Row="1" x:Name="dgLogs" AutoGenerateColumns="False" CanUserAddRows="False"
                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Width="60" Binding="{Binding Id}" IsReadOnly="True"/>
                <DataGridTextColumn Header="用户" Width="80" Binding="{Binding Operator}" IsReadOnly="True"/>
                <DataGridTextColumn Header="模块" Width="100" Binding="{Binding Module}" IsReadOnly="True"/>
                <DataGridTextColumn Header="操作" Width="120" Binding="{Binding Action}" IsReadOnly="True"/>
                <DataGridTextColumn Header="时间" Width="*" Binding="{Binding Datetime, StringFormat=yyyy-MM-dd HH:mm:ss}" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="5">
            <TextBlock x:Name="txtCount" VerticalAlignment="Center"/>
            <Button Content="清理30天前日志" Width="120" Height="26" Margin="20,0,0,0" Click="BtnClean_Click"/>
        </StackPanel>
    </Grid>
</Window>
